// ═══════════════════════════════════════════════════════════════
// 100 Salesforce Flashcards — 25 per category
// ═══════════════════════════════════════════════════════════════
const FC_DEFAULTS = [
  // ═══════ ADMIN (25) ═══════
  { cat:'Admin', q:'What is a Governor Limit?', a:'Runtime limits enforced by Salesforce to ensure no single tenant monopolizes shared resources. Examples: 100 SOQL queries, 150 DML statements per transaction.' },
  { cat:'Admin', q:'Difference between Role and Profile?', a:'Profile controls what a user CAN DO (CRUD, field-level security). Role controls what records a user CAN SEE via the role hierarchy.' },
  { cat:'Admin', q:'What is OWD (Organization-Wide Default)?', a:'The baseline sharing setting for each object. Options: Private, Public Read Only, Public Read/Write, Controlled by Parent.' },
  { cat:'Admin', q:'What are Sharing Rules?', a:'Rules that extend access beyond OWD. Types: Criteria-based and Owner-based. They can only OPEN access, never restrict it.' },
  { cat:'Admin', q:'What is a Permission Set?', a:'A collection of permissions that extend a user\'s access without changing their Profile. Can be assigned to multiple users.' },
  { cat:'Admin', q:'What is a Validation Rule?', a:'A formula that evaluates data on save. If the formula returns TRUE, the save is blocked and an error message is shown.' },
  { cat:'Admin', q:'What is a Workflow Rule?', a:'Automates standard procedures. Can trigger: Field Updates, Email Alerts, Tasks, Outbound Messages. Being replaced by Flows.' },
  { cat:'Admin', q:'What is Process Builder?', a:'A point-and-click automation tool (retired for new orgs). More powerful than Workflow Rules but replaced by Record-Triggered Flows.' },
  { cat:'Admin', q:'What is a Record Type?', a:'Allows different business processes, page layouts, and picklist values for the same object based on user profile.' },
  { cat:'Admin', q:'What is a Page Layout?', a:'Controls arrangement of fields, buttons, related lists, and custom links on record detail/edit pages.' },
  { cat:'Admin', q:'Lookup vs Master-Detail relationship?', a:'Lookup: loosely coupled, child exists without parent, no roll-ups. Master-Detail: tightly coupled, cascade delete, supports roll-up summaries.' },
  { cat:'Admin', q:'What is a Roll-Up Summary field?', a:'A field on a master object that aggregates (SUM, COUNT, MIN, MAX) values from related detail records in a Master-Detail relationship.' },
  { cat:'Admin', q:'What is a Formula Field?', a:'A read-only field derived from a formula expression. Calculated real-time, not stored in the database.' },
  { cat:'Admin', q:'What is Field-Level Security (FLS)?', a:'Controls visibility and editability of fields based on Profile or Permission Set. Works independently of page layouts.' },
  { cat:'Admin', q:'What is a Custom Metadata Type?', a:'A framework for deploying app metadata. Unlike Custom Settings, they can be packaged and deployed via change sets.' },
  { cat:'Admin', q:'What is a Custom Setting?', a:'Similar to custom objects but stored in app cache for fast access. Types: List and Hierarchy.' },
  { cat:'Admin', q:'What is a Flow?', a:'Salesforce\'s primary automation tool. Types: Screen Flow, Record-Triggered Flow, Scheduled-Triggered Flow, Autolaunched Flow.' },
  { cat:'Admin', q:'What is Data Loader?', a:'Client application for bulk import/export. Supports Insert, Update, Upsert, Delete, Export, and Export All operations.' },
  { cat:'Admin', q:'What is a Sandbox?', a:'A copy of production for dev/testing/training. Types: Developer, Developer Pro, Partial Copy, Full.' },
  { cat:'Admin', q:'What is a Change Set?', a:'Sends customizations between related Salesforce orgs (e.g., Sandbox to Production). Only works between connected orgs.' },
  { cat:'Admin', q:'What is Shield Platform Encryption?', a:'Encrypts data at rest using tenant-specific keys. Supports custom fields, files, and attachments.' },
  { cat:'Admin', q:'What is a Report Type?', a:'Defines the records and fields available when creating a report. Can be standard or custom.' },
  { cat:'Admin', q:'What is a Dashboard?', a:'Visual display of key metrics from multiple reports. Components: charts, gauges, tables, metrics.' },
  { cat:'Admin', q:'What is an External ID?', a:'A custom field marked as External ID for upsert operations. Uniquely identifies records from external systems.' },
  { cat:'Admin', q:'What is a Junction Object?', a:'A custom object with two Master-Detail relationships, creating a many-to-many relationship between two objects.' },

  // ═══════ APEX (25) ═══════
  { cat:'Apex', q:'What is a Trigger?', a:'Apex code executing before/after DML events (insert, update, delete, undelete). Best practice: one trigger per object + handler class.' },
  { cat:'Apex', q:'Name 4 types of Async Apex.', a:'1. Future Methods (@future)\n2. Batch Apex (Database.Batchable)\n3. Queueable Apex (Queueable)\n4. Scheduled Apex (Schedulable)' },
  { cat:'Apex', q:'Before vs After triggers?', a:'Before: validate/update values before DB save (no DML needed). After: access system-set values (Id) and modify other records.' },
  { cat:'Apex', q:'Trigger.new vs Trigger.old?', a:'Trigger.new: new record versions. Trigger.old: old versions (pre-update/delete). Trigger.newMap/oldMap for Map access.' },
  { cat:'Apex', q:'What is Batch Apex?', a:'Processes large data in chunks (up to 2000/batch). Implements Database.Batchable with start(), execute(), finish().' },
  { cat:'Apex', q:'What is a Future Method?', a:'Async method (@future). Runs in own thread. Cannot chain @future calls. Good for callouts and mixed DML.' },
  { cat:'Apex', q:'What is Queueable Apex?', a:'Enhanced future methods. Supports complex types, chaining (one Queueable calls another), monitoring via AsyncApexJob.' },
  { cat:'Apex', q:'What is SOQL?', a:'Salesforce Object Query Language. Reads records: SELECT Id, Name FROM Account WHERE Industry = \'Tech\' LIMIT 10.' },
  { cat:'Apex', q:'What is SOSL?', a:'Salesforce Object Search Language. Text search across objects: FIND \'Acme\' IN ALL FIELDS RETURNING Account, Contact.' },
  { cat:'Apex', q:'SOQL vs SOSL?', a:'SOQL queries specific objects/fields (like SQL). SOSL searches text across multiple objects. SOSL is faster for keyword searches.' },
  { cat:'Apex', q:'What is a Map in Apex?', a:'Key-value collection. Keys must be unique. Pattern: Map<Id, Account> m = new Map<Id, Account>([SELECT Id,Name FROM Account]).' },
  { cat:'Apex', q:'What is Test.startTest()/stopTest()?', a:'Resets governor limits in test context so code-under-test gets fresh limits. Forces async code to run synchronously.' },
  { cat:'Apex', q:'What is @TestSetup?', a:'Creates test data once for all test methods in the class. Faster than creating data per test method.' },
  { cat:'Apex', q:'Database.insert() vs insert?', a:'insert throws on failure. Database.insert(records, false) allows partial success and returns SaveResult[] for error handling.' },
  { cat:'Apex', q:'Governor Limit exemptions for Batch?', a:'Each execute() gets fresh limits. SOQL queries reset per batch. Allows processing millions of records.' },
  { cat:'Apex', q:'What is a Custom Exception?', a:'User-defined exception extending Exception. throw new CustomException(\'message\') for meaningful error handling.' },
  { cat:'Apex', q:'What is System.runAs()?', a:'Used in tests to run code as a specific user. Enforces that user\'s profile, permission sets, and sharing rules.' },
  { cat:'Apex', q:'What is a Wrapper Class?', a:'Combines different data types into one object. Common for displaying records with checkboxes in Lightning components.' },
  { cat:'Apex', q:'What is Trigger Handler Pattern?', a:'Design pattern moving logic to a handler class. Trigger delegates to handler methods. Improves testability and maintenance.' },
  { cat:'Apex', q:'What is @AuraEnabled?', a:'Marks Apex method as accessible from LWC/Aura. @AuraEnabled(cacheable=true) enables wire adapter compatibility.' },
  { cat:'Apex', q:'What is a Platform Event?', a:'Event-driven messaging. Publishers fire events, subscribers listen via event bus. Great for integrations and decoupled systems.' },
  { cat:'Apex', q:'Comparable vs Iterable interfaces?', a:'Comparable: custom sorting (compareTo). Iterable: custom iteration, used in Batch Apex start() method.' },
  { cat:'Apex', q:'What is Mixed DML error?', a:'Error when DML on setup (User) and non-setup objects in same transaction. Fix: @future or Queueable.' },
  { cat:'Apex', q:'What is Database.Stateful?', a:'Batch interface to maintain state across execute() calls. Without it, member variables reset each batch.' },
  { cat:'Apex', q:'What is an sObject?', a:'Generic abstract type for all Salesforce objects. Account, Contact, MyObj__c all extend sObject.' },

  // ═══════ LWC (25) ═══════
  { cat:'LWC', q:'What is the Shadow DOM in LWC?', a:'Encapsulates component CSS and markup, preventing styles and scripts from leaking between components.' },
  { cat:'LWC', q:'How do you call Apex in LWC?', a:'Import: import method from \'@salesforce/apex/Class.method\'. Use @wire (reactive) or call imperatively as a Promise.' },
  { cat:'LWC', q:'What is @wire in LWC?', a:'Reactive decorator that auto-calls Apex or data services when parameters change. Results flow into a property or function.' },
  { cat:'LWC', q:'What is @api in LWC?', a:'Marks a property/method as public. Parents can set @api properties and call @api methods on child components.' },
  { cat:'LWC', q:'What is @track in LWC?', a:'Formerly needed for object/array reactivity. Since Spring \'20, all properties are reactive by default. Rarely needed now.' },
  { cat:'LWC', q:'Parent-child communication?', a:'Parent → Child: @api properties. Child → Parent: Custom Events via this.dispatchEvent(new CustomEvent(\'name\', {detail})).' },
  { cat:'LWC', q:'What is Lightning Message Service?', a:'Publish-subscribe messaging across DOM hierarchies. Works between LWC, Aura, and Visualforce components.' },
  { cat:'LWC', q:'What is Lightning Data Service?', a:'Built-in caching and data layer. Use lightning-record-form or wire adapters like getRecord. No Apex needed for basic CRUD.' },
  { cat:'LWC', q:'What are LWC lifecycle hooks?', a:'constructor() → connectedCallback() → renderedCallback() → disconnectedCallback(). errorCallback() for child errors.' },
  { cat:'LWC', q:'What is connectedCallback()?', a:'Fires when component enters the DOM. Used for init logic, data fetching, event subscriptions. Runs once.' },
  { cat:'LWC', q:'What is renderedCallback()?', a:'Fires after every render. Can fire multiple times — guard with a boolean flag to prevent infinite loops.' },
  { cat:'LWC', q:'What is disconnectedCallback()?', a:'Fires on DOM removal. Used for cleanup: unsubscribing events, clearing intervals, releasing resources.' },
  { cat:'LWC', q:'What is a slot in LWC?', a:'Placeholder in child template where parent injects markup. Use <slot></slot> in child, place content between child tags.' },
  { cat:'LWC', q:'Error handling in LWC?', a:'try/catch for imperative Apex. errorCallback() for child errors. Display via lightning-card or ShowToastEvent.' },
  { cat:'LWC', q:'What is NavigationMixin?', a:'Mixin providing navigate() for programmatic navigation. this[NavigationMixin.Navigate]({type, attributes, state}).' },
  { cat:'LWC', q:'LWC vs Aura?', a:'LWC uses native web standards (Shadow DOM, custom elements). Aura is proprietary. LWC has better performance and smaller bundles.' },
  { cat:'LWC', q:'Conditional rendering in LWC?', a:'Use lwc:if, lwc:elseif, lwc:else directives (or legacy if:true/if:false). No ternary expressions in templates.' },
  { cat:'LWC', q:'Iteration in LWC templates?', a:'for:each={array} for:item="item" with key={item.id}. Or iterator:it={array} for first/last detection.' },
  { cat:'LWC', q:'What is getRecord wire adapter?', a:'Retrieves single record by ID. @wire(getRecord, {recordId: \'$recordId\', fields}). Part of lightning/uiRecordApi.' },
  { cat:'LWC', q:'What is lightning-datatable?', a:'Base component for tabular data with built-in sorting, row selection, inline editing, and infinite scrolling.' },
  { cat:'LWC', q:'What is ShowToastEvent?', a:'Import from lightning/platformShowToastEvent. Dispatch: new ShowToastEvent({title, message, variant: \'success\'}).' },
  { cat:'LWC', q:'What is the Wire Service?', a:'Reactive data streaming. When inputs change, wire provisions new data. Supports Apex and UI API adapters.' },
  { cat:'LWC', q:'What is lightning/uiRecordApi?', a:'Module with wire adapters and functions for CRUD without Apex: getRecord, createRecord, updateRecord, deleteRecord.' },
  { cat:'LWC', q:'CSS Custom Properties in LWC?', a:'Supports CSS variables (--my-color) that cross shadow boundaries, enabling theme customization from parent components.' },
  { cat:'LWC', q:'What is a Lightning App Page?', a:'Custom page in Lightning App Builder. Drag and drop LWC/Aura components. Used for Home, Record, and App pages.' },

  // ═══════ SCENARIO (25) ═══════
  { cat:'Scenario', q:'Trigger hitting too many SOQL queries. Fix?', a:'Bulkify: move SOQL outside loops, collect IDs in a Set, query once, use Map lookups inside the loop.' },
  { cat:'Scenario', q:'Users see records they shouldn\'t. Fix?', a:'Check OWD (set to Private), verify Sharing Rules, review Role Hierarchy, audit Permission Sets, check manual shares.' },
  { cat:'Scenario', q:'How to prevent duplicate records?', a:'Duplicate Rules + Matching Rules declaratively. Programmatically: before insert trigger checking existing records.' },
  { cat:'Scenario', q:'Deploy fails with < 75% coverage. Fix?', a:'Write tests covering positive/negative/bulk scenarios. Use @TestSetup. Add assertions. Run all tests locally first.' },
  { cat:'Scenario', q:'Batch job failing midway. Debug?', a:'Implement Database.Stateful to track state. try-catch in execute(). Log errors to custom object. Check AsyncApexJob.' },
  { cat:'Scenario', q:'Integrate with external REST API. Approach?', a:'Named Credential for auth. HttpRequest/HttpResponse in Apex. Call from @future(callout=true) or Queueable. Handle errors.' },
  { cat:'Scenario', q:'Too many records for Lightning component?', a:'Server-side pagination with OFFSET/LIMIT. Or infinite scrolling with lightning-datatable. Never load all at once.' },
