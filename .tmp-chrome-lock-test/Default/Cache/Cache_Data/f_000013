        <div style="display:flex; gap:12px; margin-bottom:12px;">
          <div class="field-group" style="flex:1">
            <label>Date</label>
            <input type="date" id="scheduleMsgDate" class="input-field" />
          </div>
          <div class="field-group" style="flex:1">
            <label>Time</label>
            <input type="time" id="scheduleMsgTime" class="input-field" />
          </div>
        </div>
        <div class="field-group" style="margin-bottom:18px;">
          <label class="checkbox-label" style="display:flex; align-items:center;">
            <input type="checkbox" id="scheduleCalReminder" checked style="margin-right:8px;" />
            Add to Calendar Reminder
          </label>
        </div>
        <div class="modal-footer" style="justify-content:flex-end">
          <button class="btn-primary" onclick="doSchedulePush()">Schedule Push</button>
        </div>
      </div>
    </div>
  </div>

  <!-- COMMAND MODE PLUGIN (Non-breaking, self-contained) -->
  <script src="js/command-mode.js?v=1" defer></script>

  <!-- APK Download Handler -->
  <script>
    function handleApkDownload(e) {
      e.preventDefault();
      const btn = document.getElementById('apkDownloadBtn');
      const apkUrl = btn ? btn.getAttribute('data-apk-url') : '';
      
      if (!apkUrl || apkUrl === 'FIREBASE_STORAGE_URL_HERE' || apkUrl === '') {
        // Show friendly message if URL not configured yet
        const msg = '📱 APK Download\n\nTo install TCX App on Android:\n1. The APK file is being prepared\n2. Check back soon or contact the admin\n\nFile: TCX-App-v2.1.apk (6.7 MB)\nRequires: Android 7.0+ (API 24+)\nEnable: Settings → Unknown Sources → Allow';
        alert(msg);
        return false;
      }
      
      // Valid URL - trigger download
      const a = document.createElement('a');
      a.href = apkUrl;
      a.download = 'TCX-App-v2.2.apk';
      a.target = '_blank';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      return false;
    }
  </script>

</body>
