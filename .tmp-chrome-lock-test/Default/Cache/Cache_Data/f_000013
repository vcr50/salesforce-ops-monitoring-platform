    </div>
  </div>

  <!-- LOGIN OVERLAY -->
  <div id="loginOverlay" class="login-overlay">
    <div class="login-bg-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
    </div>
    <div class="login-layout">
      <section class="login-home-copy" aria-label="VertexDB public homepage">
        <div class="login-home-kicker">Public homepage</div>
        <h1 class="login-home-title">VertexDB<span>Workspace for goals, notes, and daily execution.</span></h1>
        <p class="login-home-lead">
          VertexDB is a personal command center for Salesforce prep, study planning, calendars, tasks, notes, and progress tracking.
          You can read the overview without signing in. Sign in only when you want to sync your own data.
        </p>
        <div class="login-home-points">
          <div class="login-home-point">
            <h3>Study flow</h3>
            <p>Track daily progress, flashcards, and interview prep in one place.</p>
          </div>
          <div class="login-home-point">
            <h3>Personal sync</h3>
            <p>Connect Google Calendar or Tasks only when you choose to enable sync.</p>
          </div>
          <div class="login-home-point">
            <h3>Privacy-first</h3>
            <p>Read the privacy policy before login so the purpose of data access is clear.</p>
          </div>
          <div class="login-home-point">
            <h3>Built for focus</h3>
            <p>A calm dashboard for planning your day, not a hidden members-only page.</p>
          </div>
        </div>
        <div class="login-home-links">
          <a href="privacy.html">Privacy Policy</a>
          <a href="terms.html">Terms of Service</a>
        </div>
      </section>

      <div class="login-card">
        <div class="login-logo">
          <img src="images/logo.png" alt="VertexDB" />
          <h1>VertexDB</h1>
        </div>
        <style>
          @keyframes greetFade {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
          }
          .an-greeting-anim {
            animation: greetFade 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            opacity: 0;
            font-weight: 500;
          }
        </style>
        <p class="an-greeting-anim">Build your tech career. One skill at a time</p>
        
        <button class="btn-login-google" id="loginBtnMain" onclick="window.triggerFirebaseSignIn && window.triggerFirebaseSignIn()" style="animation: greetFade 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; opacity:0;">
          <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.14 0 5.95 1.08 8.17 2.85l6.1-6.1C34.29 3.02 29.39 1 24 1 14.72 1 6.77 6.48 3.18 14.18l7.1 5.52C12.02 13.27 17.57 9.5 24 9.5z"/><path fill="#4285F4" d="M46.52 24.5c0-1.56-.14-3.06-.4-4.5H24v8.5h12.67c-.55 2.94-2.22 5.44-4.73 7.1l7.27 5.64C43.78 37.1 46.52 31.3 46.52 24.5z"/><path fill="#FBBC05" d="M10.28 28.3A14.56 14.56 0 0 1 9.5 24c0-1.5.26-2.96.72-4.3L3.12 14.18A23.02 23.02 0 0 0 1 24c0 3.72.89 7.24 2.47 10.35l7.81-6.05z"/><path fill="#34A853" d="M24 47c5.39 0 9.92-1.78 13.22-4.85l-7.27-5.64c-1.79 1.2-4.1 1.99-5.95 1.99-6.43 0-11.88-4.34-13.72-10.2l-7.81 6.05C6.77 41.52 14.72 47 24 47z"/></svg>
          Sign in with Google
        </button>
        
        <div class="login-footer">
          VertexDB™ is a product of Tomcodex Pvt. Ltd. © 2026 Tomcodex Pvt. Ltd. All rights reserved. <br>
          <a href="privacy.html" style="color:var(--text-muted); font-size:10px; text-decoration:none; margin-right:8px;">Privacy Policy</a>
          <a href="terms.html" style="color:var(--text-muted); font-size:10px; text-decoration:none;">Terms of Service</a>
        </div>
      </div>
    </div>
  </div>

  <div id="mainDashboard" style="display:none;">
