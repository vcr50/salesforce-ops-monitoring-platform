      <a href="#quicklinks" class="nav-item" data-section="quicklinks">        <span class="nav-icon">🔗</span><span class="nav-label">Quick Links</span></a>
      <a href="#techtoday"  class="nav-item" data-section="techtoday">          <span class="nav-icon">📰</span><span class="nav-label">Tech Today</span></a>
      <a href="#telegram"   class="nav-item" data-section="telegram">           <span class="nav-icon">✈️</span><span class="nav-label">Telegram Sync</span></a>
    </nav>
    <div class="sidebar-footer">
      <button class="btn-save" id="saveAllBtn">💾 Save All</button>
    </div>
  </aside>

  <!-- HAMBURGER -->
  <button class="hamburger" id="hamburger" aria-label="Toggle menu">☰</button>

  <!-- MAIN -->
  <main class="main-content">

    <!-- HEADER -->
    <header class="page-header">
      <div style="display:flex; flex-direction:column; gap:6px;">
        <div style="position:relative;" id="journeyDropdownWrapper">
          <button id="aliveBackBtn" class="alive-back-btn" style="display:none;" title="Back to Home">
            ← Home
          </button>
          <button id="journeySelectBtn" class="journey-select-btn">
            <span id="headerJObjIcon">🌩️</span> <span id="headerJObjName">VertexDB</span> <span style="font-size:12px;opacity:0.6;margin-left:4px">▼</span>
          </button>
          <div id="journeyDropdown" class="journey-dropdown">
            <div id="journeyListContainer"></div>
            <div class="dropdown-divider"></div>
            <button class="journey-add-btn" id="openNewJourneyModal">+ Create New Journey</button>
          </div>
        </div>
        <p class="page-sub" id="headerSubtext">Mar 23 – May 16, 2026 &nbsp;·&nbsp; 55 Days</p>
      </div>
      <div class="header-right">
        <!-- XP & Rank Badge (Gamification) -->
        <div class="xp-badge" id="xpBadge" title="Earn XP by logging hours, finishing days, and projects!">
          <div class="xp-info">
            <span class="xp-icon" id="xpRankIcon">🌱</span>
            <div style="display:flex; flex-direction:column;">
              <span class="xp-rank-text" id="xpRankName">Trainee</span>
              <span class="xp-points-text" id="xpPointsText">0 XP</span>
            </div>
          </div>
          <!-- Progress bar to next level -->
          <div class="xp-progress-bar">
            <div class="xp-progress-fill" id="xpProgressFill" style="width:0%"></div>
          </div>
        </div>

        <!-- Dark Mode Toggle -->
        <button class="dark-toggle" id="darkToggle" title="Toggle Dark Mode">🌙</button>
        <!-- Pomodoro Timer -->
        <div class="pomo-widget" id="pomoWidget">
          <span class="pomo-time" id="pomoTime">25:00</span>
          <button class="pomo-btn" id="pomoStart" title="Start/Pause Pomodoro">▶</button>
          <button class="pomo-btn pomo-reset" id="pomoReset" title="Reset">↺</button>
        </div>
        <!-- Notification Bell -->
        <button class="notif-btn" id="notifBtn" title="Enable Study Reminders">🔔</button>
        <!-- Google Login -->
        <div class="fb-auth-area">
          <img id="fbAvatar" src="" alt="" style="width:32px;height:32px;border-radius:50%;display:none;object-fit:cover;border:2px solid var(--sf-blue);" />
          <span id="fbUserName" style="font-size:13px;font-weight:600;color:var(--sf-blue);display:none;"></span>
          <button id="fbLoginBtn" class="btn-google-login" onclick="window.fbSignIn()">
            <svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.14 0 5.95 1.08 8.17 2.85l6.1-6.1C34.29 3.02 29.39 1 24 1 14.72 1 6.77 6.48 3.18 14.18l7.1 5.52C12.02 13.27 17.57 9.5 24 9.5z"/><path fill="#4285F4" d="M46.52 24.5c0-1.56-.14-3.06-.4-4.5H24v8.5h12.67c-.55 2.94-2.22 5.44-4.73 7.1l7.27 5.64C43.78 37.1 46.52 31.3 46.52 24.5z"/><path fill="#FBBC05" d="M10.28 28.3A14.56 14.56 0 0 1 9.5 24c0-1.5.26-2.96.72-4.3L3.12 14.18A23.02 23.02 0 0 0 1 24c0 3.72.89 7.24 2.47 10.35l7.81-6.05z"/><path fill="#34A853" d="M24 47c5.39 0 9.92-1.78 13.22-4.85l-7.27-5.64c-1.79 1.2-4.1 1.99-5.95 1.99-6.43 0-11.88-4.34-13.72-10.2l-7.81 6.05C6.77 41.52 14.72 47 24 47z"/></svg>
            Sign in with Google
          </button>
          <button id="fbSignOutBtn" style="display:none;font-size:11px;color:var(--text-muted);background:none;border:none;cursor:pointer;" onclick="window.fbSignOutUser()">Sign out</button>
        </div>
      </div>
    </header>

    <!-- MOTIVATIONAL QUOTE BANNER -->
    <div class="quote-banner" id="quoteBanner">
      <span class="quote-icon">💡</span>
      <span class="quote-text" id="quoteText">Loading your daily motivation...</span>
    </div>

    <!-- ════════════ ALIVE NOW HOME ════════════ -->
    <section id="aliveNowHome" class="alive-home">
      <!-- Liquid Glass chromatic orbs -->
      <div class="lg-orb-1" aria-hidden="true"></div>
      <div class="lg-orb-2" aria-hidden="true"></div>
      <div class="lg-orb-3" aria-hidden="true"></div>

      <!-- ── 1. HERO SECTION ──────────────────── -->
      <div class="an-hero">
        <h1 class="an-greeting" id="aliveGreetingStr">Good evening, Vijay</h1>
        <div class="an-day-counter" id="aliveLifeText">Day <strong>10,280</strong></div>
        <p class="an-motto" id="aliveDynamicQuote">Make today count.</p>
      </div>
      <div class="an-home-dashboard-shell">
      <div class="an-dashboard-grid">
        <div class="an-dash-col-left">

      <!-- ── 1.b RICH WEATHER WIDGET ────────────── -->
      <details class="an-accordion">
        <summary>🌤️ Live Weather</summary>
        <div class="an-accordion-content">
          <div id="richWeatherWidget" class="aw-container dashboard-card" data-card-id="weather" style="margin:0;">
            <div class="aw-header-out dashboard-card-head">
           <svg class="aw-home-icon" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
           <span id="awLocationText" class="aw-location">Location</span>
           <button type="button" class="dashboard-card-toggle" data-card-toggle aria-expanded="true" aria-label="Minimize weather card" title="Minimize weather card">
             <span class="dashboard-card-toggle-icon">-</span>
           </button>
           <button id="weatherRefreshBtn" class="an-refresh-btn" title="Refresh weather" onclick="window.refreshWeather && window.refreshWeather()">↻</button>
        </div>
        <div class="dashboard-card-body">
        <div class="aw-main-box">
           <div class="aw-top-bar">
             <div class="aw-bar-left">
               <div class="aw-current-title">Current weather</div>
               <div id="awTimeText" class="aw-time">--:-- --</div>
             </div>
           </div>
           
           <div class="aw-body-row">
             <div class="aw-big-icon" id="awBigIcon">☁️</div>
             <div class="aw-temp">
               <span id="awBigTemp">--</span><span class="aw-deg">°C</span>
             </div>
             <div class="aw-cond-group">
               <div id="awConditionText" class="aw-condition">--</div>
               <div class="aw-feels-like">Feels like <span id="awFeelsLike">--</span>°</div>
             </div>
           </div>

           <div class="aw-desc-sentence" id="awDescSentence">
             Loading weather data...
           </div>

           <div class="aw-stats-row">
             <div class="aw-stat-item">
               <div class="aw-stat-lbl">Air quality ⓘ</div>
               <div class="aw-stat-val" id="awAqiVal"><span class="aw-dot" style="background:#fbbf24;"></span>--</div>
             </div>
             <div class="aw-stat-item">
               <div class="aw-stat-lbl">Wind ⓘ</div>
               <div class="aw-stat-val" id="awWindVal">-- km/h</div>
             </div>
             <div class="aw-stat-item">
               <div class="aw-stat-lbl">Humidity ⓘ</div>
               <div class="aw-stat-val" id="awHumidityVal">--%</div>
             </div>
             <div class="aw-stat-item">
               <div class="aw-stat-lbl">Visibility ⓘ</div>
               <div class="aw-stat-val" id="awVisVal">-- km</div>
             </div>
             <div class="aw-stat-item">
               <div class="aw-stat-lbl">Pressure ⓘ</div>
               <div class="aw-stat-val" id="awPressVal">-- mb</div>
             </div>
             <div class="aw-stat-item">
               <div class="aw-stat-lbl">Dew point ⓘ</div>
               <div class="aw-stat-val" id="awDewVal">--°</div>
             </div>
           </div>
        </div>
      </div>
        </div>
      </details>
        <!-- ── 1.c HEALTH & FITNESS ──────── -->
        <div id="googleFitWidget" class="aw-container dashboard-card" data-card-id="health" style="margin-top:16px; background: rgba(52, 199, 89, 0.05);">
          <div class="aw-header-out dashboard-card-head">
             <span class="aw-location">Health & Fitness</span>
             <button type="button" class="dashboard-card-toggle" data-card-toggle aria-expanded="true" aria-label="Minimize health card" title="Minimize health card">
               <span class="dashboard-card-toggle-icon">-</span>
             </button>
             <button id="fitRefreshBtn" class="an-refresh-btn" title="Refresh health data" onclick="window.refreshFitData && window.refreshFitData()">↻</button>
          </div>
          <div class="dashboard-card-body">
          <div class="aw-main-box" style="padding: 16px;">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
              <div class="aw-stat-item">
                <div class="aw-stat-lbl">Steps</div>
                <div class="aw-stat-val" id="fitStepsVal">--</div>
              </div>
              <div class="aw-stat-item">
                <div class="aw-stat-lbl">Avg BPM</div>
                <div class="aw-stat-val" id="fitHeartVal">--</div>
              </div>
              <div class="aw-stat-item">
                <div class="aw-stat-lbl">Calories</div>
                <div class="aw-stat-val" id="fitCalVal">--</div>
              </div>
              <div class="aw-stat-item">
                <div class="aw-stat-lbl">Move Min</div>
                <div class="aw-stat-val" id="fitMoveVal">--</div>
              </div>
            </div>
            <div id="fitSyncLoading" style="font-size:10px; color:rgba(255,255,255,0.3); margin-top:12px; text-align:center;">Syncing health data...</div>
          </div>
        </div>

        <!-- ── 1.d WATER REMINDER ────────────────────── -->
        </div>
        <div id="waterReminderWidget" class="aw-container dashboard-card" data-card-id="water" style="margin-top:16px; background: rgba(59, 130, 246, 0.05);">
          <div class="aw-header-out dashboard-card-head">
            <span class="aw-location">Water Intake</span>
            <button type="button" class="dashboard-card-toggle" data-card-toggle aria-expanded="true" aria-label="Minimize water card" title="Minimize water card">
              <span class="dashboard-card-toggle-icon">−</span>
            </button>
          </div>
          <div class="dashboard-card-body">
          <div class="aw-main-box" style="padding: 16px; display:flex; align-items:center; justify-content:space-between;">
            <div style="display:flex; align-items:center; gap:12px;">
              <span style="font-size:32px;">💧</span>
              <div>
                <div id="waterCountVal" style="font-size:20px; font-weight:700; color:#fff;">0/8</div>
                <div style="font-size:10px; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.5px;">Glasses</div>
              </div>
            </div>
            <div style="display:flex; gap:8px;">
              <button onclick="window.updateWaterIntake(-1)" style="width:36px; height:36px; border-radius:50%; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05); color:#fff; cursor:pointer; font-size:18px;">-</button>
              <button onclick="window.updateWaterIntake(1)" style="width:36px; height:36px; border-radius:50%; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05); color:#fff; cursor:pointer; font-size:18px;">+</button>
            </div>
          </div>
          </div>
        </div>
      </div>
        <div class="an-dash-col-center">
      <!-- ── 2. TRIPLE RINGS (APPLE FITNESS STYLE) ───────────────── -->
      <div id="focusDashboardCard" class="an-score-section dashboard-card" data-card-id="focus">
        <div class="dashboard-card-head dashboard-card-head-focus">
          <span class="dashboard-card-title">Focus Score</span>
          <button type="button" class="dashboard-card-toggle" data-card-toggle aria-expanded="true" aria-label="Minimize focus card" title="Minimize focus card">
            <span class="dashboard-card-toggle-icon">-</span>
          </button>
        </div>
        <div class="dashboard-card-body">
        <div class="an-triple-rings-wrap">
          <svg class="an-triple-svg" viewBox="0 0 200 200">
            <defs>
              <linearGradient id="ringGradWork" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#FF3B30"/>
                <stop offset="100%" style="stop-color:#FF9500"/>
              </linearGradient>
              <linearGradient id="ringGradMomentum" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#34C759"/>
                <stop offset="100%" style="stop-color:#32D74B"/>
              </linearGradient>
              <linearGradient id="ringGradWellness" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#00C7BE"/>
                <stop offset="100%" style="stop-color:#59DCFA"/>
              </linearGradient>
            </defs>
            
            <!-- Outer Ring: Deep Work (Red/Orange) r=85 -->
            <circle class="an-ring-bg" cx="100" cy="100" r="85" />
            <circle class="an-ring-fill ring-work" id="ringFillWork" cx="100" cy="100" r="85" />

            <!-- Middle Ring: Momentum (Green) r=65 -->
            <circle class="an-ring-bg" cx="100" cy="100" r="65" />
            <circle class="an-ring-fill ring-momentum" id="ringFillMomentum" cx="100" cy="100" r="65" />

            <!-- Inner Ring: Reflection/Wellness (Blue) r=45 -->
            <circle class="an-ring-bg" cx="100" cy="100" r="45" />
            <circle class="an-ring-fill ring-wellness" id="ringFillWellness" cx="100" cy="100" r="45" />
