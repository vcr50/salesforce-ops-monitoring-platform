      <a href="#notes"      class="nav-item" data-section="notes">             <span class="nav-icon">📝</span><span class="nav-label">Notes</span></a>
      <a href="#flashcards" class="nav-item" data-section="flashcards">        <span class="nav-icon">🃏</span><span class="nav-label">Flashcards</span></a>
      <a href="#trailhead"  class="nav-item" data-section="trailhead">         <span class="nav-icon">🏅</span><span class="nav-label">Salesforce & Trailhead</span></a>
      <a href="#project"    class="nav-item" data-section="project">           <span class="nav-icon">📁</span><span class="nav-label">Projects & POCs</span></a>
