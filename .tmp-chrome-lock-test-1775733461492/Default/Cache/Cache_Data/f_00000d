// ─── GOOGLE FIT / PEDOMETER INTEGRATION ───
window.refreshFitData = async function() {
  const widget = document.getElementById('googleFitWidget');
  const loading = document.getElementById('fitSyncLoading');
  if (widget) widget.style.display = 'block';
  if (loading) loading.style.display = 'block';

  const now = new Date();
  const startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  const endOfDay = startOfDay + 86400000;

  // ─── PATH 1: Native Health Connect (Android) — no token needed ───
  if (window.Capacitor?.isNativePlatform?.()) {
    try {
      // Try importing the Capacitor Health plugin dynamically
      let HealthPlugin = window.CapacitorHealth;
      if (!HealthPlugin) {
        try {
          const mod = await import('@capgo/capacitor-health');
          HealthPlugin = mod.CapacitorHealth || mod.Health;
        } catch(importErr) {
          console.warn("Could not import @capgo/capacitor-health:", importErr);
        }
      }
      
      if (HealthPlugin) {
        if (loading) loading.textContent = "Reading device sensors...";
        const availability = await HealthPlugin.isAvailable();
        
        if (availability.available) {
          await HealthPlugin.requestAuthorization({
            read: ['steps', 'calories', 'exerciseTime']
          });

          let steps = 0, cals = 0, move = 0;

          try {
            const stepData = await HealthPlugin.queryAggregated({
              dataType: 'steps',
              startDate: new Date(startOfDay).toISOString(),
              endDate: now.toISOString(),
              bucket: 'day',
              aggregation: 'sum'
            });
            if (stepData?.samples?.length > 0) steps = stepData.samples[0].value;
          } catch(e) { console.warn("Steps query failed:", e); }

          try {
            const calData = await HealthPlugin.queryAggregated({
              dataType: 'calories',
              startDate: new Date(startOfDay).toISOString(),
              endDate: now.toISOString(),
              bucket: 'day',
              aggregation: 'sum'
            });
            if (calData?.samples?.length > 0) cals = calData.samples[0].value;
          } catch(e) { console.warn("Calories query failed:", e); }

          try {
            const moveData = await HealthPlugin.queryAggregated({
              dataType: 'exerciseTime',
              startDate: new Date(startOfDay).toISOString(),
              endDate: now.toISOString(),
              bucket: 'day',
              aggregation: 'sum'
            });
            if (moveData?.samples?.length > 0) move = moveData.samples[0].value;
          } catch(e) { console.warn("Move minutes query failed:", e); }

          const elSteps = document.getElementById('fitStepsVal');
          const elHeart = document.getElementById('fitHeartVal');
          const elCals = document.getElementById('fitCalVal');
          const elMove = document.getElementById('fitMoveVal');

          if (elSteps) elSteps.textContent = Math.round(steps).toLocaleString();
          if (elCals) elCals.textContent = Math.round(cals);
          if (elMove) elMove.textContent = Math.round(move);
          if (elHeart) elHeart.textContent = '—';

          if (loading) loading.style.display = 'none';
          console.log("✅ Native Health Connect pedometer success:", { steps, cals, move });
          return;
        }
      }
    } catch(healthErr) {
      console.warn("Native Health Connect failed:", healthErr);
    }
    
    // ─── PATH 1b: Device Accelerometer Pedometer Fallback ───
    try {
      if (loading) loading.textContent = "Using device motion sensor...";
      startDevicePedometer();
      if (loading) { loading.textContent = "Counting steps via motion sensor..."; loading.style.display = 'none'; }
      return;
    } catch(motionErr) {
      console.warn("Device motion pedometer failed:", motionErr);
    }
  }

  // ─── PATH 2: Google Fit REST API (web / fallback) — needs token ───
  const token = localStorage.getItem('gcalToken');
  if (!token) {
    if (loading) { loading.textContent = "Login to sync fitness data"; loading.style.display = 'block'; }
    console.log("No gcalToken found for fitness API.");
    return;
  }

  try {
    const body = {
      "aggregateBy": [
        {"dataTypeName":"com.google.step_count.delta", "dataSourceId":"derived:com.google.step_count.delta:com.google.android.gms:estimated_steps"},
        {"dataTypeName":"com.google.heart_minutes", "dataSourceId":"derived:com.google.heart_minutes:com.google.android.gms:merge_heart_minutes"},
        {"dataTypeName":"com.google.calories.expended", "dataSourceId":"derived:com.google.calories.expended:com.google.android.gms:merge_calories_expended"},
        {"dataTypeName":"com.google.active_minutes", "dataSourceId":"derived:com.google.active_minutes:com.google.android.gms:merge_active_minutes"}
      ],
      "bucketByTime": {"durationMillis": 86400000},
      "startTimeMillis": startOfDay,
      "endTimeMillis": endOfDay
    };

    const res = await fetch('https://www.googleapis.com/fitness/v1/users/me/dataset:aggregate', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(body)
    });

    if (!res.ok) {
      if (res.status === 401) console.warn("Fitness API token expired/invalid");
      throw new Error(`Fit API error: ${res.status}`);
    }

    const data = await res.json();
    let steps = 0, heart = 0, cals = 0, move = 0;

    if (data.bucket) {
      data.bucket.forEach(b => {
        if (b.dataset) {
          b.dataset.forEach(ds => {
            if (ds.point) {
              ds.point.forEach(p => {
                if (p.value && p.value.length > 0) {
                  const valNum = p.value[0].intVal || p.value[0].fpVal || 0;
                  const type = p.dataTypeName || (ds.dataSourceId || '');
                  if (type.includes('step_count')) steps += valNum;
                  else if (type.includes('heart_minutes')) heart += valNum;
                  else if (type.includes('calories.expended')) cals += valNum;
                  else if (type.includes('active_minutes')) move += valNum;
                }
              });
            }
          });
        }
      });
    }

    const elSteps = document.getElementById('fitStepsVal');
    const elHeart = document.getElementById('fitHeartVal');
    const elCals = document.getElementById('fitCalVal');
    const elMove = document.getElementById('fitMoveVal');

    if (elSteps) elSteps.textContent = Math.round(steps).toLocaleString();
    if (elHeart) elHeart.textContent = Math.round(heart);
    if (elCals) elCals.textContent = Math.round(cals);
    if (elMove) elMove.textContent = Math.round(move);
    
    if (loading) loading.style.display = 'none';

  } catch(e) {
    console.error("Error fetching fitness data", e);
    if (loading) {
      loading.style.display = 'block';
      loading.textContent = "Sync Error: " + e.message;
      loading.style.color = "rgba(245, 158, 11, 0.8)";
    }
  }
};

// ─── DEVICE ACCELEROMETER PEDOMETER (hardware fallback) ───
function startDevicePedometer() {
  if (window._pedometerActive) return;
  window._pedometerActive = true;

  const storageKey = 'device_pedometer_' + new Date().toISOString().slice(0, 10);
  let stepCount = parseInt(localStorage.getItem(storageKey) || '0');
  let lastAccel = 0;
  let lastTime = 0;
  const THRESHOLD = 12; // acceleration threshold for a step
  const DEBOUNCE = 300; // ms between steps

  function updateUI() {
    const elSteps = document.getElementById('fitStepsVal');
    if (elSteps) elSteps.textContent = stepCount.toLocaleString();
    // Estimate calories: ~0.04 cal per step
    const elCals = document.getElementById('fitCalVal');
    if (elCals) elCals.textContent = Math.round(stepCount * 0.04);
    const elHeart = document.getElementById('fitHeartVal');
    if (elHeart) elHeart.textContent = '—';
    const elMove = document.getElementById('fitMoveVal');
    if (elMove) elMove.textContent = Math.round(stepCount / 100); // rough move minutes
  }

  updateUI();

  if (window.DeviceMotionEvent) {
    window.addEventListener('devicemotion', function(e) {
      const acc = e.accelerationIncludingGravity;
      if (!acc) return;
      const magnitude = Math.sqrt(acc.x * acc.x + acc.y * acc.y + acc.z * acc.z);
      const now = Date.now();

      if (magnitude > THRESHOLD && (now - lastTime) > DEBOUNCE) {
        stepCount++;
        lastTime = now;
        localStorage.setItem(storageKey, stepCount.toString());
        updateUI();
      }
      lastAccel = magnitude;
    });
    console.log("✅ Device motion pedometer active");
  } else {
    console.warn("DeviceMotionEvent not supported");
  }
}
