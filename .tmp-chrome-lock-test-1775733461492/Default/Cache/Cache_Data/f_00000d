// Session lock system (1-minute inactivity timeout + PIN unlock)
const sessionLockState = {
  initialized: false,
  active: false,
  isLocked: false,
  mode: "unlock", // unlock | setup
  authUid: "",
  authCheckTimerId: null,
  timerId: null,
  watchdogId: null,
  clockTimerId: null,
  activityBound: false,
  lastActivityAt: 0,
  hiddenAt: 0,
  blurredAt: 0,
  debugCounters: {
    timerResets: 0,
    timerFires: 0,
    timerStops: 0,
    lockRequests: 0,
    activityEvents: 0,
  },
};

function getSessionLockElements() {
  return {
    overlay: document.getElementById("sessionLockOverlay"),
    clock: document.getElementById("sessionLockClock"),
    date: document.getElementById("sessionLockDate"),
    title: document.getElementById("sessionLockTitle"),
    subtitle: document.getElementById("sessionLockSubtitle"),
    form: document.getElementById("sessionLockForm"),
    pinInput: document.getElementById("sessionLockPinInput"),
    pinConfirmInput: document.getElementById("sessionLockPinConfirmInput"),
    error: document.getElementById("sessionLockError"),
    submitBtn: document.getElementById("sessionLockSubmitBtn"),
    setupBtn: document.getElementById("sessionLockSetupBtn"),
    signOutBtn: document.getElementById("sessionLockSignOutBtn"),
    pinTopbarBtn: document.getElementById("sessionPinBtn"),
  };
}

function getSessionLockStorageKey() {
  const uid = window.fbAuth?.currentUser?.uid || "anonymous";
  return `${SESSION_LOCK_PIN_PREFIX}_${uid}`;
}

function getStoredSessionLockPinHash() {
  try {
    return localStorage.getItem(getSessionLockStorageKey()) || "";
  } catch (e) {
    console.warn("Session lock storage unavailable:", e);
    return "";
  }
}

async function hashSessionLockPin(pin) {
  if (window.crypto?.subtle && typeof TextEncoder !== "undefined") {
    const encoded = new TextEncoder().encode(pin);
    const digest = await window.crypto.subtle.digest("SHA-256", encoded);
    return Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("");
  }

  let fallbackHash = 0;
  for (let i = 0; i < pin.length; i++) {
    fallbackHash = (fallbackHash << 5) - fallbackHash + pin.charCodeAt(i);
    fallbackHash |= 0;
  }
  return `fallback_${Math.abs(fallbackHash)}`;
}

async function saveSessionLockPin(pin) {
  const hash = await hashSessionLockPin(pin);
  localStorage.setItem(getSessionLockStorageKey(), hash);
}

async function verifySessionLockPin(pin) {
  const storedHash = getStoredSessionLockPinHash();
  if (!storedHash) return false;
  const currentHash = await hashSessionLockPin(pin);
  return storedHash === currentHash;
}

function setSessionLockError(message) {
  const { error } = getSessionLockElements();
  if (!error) return;
  error.textContent = message || "";
}

function updateSessionLockClock() {
  const { clock, date } = getSessionLockElements();
  if (!clock || !date) return;

  const now = new Date();
  clock.textContent = now.toLocaleTimeString("en-IN", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
  date.textContent = now.toLocaleDateString("en-IN", {
    weekday: "short",
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function startSessionLockClock() {
  stopSessionLockClock();
  updateSessionLockClock();
  sessionLockState.clockTimerId = setInterval(updateSessionLockClock, 1000);
}

function stopSessionLockClock() {
  if (sessionLockState.clockTimerId) {
    clearInterval(sessionLockState.clockTimerId);
    sessionLockState.clockTimerId = null;
  }
}

function stopSessionLockTimer() {
  if (sessionLockState.timerId) {
    clearTimeout(sessionLockState.timerId);
    sessionLockState.timerId = null;
    sessionLockState.debugCounters.timerStops += 1;
  }
}

function stopSessionLockWatchdog() {
  if (sessionLockState.watchdogId) {
    clearInterval(sessionLockState.watchdogId);
    sessionLockState.watchdogId = null;
  }
}

function stopSessionLockAuthCheck() {
  if (sessionLockState.authCheckTimerId) {
    clearInterval(sessionLockState.authCheckTimerId);
    sessionLockState.authCheckTimerId = null;
  }
}

function reconcileSessionLockAuthState() {
  const user = window.fbAuth?.currentUser || null;
  const uid = user?.uid || "";

  if (uid) {
    if (!sessionLockState.active || sessionLockState.authUid !== uid) {
      activateSessionLock();
      return;
    }

    if (
      !sessionLockState.isLocked &&
      getStoredSessionLockPinHash() &&
      sessionLockState.lastActivityAt &&
      Date.now() - sessionLockState.lastActivityAt >= SESSION_LOCK_TIMEOUT_MS
    ) {
      lockSessionNow();
      return;
    }

    updateSessionPinButtonVisibility();
    return;
  }

  if (sessionLockState.active || sessionLockState.authUid) {
    deactivateSessionLock();
  } else {
    updateSessionPinButtonVisibility();
  }
}

function startSessionLockAuthCheck() {
  stopSessionLockAuthCheck();
  sessionLockState.authCheckTimerId = setInterval(
    reconcileSessionLockAuthState,
    1500
  );
}

function startSessionLockWatchdog() {
  stopSessionLockWatchdog();

  sessionLockState.watchdogId = setInterval(() => {
    if (!sessionLockState.active) return;
    if (sessionLockState.isLocked) return;
    if (!window.fbAuth?.currentUser) return;
    if (!getStoredSessionLockPinHash()) return;

    if (!sessionLockState.lastActivityAt) {
      sessionLockState.lastActivityAt = Date.now();
      return;
    }

    const idleFor = Date.now() - sessionLockState.lastActivityAt;
    if (idleFor >= SESSION_LOCK_TIMEOUT_MS) {
      lockSessionNow();
    }
  }, SESSION_LOCK_WATCHDOG_INTERVAL_MS);
}

function updateSessionPinButtonVisibility() {
  const { pinTopbarBtn } = getSessionLockElements();
  if (!pinTopbarBtn) return;

  const isAuthenticated = !!window.fbAuth?.currentUser;
  if (isAuthenticated) {
    pinTopbarBtn.classList.remove("hidden");
    pinTopbarBtn.style.display = "inline-flex";
  } else {
    pinTopbarBtn.classList.add("hidden");
    pinTopbarBtn.style.display = "none";
  }
}

function showSessionLockOverlay(mode = "unlock") {
  const {
    overlay,
    title,
    subtitle,
    pinInput,
    pinConfirmInput,
    submitBtn,
    setupBtn,
  } = getSessionLockElements();

  if (!overlay) return;

  const hasExistingPin = !!getStoredSessionLockPinHash();
  const isSetupMode = mode === "setup";

  sessionLockState.mode = mode;
  sessionLockState.isLocked = true;
  stopSessionLockTimer();
  stopSessionLockWatchdog();
  startSessionLockClock();

  if (title) {
    title.textContent = isSetupMode ? "Set Session PIN" : "Session Locked";
  }

  if (subtitle) {
    subtitle.textContent = isSetupMode
      ? "Create a 4-8 digit PIN. It will auto-lock after 1 minute of inactivity."
      : "Enter your PIN to continue.";
  }

  if (pinConfirmInput) {
    if (isSetupMode) {
      pinConfirmInput.classList.remove("hidden");
    } else {
      pinConfirmInput.classList.add("hidden");
      pinConfirmInput.value = "";
    }
  }

  if (submitBtn) {
    submitBtn.textContent = isSetupMode ? "Save PIN and Unlock" : "Unlock";
  }

  if (setupBtn) {
    if (isSetupMode && hasExistingPin) {
      setupBtn.textContent = "Back";
      setupBtn.disabled = false;
    } else if (isSetupMode && !hasExistingPin) {
      setupBtn.textContent = "PIN Required";
      setupBtn.disabled = true;
    } else {
      setupBtn.textContent = "Set / Change PIN";
      setupBtn.disabled = false;
    }
  }

  if (pinInput) pinInput.value = "";
  setSessionLockError("");

  overlay.classList.add("is-visible");
  overlay.setAttribute("aria-hidden", "false");
  document.body.classList.add("session-lock-active");

  setTimeout(() => {
    pinInput?.focus();
  }, 30);
}

function hideSessionLockOverlay() {
  const { overlay, pinInput, pinConfirmInput } = getSessionLockElements();
  if (!overlay) return;

  overlay.classList.remove("is-visible");
  overlay.setAttribute("aria-hidden", "true");
  document.body.classList.remove("session-lock-active");

  if (pinInput) pinInput.value = "";
  if (pinConfirmInput) pinConfirmInput.value = "";
  setSessionLockError("");

  sessionLockState.isLocked = false;
  sessionLockState.mode = "unlock";
  stopSessionLockClock();

  if (sessionLockState.active && getStoredSessionLockPinHash()) {
    sessionLockState.lastActivityAt = Date.now();
    startSessionLockWatchdog();
    resetSessionLockTimer();
  }
}

function lockSessionNow(options = {}) {
  sessionLockState.debugCounters.lockRequests += 1;
  const { forceSetup = false } = options;
  if (!sessionLockState.active && !forceSetup) return;
  showSessionLockOverlay(forceSetup ? "setup" : "unlock");
}

function resetSessionLockTimer() {
  sessionLockState.debugCounters.timerResets += 1;
  stopSessionLockTimer();

  if (!sessionLockState.active) return;
  if (!window.fbAuth?.currentUser) return;
  if (!getStoredSessionLockPinHash()) return;
  if (sessionLockState.isLocked) return;

  if (!sessionLockState.lastActivityAt) {
    sessionLockState.lastActivityAt = Date.now();
  }

  const elapsed = Date.now() - sessionLockState.lastActivityAt;
  const remaining = SESSION_LOCK_TIMEOUT_MS - elapsed;
  if (remaining <= 0) {
    lockSessionNow();
    return;
  }

  sessionLockState.timerId = setTimeout(() => {
    sessionLockState.debugCounters.timerFires += 1;
    lockSessionNow();
  }, remaining);
}

function handleSessionLockActivity(event) {
  if (!sessionLockState.active) return;
  if (sessionLockState.isLocked) return;
  if (event && event.isTrusted === false) return;
  sessionLockState.debugCounters.activityEvents += 1;
  sessionLockState.lastActivityAt = Date.now();
  resetSessionLockTimer();
}

function bindSessionLockActivity() {
  if (sessionLockState.activityBound) return;

  const activityEvents = [
    "mousedown",
    "keydown",
    "touchstart",
    "pointerdown",
  ];

  activityEvents.forEach((eventName) => {
    window.addEventListener(eventName, handleSessionLockActivity, {
      passive: true,
    });
  });

  sessionLockState.activityBound = true;
}

function activateSessionLock() {
  const uid = window.fbAuth?.currentUser?.uid || "";
  if (!uid) {
    deactivateSessionLock();
    return;
  }

  if (sessionLockState.active && sessionLockState.authUid === uid) {
    return;
  }

  sessionLockState.active = true;
  sessionLockState.authUid = uid;
  sessionLockState.lastActivityAt = Date.now();
  updateSessionPinButtonVisibility();
  bindSessionLockActivity();
  startSessionLockWatchdog();

  if (!getStoredSessionLockPinHash()) {
    lockSessionNow({ forceSetup: true });
    return;
  }

  hideSessionLockOverlay();
  resetSessionLockTimer();
}

function deactivateSessionLock() {
  sessionLockState.active = false;
  sessionLockState.authUid = "";
  sessionLockState.isLocked = false;
  sessionLockState.mode = "unlock";
  sessionLockState.lastActivityAt = 0;
  sessionLockState.hiddenAt = 0;
  sessionLockState.blurredAt = 0;
  stopSessionLockTimer();
  stopSessionLockWatchdog();
  stopSessionLockClock();
  updateSessionPinButtonVisibility();

  const { overlay } = getSessionLockElements();
  if (overlay) {
    overlay.classList.remove("is-visible");
    overlay.setAttribute("aria-hidden", "true");
  }
  document.body.classList.remove("session-lock-active");
}

async function handleSessionLockSubmit(event) {
  event.preventDefault();

  const { pinInput, pinConfirmInput, submitBtn } = getSessionLockElements();
  if (!pinInput || !submitBtn) return;

  const pin = pinInput.value.trim();
  if (!/^\d{4,8}$/.test(pin)) {
    setSessionLockError("Use a 4-8 digit PIN.");
    return;
  }

  submitBtn.disabled = true;
  try {
    if (sessionLockState.mode === "setup") {
      const confirmPin = pinConfirmInput?.value?.trim() || "";
      if (pin !== confirmPin) {
        setSessionLockError("PIN and confirm PIN do not match.");
        return;
      }

      await saveSessionLockPin(pin);
      hideSessionLockOverlay();
      showToast("Session lock enabled. Timeout is set to 1 minute.");
      return;
    }

    const ok = await verifySessionLockPin(pin);
    if (!ok) {
      setSessionLockError("Incorrect PIN. Try again.");
      pinInput.value = "";
      pinInput.focus();
      return;
    }

    hideSessionLockOverlay();
  } finally {
    submitBtn.disabled = false;
  }
}

function initSessionLockSystem() {
  if (sessionLockState.initialized) return;
  const {
    overlay,
    form,
    setupBtn,
    signOutBtn,
    pinTopbarBtn,
  } = getSessionLockElements();
  if (!overlay || !form) return;

  form.addEventListener("submit", handleSessionLockSubmit);

  setupBtn?.addEventListener("click", () => {
    if (sessionLockState.mode === "setup" && getStoredSessionLockPinHash()) {
      showSessionLockOverlay("unlock");
      return;
    }
    showSessionLockOverlay("setup");
  });

  signOutBtn?.addEventListener("click", () => {
    if (typeof window.fbSignOutUser === "function") {
      window.fbSignOutUser();
    }
  });

  pinTopbarBtn?.addEventListener("click", () => {
    if (!window.fbAuth?.currentUser) return;
    showSessionLockOverlay("setup");
  });

  window.addEventListener("vertexdb-auth-state", (event) => {
    const authenticated = !!event.detail?.authenticated;
    if (authenticated) {
      activateSessionLock();
    } else {
      deactivateSessionLock();
    }
    reconcileSessionLockAuthState();
  });

  document.addEventListener("visibilitychange", () => {
    if (!sessionLockState.active || sessionLockState.isLocked) return;
    if (document.hidden) {
      sessionLockState.hiddenAt = Date.now();
      return;
    }

    const elapsed = sessionLockState.hiddenAt
      ? Date.now() - sessionLockState.hiddenAt
      : 0;
    sessionLockState.hiddenAt = 0;

    if (elapsed >= SESSION_LOCK_TIMEOUT_MS) {
      lockSessionNow();
    } else {
      resetSessionLockTimer();
    }
  });

  window.addEventListener("blur", () => {
    if (!sessionLockState.active || sessionLockState.isLocked) return;
    sessionLockState.blurredAt = Date.now();
  });

  window.addEventListener("focus", () => {
    if (!sessionLockState.active || sessionLockState.isLocked) return;
    const elapsed = sessionLockState.blurredAt
      ? Date.now() - sessionLockState.blurredAt
      : 0;
    sessionLockState.blurredAt = 0;

    if (elapsed >= SESSION_LOCK_TIMEOUT_MS) {
      lockSessionNow();
    } else {
      resetSessionLockTimer();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!sessionLockState.active || sessionLockState.isLocked) return;
    if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === "l") {
      event.preventDefault();
      lockSessionNow();
    }
  });

  window.lockSessionNow = () => lockSessionNow();
  window.openSessionPinSetup = () => showSessionLockOverlay("setup");
  window.__sessionLockDebug = () => ({
    active: sessionLockState.active,
    isLocked: sessionLockState.isLocked,
    mode: sessionLockState.mode,
    authUid: sessionLockState.authUid,
    hasCurrentUser: !!window.fbAuth?.currentUser,
    hasPin: !!getStoredSessionLockPinHash(),
    lastActivityAt: sessionLockState.lastActivityAt,
    idleForMs: sessionLockState.lastActivityAt
      ? Date.now() - sessionLockState.lastActivityAt
      : 0,
    timerRunning: !!sessionLockState.timerId,
    watchdogRunning: !!sessionLockState.watchdogId,
    authCheckRunning: !!sessionLockState.authCheckTimerId,
    documentHidden: document.hidden,
    timeoutMs: SESSION_LOCK_TIMEOUT_MS,
    debugCounters: { ...sessionLockState.debugCounters },
  });

  sessionLockState.initialized = true;
  updateSessionPinButtonVisibility();
  startSessionLockAuthCheck();
  reconcileSessionLockAuthState();

  setTimeout(() => {
    reconcileSessionLockAuthState();
  }, 200);
}

