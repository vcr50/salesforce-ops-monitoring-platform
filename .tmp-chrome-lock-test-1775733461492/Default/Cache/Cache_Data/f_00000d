function updateCertReadiness() {
  const el = document.getElementById("certReadiness");
  if (!el) return;
  const topics = state.certTrack?.topics || [];
  const mocks = state.certTrack?.mocks || [];
  if (topics.length === 0 && mocks.length === 0) {
    el.style.display = "none";
    return;
  }

  const topicPct = topics.length
    ? topics.filter((t) => t.done).length / topics.length
    : 0;
  const avgMock = mocks.length
    ? mocks.reduce((s, m) => s + m.score, 0) / mocks.length / 100
    : 0;
  const readiness = Math.round((topicPct * 0.6 + avgMock * 0.4) * 100);

  let badge, color;
  if (readiness >= 75) {
    badge = "🟢 Ready to Attempt";
    color = "#10B981";
  } else if (readiness >= 50) {
    badge = "🟡 On Track";
    color = "#F59E0B";
  } else {
    badge = "🔴 Needs More Study";
    color = "#EF4444";
  }

  el.style.cssText = `display:flex; align-items:center; gap:16px; padding:16px 20px; background:${color}11; border:1px solid ${color}33; border-radius:12px;`;
  el.innerHTML = `<span style="font-size:36px; font-weight:800; color:${color};">${readiness}%</span>
    <div>
      <div style="font-size:16px; font-weight:700; color:${color};">${badge}</div>
      <div style="font-size:12px; color:var(--text-muted);">Topics: ${Math.round(topicPct * 100)}% covered · Mock avg: ${mocks.length ? Math.round(avgMock * 100) : "N/A"}%</div>
    </div>`;
}

