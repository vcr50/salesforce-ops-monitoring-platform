// ─── PHASE PLAN ───────────────────────────────
function buildPhasePlan() {
  const grid = document.getElementById("phasesGrid");
  if (!grid) return;
  grid.innerHTML = "";

  const currentPhases =
    state.phasesList !== undefined ? state.phasesList : PHASES;

  if (currentPhases.length === 0) {
    const empty = document.createElement("div");
    empty.style = "color:var(--text-muted); padding:20px; text-align:center;";
    empty.textContent = "No custom phases defined yet.";
    grid.appendChild(empty);
    return;
  }

  currentPhases.forEach((p, i) => {
    const total = Math.max(1, p.dayEnd - p.dayStart + 1);
    let doneDays = 0,
      checkedTopics = 0;
    for (let d = p.dayStart; d <= p.dayEnd; d++)
      if ((state.days[d] || {}).completed) doneDays++;

    const pid = p.id || i + 1;

    // Safety check if topics is undefined
    const topicsArr = p.topics || [];
    topicsArr.forEach((_, tIdx) => {
      if (state.phases && state.phases[`${pid}-${tIdx}`]) checkedTopics++;
    });
    const pct = Math.round((doneDays / total) * 100);

    const topicsHtml = topicsArr
      .map((topic, tIdx) => {
        const checked =
          state.phases && state.phases[`${pid}-${tIdx}`] ? "checked" : "";
        return `<li class="phase-topic-item">
        <input type="checkbox" ${checked} onchange="togglePhaseTopic('${pid}',${tIdx},this.checked)" />
        <span class="${checked}">${topic}</span></li>`;
      })
      .join("");

    const isCustom = typeof pid === "string"; // v3 dynamic phases use 'p_12345'
    const bColor = isCustom ? p.color : "";
    const classBorder = !isCustom ? `phase-border-${pid}` : "";
    const classBg = !isCustom ? `phase-color-${pid}` : "";
    const isLocked = p.locked === true;

    const card = document.createElement("div");
    card.className = `phase-card ${classBorder}`;
    if (isCustom) card.style.borderTopColor = bColor;

    card.innerHTML = `
      <div class="phase-controls">
        <button class="phase-ctrl-btn lock-btn" title="${isLocked ? "Unlock Phase" : "Lock Phase"}">${isLocked ? "🔒" : "🔓"}</button>
        ${
          !isLocked
            ? `<button class="phase-ctrl-btn edit-btn" title="Edit Phase">✏️</button>
                       <button class="phase-ctrl-btn del-btn" title="Delete Phase">🗑️</button>`
            : ""
        }
      </div>
      <div class="phase-card-header">
        <span class="phase-card-number">Phase ${i + 1}</span>
        <span class="phase-card-days">Days ${p.dayStart}–${p.dayEnd}</span>
      </div>
      <div class="phase-card-title">${p.name}</div>
      <div class="phase-bar-wrap">
        <div class="phase-bar-row">
          <span>Topics: ${checkedTopics}/${topicsArr.length}</span>
          <span>Days: ${doneDays}/${total} (${pct}%)</span>
        </div>
        <div class="phase-bar-track">
          <div class="phase-bar-fill ${classBg}" style="width:${Math.round((checkedTopics / Math.max(1, topicsArr.length)) * 100)}%;${isCustom ? `background:${bColor}` : ""}"></div>
        </div>
      </div>
      <ul class="phase-topics">${topicsHtml}</ul>`;

    // Attach listeners
    card.querySelector(".lock-btn").onclick = () => {
      p.locked = !p.locked;
      saveState();
      buildPhasePlan();
    };
    if (!isLocked) {
