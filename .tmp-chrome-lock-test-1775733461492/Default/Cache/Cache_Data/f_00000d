  document.getElementById('tgSaveChatBtn')?.addEventListener('click', () => {
    let textOut = globalState.telegramHistory?.map(m => `${m.type.toUpperCase()} [${new Date(m.date).toLocaleString()}]: ${m.text || m.fileName}`).join('\n');
    if (!textOut) return showToast('Nothing to save!', 'error');
    const blob = new Blob([textOut], { type: 'text/plain' });
