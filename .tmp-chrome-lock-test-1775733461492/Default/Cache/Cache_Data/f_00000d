// ─── GOOGLE FIT INTEGRATION ───────────────────────────────────────────────
window.refreshFitData = async function() {
  const token = localStorage.getItem('gcalToken');
  const widget = document.getElementById('googleFitWidget');
  const loading = document.getElementById('fitSyncLoading');
  if (!token || !widget) return;

  widget.style.display = 'block';
  if (loading) loading.style.display = 'block';
  
  const now = Date.now();
  const startOfDay = new Date();
  startOfDay.setHours(0, 0, 0, 0);
  const startTimeMillis = startOfDay.getTime();

  const requestBody = {
    aggregateBy: [
      { dataTypeName: "com.google.step_count.delta" },
      { dataTypeName: "com.google.heart_minutes" },
      { dataTypeName: "com.google.active_minutes" },
      { dataTypeName: "com.google.calories.expended" }
    ],
    bucketByTime: { durationMillis: 86400000 }, // 24 hours
    startTimeMillis: startTimeMillis,
    endTimeMillis: now
  };

  try {
    const response = await fetch('https://www.googleapis.com/fitness/v1/users/me/dataset:aggregate', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(requestBody)
    });

    if (!response.ok) {
      if (response.status === 401 || response.status === 403) {
        console.warn("Google Fit access expired or missing scopes.");
        if (loading) loading.innerText = "Access expired. Re-login required.";
      }
      throw new Error('Fit API Error');
    }

    const data = await response.json();
    if (data.bucket && data.bucket[0] && data.bucket[0].dataset) {
      const datasets = data.bucket[0].dataset;
      
      let steps = 0, heartPts = 0, calories = 0, moveMins = 0;

      datasets.forEach(ds => {
        const val = ds.point[0]?.value[0];
        if (!val) return;
        
        if (ds.dataSourceId.includes('step_count')) steps = val.intVal || val.fpVal || 0;
        if (ds.dataSourceId.includes('heart_minutes')) heartPts = val.fpVal || val.intVal || 0;
        if (ds.dataSourceId.includes('calories')) calories = Math.round(val.fpVal || 0);
        if (ds.dataSourceId.includes('active_minutes')) moveMins = Math.round(val.fpVal || val.intVal || 0);
      });

      document.getElementById('fitStepsVal').innerText = steps.toLocaleString();
      document.getElementById('fitHeartVal').innerText = heartPts;
      document.getElementById('fitCalVal').innerText = calories;
      document.getElementById('fitMoveVal').innerText = moveMins;
      
      if (loading) loading.style.display = 'none';
    }
  } catch (err) {
    console.error("Fit sync error", err);
    if (loading) loading.innerText = "Sync failed. Try re-login.";
  }
};
