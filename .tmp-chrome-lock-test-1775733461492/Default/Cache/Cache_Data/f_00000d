function fetchNews(tab) {
  const feed = document.getElementById("newsFeed");
  if (!feed) return;

  let cached = newsCache[tab];
  if (!cached) {
    try {
      const stored = localStorage.getItem("alive_news_cache_" + tab);
      if (stored) {
        cached = JSON.parse(stored);
        newsCache[tab] = cached;
      }
    } catch (e) {}
  }

  // Instantly render from offline local cache if available 
  // (Provides instant screen population while background fetching if expired)
  if (cached && cached.articles && cached.articles.length > 0) {
    renderNews(cached.articles, tab);
    // If it's less than 15 mins old, don't even hammer the network
    if (Date.now() - cached.ts < 900000) return;
  }

  feed.innerHTML = `<div class="news-skeleton">
    ${[1, 2, 3, 4, 5, 6].map(() => `<div class="news-skel-card"><div class="skel-line w80"></div><div class="skel-line w50"></div></div>`).join("")}
  </div>`;

  const sources = NEWS_FEEDS[tab] || NEWS_FEEDS.tech;

  function parseXML(xml) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(xml, "text/xml");
    return [...doc.querySelectorAll("item, entry")].slice(0, 6).map((item) => {
      const get = (tag) => item.querySelector(tag)?.textContent?.trim() || "";
      return {
        title: get("title"),
        link:
          get("link") || item.querySelector("link")?.getAttribute("href") || "",
        pubDate: get("pubDate") || get("published") || get("updated") || "",
        desc: (get("description") || get("summary") || get("content"))
          .replace(/<[^>]+>/g, "")
          .slice(0, 130),
        thumb:
          item.querySelector('enclosure[type^="image"]')?.getAttribute("url") ||
          "",
      };
    });
  }

  async function fetchFeed(src, bust) {
    const feedUrl = src.url;

    // Method 1: rss2json.com — converts RSS to JSON server-side (reliable CORS)
    try {
      const r2jUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feedUrl)}`;
      const r = await fetch(r2jUrl, { cache: "no-store" });
      if (r.ok) {
        const data = await r.json();
        if (data.status === "ok" && data.items) {
          return data.items.slice(0, 6).map((item) => ({
            title: item.title || "",
            link: item.link || "",
            pubDate: item.pubDate || "",
            desc: (item.description || "")
              .replace(/<[^>]+>/g, "")
              .slice(0, 130),
            thumb: item.thumbnail || item.enclosure?.link || "",
            source: src.name,
            color: src.color,
          }));
        }
      }
    } catch (e) {}

    // Method 2: corsproxy fallback (returns raw XML)
    try {
      const p1 = `https://corsproxy.io/?url=${encodeURIComponent(feedUrl)}`;
      const r1 = await fetch(p1, { cache: "no-store" });
      if (r1.ok) {
        return parseXML(await r1.text()).map((a) => ({
          ...a,
          source: src.name,
          color: src.color,
        }));
      }
    } catch (e) {}

    return [];
  }

  Promise.all(sources.map((src) => fetchFeed(src, true))).then((results) => {
    const articles = results
      .flat()
      .filter((a) => a.title)
      .sort((a, b) => new Date(b.pubDate) - new Date(a.pubDate))
      .slice(0, 25);
    newsCache[tab] = { articles, ts: Date.now() };
    try { localStorage.setItem("alive_news_cache_" + tab, JSON.stringify(newsCache[tab])); } catch(e){}
    renderNews(articles, tab);
    const ts = document.getElementById("newsTimestamp");
    if (ts)
      ts.textContent = `Last updated: ${new Date().toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })} · ${articles.length} headlines`;
  });
}

function renderNews(articles, tab) {
  const feed = document.getElementById("newsFeed");
  if (!feed) return;
  if (!articles.length) {
    feed.innerHTML =
      '<div class="empty-state">Could not load headlines. Check your internet connection and try refreshing. 🌐</div>';
    return;
  }

  feed.innerHTML = articles
    .map((a) => {
      const age = timeAgo(new Date(a.pubDate));
      const thumb = a.thumb
        ? `<img src="${a.thumb}" class="news-thumb" alt="" onerror="this.style.display='none'" />`
        : "";
      return `<a class="news-card" href="${a.link}" target="_blank" rel="noopener">
      ${thumb}
      <div class="news-card-body">
        <div class="news-source"><span class="news-source-dot" style="background:${a.color};"></span>${a.source} · ${age}</div>
        <div class="news-title">${a.title}</div>
        ${a.desc ? `<div class="news-desc">${a.desc}…</div>` : ""}
      </div>
    </a>`;
    })
    .join("");
}

function timeAgo(date) {
  const diff = Math.floor((Date.now() - date) / 60000);
  if (diff < 1) return "just now";
  if (diff < 60) return `${diff}m ago`;
  if (diff < 1440) return `${Math.floor(diff / 60)}h ago`;
  return `${Math.floor(diff / 1440)}d ago`;
}

