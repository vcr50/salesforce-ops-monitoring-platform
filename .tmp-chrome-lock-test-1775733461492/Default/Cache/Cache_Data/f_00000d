async function checkDailyBriefing() {
  if (!globalState.autoPushAgenda) return;

  const now = new Date();
  const hour = now.getHours();
  const todayStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');

  // If it's 9 PM or later AND we haven't pushed today yet
  if (hour >= 21 && globalState.lastPushDate !== todayStr) {
    await triggerTomorrowAgendaPush();
    globalState.lastPushDate = todayStr;
    saveState();
  }
}

async function triggerTomorrowAgendaPush() {
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const tomStr = tomorrow.getFullYear() + '-' + String(tomorrow.getMonth() + 1).padStart(2, '0') + '-' + String(tomorrow.getDate()).padStart(2, '0');
  const displayDate = tomorrow.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

  // Get events from local state and GCal cache
  const localEvs = (globalState.calendarEvents || []).filter(ev => ev.date === tomStr);
  const gcalEvs = (window.fetchedGCalEvents || []).filter(ev => ev.date === tomStr);
  
  // Combine and deduplicate
  const all = [...gcalEvs];
  localEvs.forEach(le => {
    if (!le.gcalId || !gcalEvs.find(ge => ge.gcalId === le.gcalId)) {
      all.push(le);
    }
  });

  if (all.length === 0) {
    await sendTelegramMsg(`🌅 *Tomorrow's Agenda (${displayDate})*\n\nNo events scheduled yet. Enjoy your evening! 🧘‍♂️`);
    return;
  }

  // Sort by time
  all.sort((a,b) => (a.time || '00:00').localeCompare(b.time || '00:00'));

  let msg = `📅 *Tomorrow's Agenda (${displayDate})*\n\n`;
  all.forEach(ev => {
    const timeLabel = ev.time ? `*${window.format12h ? window.format12h(ev.time) : ev.time}*` : '📌 *All Day*';
    msg += `${timeLabel} 🔹 ${ev.title}\n`;
    if (ev.description) msg += `_  └ ${ev.description.substring(0, 55)}..._\n`;
  });
  
  msg += `\nKeep pushing! 💪 #SFDC`;
  await sendTelegramMsg(msg);
}

