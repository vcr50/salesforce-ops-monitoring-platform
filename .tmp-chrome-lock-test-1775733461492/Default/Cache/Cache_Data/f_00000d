      link: e.node.url || '',
      pubDate: new Date().toISOString(),
      source: 'Product Hunt',
      color: '#DA552F',
    }));
  } catch(e) { return []; }
}

async function _fetchRSSviaProxy(feedUrl, srcName, srcColor) {
  const proxies = [
    url => `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`,
    url => `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(url)}&count=8`,
    url => `https://corsproxy.io/?url=${encodeURIComponent(url)}`,
    url => `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(url)}`,
  ];

  for (const mkUrl of proxies) {
    try {
      const u = mkUrl(feedUrl);
      const r = await _fetchWithTimeout(u, {}, 6000);
      if (!r.ok) continue;

      const ct = r.headers.get('content-type') || '';
      if (ct.includes('json') || u.includes('rss2json')) {
        const d = await r.json();
        if (d.status === 'ok' && d.items && d.items.length) {
          return d.items.slice(0, 6).map(it => ({
            title: it.title || '', link: it.link || '',
            pubDate: it.pubDate || '', source: srcName, color: srcColor,
          }));
        }
        continue;
      }

      const xml = await r.text();
      if (!xml || xml.length < 100) continue;
      const doc = new DOMParser().parseFromString(xml, 'text/xml');
      const items = [...doc.querySelectorAll('item, entry')];
      if (!items.length) continue;
      return items.slice(0, 6).map(it => {
        const g = tag => it.querySelector(tag)?.textContent?.trim() || '';
        return {
          title: g('title'),
          link: g('link') || it.querySelector('link')?.getAttribute('href') || '',
          pubDate: g('pubDate') || g('published') || g('updated') || '',
          source: srcName, color: srcColor,
        };
      });
    } catch(e) { /* next proxy */ }
  }
  return [];
}

function _saveNewsCache(articles) {
  try {
    localStorage.setItem(_NEWS_CACHE_KEY, JSON.stringify({ articles, ts: Date.now() }));
  } catch(e) {}
}

function _loadNewsCache() {
  try {
    const c = JSON.parse(localStorage.getItem(_NEWS_CACHE_KEY));
    if (c && c.articles && c.articles.length) return c;
  } catch(e) {}
  return null;
}

function _renderHeadlines(listEl, articles, fromCache) {
  listEl.innerHTML = articles.map((a, i) => {
    const age = (() => {
      const diff = Math.floor((Date.now() - new Date(a.pubDate)) / 60000);
      if (!diff || isNaN(diff)) return '';
      if (diff < 60) return `${diff}m ago`;
      if (diff < 1440) return `${Math.floor(diff/60)}h ago`;
      return `${Math.floor(diff/1440)}d ago`;
    })();
    return `
      <a href="${a.link}" target="_blank" rel="noopener" class="an-news-item" style="animation-delay:${i*0.08}s">
        <span class="an-news-src-dot" style="background:${a.color};box-shadow:0 0 8px ${a.color}55;"></span>
        <div>
          <div class="an-news-title">${a.title}</div>
          <div class="an-news-time">${a.source}${age ? ' · ' + age : ''}${fromCache ? ' · cached' : ''}</div>
        </div>
      </a>`;
  }).join('');
}

async function fetchHeadlines() {
  const listEl = document.getElementById('newsList');
  const locEl  = document.getElementById('newsLocText');
  if (!listEl) return;

  try {
    const wCache = JSON.parse(localStorage.getItem('alive_weather_cache_v3'));
