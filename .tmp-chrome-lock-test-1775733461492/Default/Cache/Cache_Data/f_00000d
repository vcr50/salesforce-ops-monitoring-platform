function initTrailheadProfile() {
  // Guard: only attach event listeners once
  if (window._trailheadProfileInited) {
    renderTrailheadProfile(); // Just re-render with fresh state
    return;
  }
  window._trailheadProfileInited = true;

  const usernameInput = document.getElementById("thUsername");
  const openBtn = document.getElementById("thOpenBtn");
  const saveUsernameBtn = document.getElementById("thSaveUsernameBtn");
  const manualPtsInput = document.getElementById("thManualPts");
  const syncPtsBtn = document.getElementById("thSyncPtsBtn");
