    const a = document.createElement('a');
    a.href = url;
    a.download = `chat_history_${Date.now()}.txt`;
    a.click();
    showToast('Chat history exported 💾');
  });

  document.getElementById('tgCallBtn')?.addEventListener('click', () => {
    showToast('Calling... 📞 (Simulated)');
  });

  document.getElementById('tgVideoCallBtn')?.addEventListener('click', () => {
    showToast('Starting Video Call... 📹 (Simulated)');
  });

  document.getElementById('tgPdfFile')?.addEventListener('change', (e) => {
    if (e.target.files.length > 0) {
      showToast(`Selected PDF: ${e.target.files[0].name} 📄. Click ➤ to push!`);
    }
  });
}

window.doSchedulePush = function() {
  const content = document.getElementById('scheduleMsgContent')?.value;
  const date = document.getElementById('scheduleMsgDate')?.value;
  const time = document.getElementById('scheduleMsgTime')?.value;
  const isCal = document.getElementById('scheduleCalReminder')?.checked;
  
  if (!content) return showToast('Enter message content!', 'error');

  if (date && time) {
    const scheduleDT = new Date(`${date}T${time}`).getTime();
    const now = Date.now();
    
    if (scheduleDT > now) {
      const diffMs = scheduleDT - now;
      if (diffMs < 2147483647) { // Max timeout safely
        setTimeout(() => sendTelegramMsg('⏰ *Scheduled Reminder:*\n' + content), diffMs);
      }
    } else {
      return showToast('Time must be in the future!', 'error');
    }
  }

  if (isCal && window.createGoogleTask && date && time) {
    window.createGoogleTask({ text: content, date: date, done: false, priority: "high" });
    showToast('Scheduled! Google Task also updated ✅');
  } else {
    showToast(`Push scheduled successfully! ⏰`);
  }

  document.getElementById('tgScheduleModal').style.display = 'none';
  if (document.getElementById('scheduleMsgContent')) document.getElementById('scheduleMsgContent').value = '';
};

