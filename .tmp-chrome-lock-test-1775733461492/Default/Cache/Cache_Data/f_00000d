function getTrailheadRank(badges, points) {
  let current = TRAILHEAD_RANKS[0];
  let next = TRAILHEAD_RANKS[1];

  for (let i = 0; i < TRAILHEAD_RANKS.length; i++) {
    if (badges >= TRAILHEAD_RANKS[i].badges && points >= TRAILHEAD_RANKS[i].points) {
      current = TRAILHEAD_RANKS[i];
      next = TRAILHEAD_RANKS[i + 1] || null;
    }
  }
  return { current, next };
}

