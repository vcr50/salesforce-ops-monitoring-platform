function initWeeklyReview() {
  if (!document.getElementById("weekLabel")) return;
  function loadWeek(w) {
    currentWeek = w;
    document.getElementById("weekLabel").textContent = `Week ${w}`;
    if (!state.weekly) state.weekly = {};
    const data = state.weekly[w] || {};
    document.getElementById("wLearned").value = data.learned || "";
    document.getElementById("wBuilt").value = data.built || "";
    document.getElementById("wMissed").value = data.missed || "";
    document.getElementById("wPlan").value = data.plan || "";
    let hrs = 0;
    const s = (w - 1) * 7 + 1,
      e = Math.min(w * 7, TOTAL_DAYS);
    for (let d = s; d <= e; d++)
      hrs += parseFloat((state.days[d] || {}).hours || 0);
    document.getElementById("weekHoursDisplay").textContent =
      hrs.toFixed(1) + "h";
  }
  const prevBtn = document.getElementById("weekPrev");
  const nextBtn = document.getElementById("weekNext");
  const saveBtn = document.getElementById("saveWeekBtn");

  if (prevBtn) prevBtn.onclick = () => {
    if (currentWeek > 1) loadWeek(currentWeek - 1);
  };
  if (nextBtn) nextBtn.onclick = () => {
    if (currentWeek < totalWeeks()) loadWeek(currentWeek + 1);
  };
  if (saveBtn) saveBtn.onclick = () => {
    state.weekly[currentWeek] = {
      learned: document.getElementById("wLearned")?.value || "",
      built: document.getElementById("wBuilt")?.value || "",
      missed: document.getElementById("wMissed")?.value || "",
      plan: document.getElementById("wPlan")?.value || "",
    };
    saveState();
    showToast("Weekly Review saved! 🧠");
  };
  const td = getTodayDayNum();
  loadWeek(td ? getWeekForDay(td) : 1);
}

// ─── POMODORO TIMER ───────────────────────────
function initPomodoro() {
  const timeEl = document.getElementById("pomoTime");
  const startBtn = document.getElementById("pomoStart");
  const resetBtn = document.getElementById("pomoReset");
  if (!timeEl || !startBtn || !resetBtn) return;

  function updateDisplay() {
    const m = String(pomoMinutes).padStart(2, "0");
    const s = String(pomoSeconds).padStart(2, "0");
    timeEl.textContent = `${m}:${s}`;
    timeEl.className =
      "pomo-time" +
      (pomoRunning ? (pomoBreakMode ? " break" : " running") : "");
  }

  function tick() {
    if (pomoSeconds === 0) {
      if (pomoMinutes === 0) {
        clearInterval(pomoInterval);
        pomoRunning = false;
        pomoCycles++;
        beep();
        if (pomoBreakMode) {
          // Break over → back to work
          pomoBreakMode = false;
          pomoMinutes = 25;
          pomoSeconds = 0;
          showToast("Break over! Back to studying 💪");
        } else {
          // Work done → short break
          const today = getTodayDayNum();
          if (today) {
            if (!state.days[today]) state.days[today] = {};
            state.days[today].pomodorosCompleted =
              (state.days[today].pomodorosCompleted || 0) + 1;
            saveState();
            updateOverview();
            buildDailyTable();
          }
          pomoBreakMode = true;
          pomoMinutes = pomoCycles % 4 === 0 ? 15 : 5;
          pomoSeconds = 0;
          const breakMsg = `Pomodoro ${pomoCycles} done! Take a ${pomoCycles % 4 === 0 ? "15" : "5"}-min break ☕`;
          showToast(breakMsg);
          
          // Send Telegram Notification
          sendTelegramMsg(`🍅 *Pomodoro Completed!*\n✅ Cycle: ${pomoCycles}\n🎉 ${breakMsg}`);
        }
        updateDisplay();
        return;
      }
      pomoMinutes--;
      pomoSeconds = 59;
    } else {
      pomoSeconds--;
    }
    updateDisplay();
  }

  startBtn.addEventListener("click", () => {
    if (pomoRunning) {
      clearInterval(pomoInterval);
      pomoRunning = false;
      startBtn.textContent = "▶";
    } else {
      pomoInterval = setInterval(tick, 1000);
      pomoRunning = true;
      startBtn.textContent = "⏸";
    }
    updateDisplay();
  });

  resetBtn.addEventListener("click", () => {
    clearInterval(pomoInterval);
    pomoRunning = false;
    pomoBreakMode = false;
    pomoMinutes = 25;
    pomoSeconds = 0;
    startBtn.textContent = "▶";
    updateDisplay();
  });

  updateDisplay();
}

function beep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.frequency.value = 880;
    osc.type = "sine";
    gain.gain.setValueAtTime(0.3, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);
    osc.start(ctx.currentTime);
    osc.stop(ctx.currentTime + 0.8);
  } catch (e) {}
}

// ─── NOTIFICATIONS ────────────────────────────
function initNotifications() {
  const btn = document.getElementById("notifBtn");
  if (!btn) return;
  if (!("Notification" in window)) {
    btn.style.display = "none";
    return;
  }
  if (Notification.permission === "granted") btn.classList.add("active");

  btn.addEventListener("click", async () => {
    if (Notification.permission === "granted") {
      const hr = prompt(
        "Remind me to study at (24h format, e.g. 20 for 8 PM):",
        "20",
      );
      if (hr !== null) scheduleNotification(parseInt(hr));
    } else {
      const perm = await Notification.requestPermission();
      if (perm === "granted") {
        btn.classList.add("active");
        showToast("Reminders enabled! 🔔");
        scheduleNotification(20);
      }
    }
  });
}

function scheduleNotification(hour) {
  const now = new Date();
  const next = new Date();
  next.setHours(hour, 0, 0, 0);
  if (next <= now) next.setDate(next.getDate() + 1);
  const delay = next - now;
  setTimeout(() => {
    if (Notification.permission === "granted") {
    new Notification("Salesforce Study Time! ⚡", {
        body: "Time to hit your daily study goal. Open your SFDC dashboard!",
        icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">⚡</text></svg>',
      });
    }
    
    // Also push to Telegram
    sendTelegramMsg(`⏰ *Study Time Reminder!*\nIt's time for your scheduled study session. Open the dashboard and start your journey! 🚀`);
    
    scheduleNotification(hour); // re-schedule for next day
  }, delay);
  showToast(`Daily reminder set for ${hour}:00 🔔`);
}

