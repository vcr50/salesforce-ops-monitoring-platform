function getWeatherMoonPhaseInfo(date = new Date()) {
  const d = new Date(date);
  let y = d.getFullYear();
  let m = d.getMonth() + 1;
  const day = d.getDate();

  if (m < 3) {
    y -= 1;
    m += 12;
  }

  const a = Math.floor(y / 100);
  const b = Math.floor(a / 4);
  const c = 2 - a + b;
  const e = Math.floor(365.25 * (y + 4716));
  const f = Math.floor(30.6001 * (m + 1));
  const jd = c + day + e + f - 1524.5;

  let phase = ((jd - 2451549.5) / 29.53058867) % 1;
  if (phase < 0) phase += 1;

  const phases = [
    { max: 0.03, icon: "\u{1F311}", name: "New Moon" },
    { max: 0.22, icon: "\u{1F312}", name: "Waxing Crescent" },
    { max: 0.28, icon: "\u{1F313}", name: "First Quarter" },
    { max: 0.47, icon: "\u{1F314}", name: "Waxing Gibbous" },
    { max: 0.53, icon: "\u{1F315}", name: "Full Moon" },
    { max: 0.72, icon: "\u{1F316}", name: "Waning Gibbous" },
    { max: 0.78, icon: "\u{1F317}", name: "Last Quarter" },
    { max: 1.0, icon: "\u{1F318}", name: "Waning Crescent" },
  ];

  const entry = phases.find((p) => phase < p.max) || phases[phases.length - 1];
  return { phase, icon: entry.icon, name: entry.name };
}

function getWeatherPresentation(code, isDay, moonInfo) {
  let icon = "\u2601\uFE0F";
  let label = "Cloudy";

  if (code === 0) {
    icon = isDay ? "\u2600\uFE0F" : moonInfo.icon;
    label = "Clear sky";
  } else if (code === 1) {
    icon = isDay ? "\u{1F324}\uFE0F" : moonInfo.icon;
    label = "Mostly clear";
  } else if (code === 2) {
    icon = "\u26C5";
    label = "Partly cloudy";
  } else if (code === 3) {
    icon = "\u2601\uFE0F";
    label = "Overcast";
  } else if (code <= 48) {
    icon = "\u{1F32B}\uFE0F";
    label = "Foggy";
  } else if (code <= 67) {
    icon = "\u{1F327}\uFE0F";
    label = "Rainy";
  } else if (code <= 77) {
    icon = "\u2744\uFE0F";
    label = "Snow";
  } else if (code >= 95) {
    icon = "\u26C8\uFE0F";
    label = "Thunderstorm";
  }

  return { icon, label };
}

function ensureWeatherScene(widget) {
  if (!widget) return null;
  let scene = widget.querySelector(".aw-weather-scene");
  if (scene) return scene;

  scene = document.createElement("div");
  scene.className = "aw-weather-scene";
  scene.setAttribute("aria-hidden", "true");
  scene.innerHTML = `
    <span class="aw-weather-stars"></span>
    <span class="aw-weather-halo"></span>
    <span class="aw-weather-earth"></span>
    <span class="aw-weather-sun"></span>
    <span class="aw-weather-moon"></span>
  `;
  widget.insertBefore(scene, widget.firstChild);
  return scene;
}

function updateWeatherScene(data) {
  const richW = document.getElementById("richWeatherWidget");
  if (!richW) return;

  const scene = ensureWeatherScene(richW);
  if (!scene) return;

  const now = new Date();
  const hour = now.getHours() + now.getMinutes() / 60 + now.getSeconds() / 3600;
  const isDay = hour >= 6 && hour < 18;
  const rotation = (hour / 24) * 360;
  const temp = Number(data && data.temp);
  const heat = Math.max(0, Math.min(1, ((Number.isFinite(temp) ? temp : 0) - 26) / 12));
  const condition = String((data && data.condLabel) || "");
  const moon = getWeatherMoonPhaseInfo(now);
  const presentation = getWeatherPresentation(Number(data && data.weatherCode) || 0, isDay, moon);
  const cloudiness = /cloud|fog|rain|drizzle|storm|snow/i.test(condition) ? 1 : 0;
  const illumination = moon.phase <= 0.5 ? moon.phase * 2 : (1 - moon.phase) * 2;
  const shadowAmount = Math.max(0, 1 - illumination);
  const shadowOffset = moon.phase < 0.5 ? 18 * shadowAmount : -18 * shadowAmount;

  richW.dataset.weatherMode = isDay ? "day" : "night";
  richW.dataset.weatherHeat = heat > 0.72 ? "hot" : heat > 0.42 ? "warm" : "cool";
  richW.dataset.weatherCondition = condition.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "clear";
  richW.style.setProperty("--aw-earth-image", isDay ? 'url("images/weather-earth-day.svg")' : 'url("images/weather-earth-night.svg")');
  richW.style.setProperty("--aw-sun-image", 'url("images/weather-sun.svg")');
  richW.style.setProperty("--aw-moon-image", 'url("images/weather-moon.svg")');
  richW.style.setProperty("--aw-scene-rotation", `${rotation.toFixed(2)}deg`);
  richW.style.setProperty("--aw-scene-stars-opacity", isDay ? "0.08" : (0.72 + cloudiness * 0.14).toFixed(2));
  richW.style.setProperty("--aw-scene-halo-opacity", isDay ? "0.40" : "0.74");
  richW.style.setProperty("--aw-scene-earth-brightness", isDay ? "1.08" : "0.93");
  richW.style.setProperty("--aw-scene-terminator-opacity", isDay ? "0.34" : "0.92");
  richW.style.setProperty("--aw-scene-sun-opacity", (isDay ? 0.18 + heat * 0.78 : 0.08 + heat * 0.24).toFixed(2));
  richW.style.setProperty("--aw-scene-moon-opacity", isDay ? "0.08" : "0.95");
  richW.style.setProperty("--aw-scene-sun-size", heat > 0.72 ? "142px" : "118px");
  richW.style.setProperty("--aw-scene-moon-size", isDay ? "52px" : "66px");
  richW.style.setProperty("--aw-scene-cloud-opacity", cloudiness ? "0.62" : "0.30");
  richW.style.setProperty("--aw-moon-shadow-opacity", String(Math.max(0.05, shadowAmount)));
  richW.style.setProperty("--aw-moon-shadow-offset", `${shadowOffset.toFixed(1)}px`);

  const sunEl = scene.querySelector(".aw-weather-sun");
  const moonEl = scene.querySelector(".aw-weather-moon");
  const earthEl = scene.querySelector(".aw-weather-earth");
  const timeEl = document.getElementById("awTimeText");
  const iconEl = document.getElementById("awBigIcon");
  const conditionEl = document.getElementById("awConditionText");

  if (sunEl) {
    sunEl.textContent = "";
    sunEl.title = "Sun";
  }
  if (moonEl) {
    moonEl.textContent = "";
    moonEl.title = moon.name;
    moonEl.dataset.phase = moon.name;
  }
  if (earthEl) earthEl.dataset.mode = isDay ? "day" : "night";
  if (timeEl) timeEl.innerText = now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  if (iconEl && data && typeof data.weatherCode !== "undefined") iconEl.innerText = presentation.icon;
  if (conditionEl && data && typeof data.weatherCode !== "undefined") conditionEl.innerText = presentation.label;
}

function startWeatherSceneTicker() {
  if (window._weatherSceneTicker) return;
  window._weatherSceneTicker = window.setInterval(() => {
    if (window._aliveWeatherCurrentData) {
      updateWeatherScene(window._aliveWeatherCurrentData);
    }
  }, 60000);
}

async function fetchLocalWeather(force) {
  const cacheKey = "alive_weather_cache_v3";
  const cachedStr = localStorage.getItem(cacheKey);

  function renderWidget(data) {
     const richW = document.getElementById("richWeatherWidget");
     if (!richW) return;
     richW.style.display = "block";
     
     document.getElementById("awLocationText").innerText = data.city ? `${data.city}, ${data.state}` : "Local Area";
     document.getElementById("awTimeText").innerText = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
     document.getElementById("awBigIcon").innerText = data.icon;
     document.getElementById("awBigTemp").innerText = data.temp;
     document.getElementById("awConditionText").innerText = data.condLabel;
     document.getElementById("awFeelsLike").innerText = data.feels;
     document.getElementById("awDescSentence").innerText = `There will be ${data.condLabel.toLowerCase()} skies. The high will reach ${data.high}° on this ${data.humidity > 60 ? 'humid' : 'pleasant'} day.`;
     
     const vAqi = document.getElementById("awAqiVal");
     if (vAqi) vAqi.innerHTML = `<span class="aw-dot" style="background:${data.aqi<50?'#34C759':data.aqi<100?'#fbbf24':'#FF3B30'};"></span>${data.aqi}`;
     
     document.getElementById("awWindVal").innerText = data.wind + ' km/h';
     document.getElementById("awHumidityVal").innerText = data.humidity + '%';
     document.getElementById("awVisVal").innerText = data.vis + ' km';
     document.getElementById("awPressVal").innerText = data.press + ' mb';
     document.getElementById("awDewVal").innerText = data.dew + '°';
     window._aliveWeatherCurrentData = data;
     updateWeatherScene(data);
     startWeatherSceneTicker();

     // Stop refresh spinner
     const wBtn = document.getElementById('weatherRefreshBtn');
     if (wBtn) wBtn.classList.remove('spinning');
  }

  if (!force && cachedStr) {
    try {
      const cached = JSON.parse(cachedStr);
      if (Date.now() - cached.timestamp < 3600000) { // 1 hr cache
        renderWidget(cached);
        return;
      }
    } catch(e){}
  }

  async function processCoords(lat, lon) {
    try {
      const nomRes = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`);
      const nomData = await nomRes.json();
      const city = nomData.address ? (nomData.address.city || nomData.address.town || nomData.address.village || "") : "";
      const state = nomData.address ? (nomData.address.state || nomData.address.country || "") : "";

      const meteoRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,surface_pressure,wind_speed_10m,visibility,dew_point_2m&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto`);
      const meteoData = await meteoRes.json();
      
      let aqi = "--";
      try {
        const aqiRes = await fetch(`https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=european_aqi`);
        const aqiData = await aqiRes.json();
        aqi = Math.round(aqiData.current.european_aqi) || "--";
      } catch(ex){}

      const current = meteoData.current || {};
      const daily = meteoData.daily || { temperature_2m_max: [0] };
      const temp = Math.round(current.temperature_2m);
      const code = current.weather_code;
      const isDay = !!current.is_day;
      const feels = Math.round(current.apparent_temperature);
      
      function getMoonPhase() {
        const d = new Date(), y = d.getFullYear(), m = d.getMonth() + 1, dy = d.getDate();
        let yy = y, mm = m;
        if (mm < 3) { yy--; mm += 12; }
        let a = Math.floor(yy / 100), b = Math.floor(a / 4), c = 2 - a + b;
        let e = Math.floor(365.25 * (yy + 4716)), f = Math.floor(30.6001 * (mm + 1));
        let jd = c + dy + e + f - 1524.5;
        let phase = ((jd - 2451549.5) / 29.53058867) % 1;
        if (phase < 0) phase += 1;
        if (phase < 0.03 || phase >= 0.97) return "🌑";
        if (phase < 0.22) return "🌒";
        if (phase < 0.28) return "🌓";
        if (phase < 0.47) return "🌔";
        if (phase < 0.53) return "🌕";
        if (phase < 0.72) return "🌖";
        if (phase < 0.78) return "🌗";
        return "🌘";
      }

      let icon = "☁️", condLabel = "Cloudy";
      if (code === 0) { icon = isDay?"☀️":getMoonPhase(); condLabel="Clear sky"; }
      else if (code === 1) { icon = isDay?"🌤️":getMoonPhase(); condLabel="Mostly clear"; }
      else if (code === 2) { icon = "⛅"; condLabel="Partly cloudy"; }
      else if (code === 3) { icon = "☁️"; condLabel="Overcast"; }
      else if (code <= 48) { icon = "🌫️"; condLabel="Foggy"; }
      else if (code <= 67) { icon = "🌧️"; condLabel="Rainy"; }
      else if (code <= 77) { icon = "❄️"; condLabel="Snow"; }
      else if (code >= 95) { icon = "⛈️"; condLabel="Thunderstorm"; }
      else { icon = "☁️"; condLabel="Cloudy"; }

      const moonInfo = getWeatherMoonPhaseInfo();
      const presentation = getWeatherPresentation(code, isDay, moonInfo);
      icon = presentation.icon;
      condLabel = presentation.label;

      const dataObj = {
        city, state, temp, icon, condLabel, feels, aqi,
        high: Math.round(daily.temperature_2m_max[0]),
        humidity: Math.round(current.relative_humidity_2m),
        wind: Math.round(current.wind_speed_10m),
        vis: Math.round(current.visibility / 1000),
        press: Math.round(current.surface_pressure),
        dew: Math.round(current.dew_point_2m),
        weatherCode: code,
        isDay,
        moonIcon: moonInfo.icon,
        moonPhase: moonInfo.name,
        timestamp: Date.now()
      };

      localStorage.setItem(cacheKey, JSON.stringify(dataObj));
      renderWidget(dataObj);

    } catch (e) {
      console.warn("Weather fetch error", e);
    }
  }

  try {
    if (window.CapacitorGeolocation && window.Capacitor?.isNativePlatform?.()) {
      try { await window.CapacitorGeolocation.requestPermissions(); } catch(e){}
      const pos = await window.CapacitorGeolocation.getCurrentPosition({ timeout: 10000, enableHighAccuracy: true });
      await processCoords(pos.coords.latitude, pos.coords.longitude);
    } else if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        async (pos) => await processCoords(pos.coords.latitude, pos.coords.longitude),
        (err) => console.warn("Geolocation denied or error", err)
      );
    }
  } catch (err) {
    console.warn("Geolocation error", err);
  }
}

// ─── HOME NEWS — Ultra-resilient headline fetcher with caching ────────
// Strategy: Timeout-wrapped fetches → localStorage cache fallback.
// Every fetch has an 8s timeout to prevent hanging in WebViews.

const _NEWS_CACHE_KEY = 'alive_news_cache_v2';

function _fetchWithTimeout(url, opts = {}, ms = 8000) {
  const ctrl = new AbortController();
  const tid = setTimeout(() => ctrl.abort(), ms);
  return fetch(url, { ...opts, signal: ctrl.signal }).finally(() => clearTimeout(tid));
}

async function _fetchHackerNews() {
  const r = await _fetchWithTimeout('https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=8');
  if (!r.ok) throw new Error('HN API ' + r.status);
  const d = await r.json();
  return (d.hits || []).filter(h => h.title).map(h => ({
    title:  h.title,
    link:   h.url || `https://news.ycombinator.com/item?id=${h.objectID}`,
    pubDate: h.created_at || '',
    source: 'Hacker News',
    color:  '#FF6600',
  }));
}

async function _fetchDevTo() {
  const r = await _fetchWithTimeout('https://dev.to/api/articles?per_page=8&top=1');
  if (!r.ok) throw new Error('Dev.to ' + r.status);
  const d = await r.json();
  return (d || []).filter(a => a.title).map(a => ({
    title:  a.title,
    link:   a.url || '',
    pubDate: a.published_at || '',
    source: 'Dev.to',
    color:  '#3B49DF',
  }));
}

async function _fetchRedditTech() {
  // Reddit JSON API — CORS-friendly, no proxy needed
  const r = await _fetchWithTimeout('https://www.reddit.com/r/technology/hot.json?limit=8');
  if (!r.ok) throw new Error('Reddit ' + r.status);
  const d = await r.json();
  return (d?.data?.children || []).filter(c => c.data && c.data.title && !c.data.stickied).map(c => ({
    title:  c.data.title,
    link:   c.data.url || `https://reddit.com${c.data.permalink}`,
    pubDate: new Date(c.data.created_utc * 1000).toISOString(),
    source: 'Reddit Tech',
    color:  '#FF4500',
  }));
}

async function _fetchProductHunt() {
  // Product Hunt website endpoint — sometimes works
  try {
    const r = await _fetchWithTimeout('https://www.producthunt.com/frontend/graphql', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: '{ posts(first:6) { edges { node { name tagline url votesCount } } } }' }),
    }, 6000);
    if (!r.ok) return [];
