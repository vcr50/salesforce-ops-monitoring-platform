// ─── HELPERS ──────────────────────────────────
function getDayDate(d) {
  const dt = new Date(START_DATE);
  dt.setDate(dt.getDate() + d - 1);
  return dt;
}
function formatDate(d) {
  return d.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    weekday: "short",
  });
}
function getTodayDayNum() {
  if (!START_DATE) return null;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const start = new Date(START_DATE);
  start.setHours(0, 0, 0, 0);
  const diff = Math.floor((today - start) / 86400000) + 1;
  return diff < 1 || diff > TOTAL_DAYS ? null : diff;
}
function getPhaseForDay(d) {
  const nameLower = (state && state.name) ? state.name.toLowerCase() : "";
  const isSfdc = nameLower.includes("salesforce") || nameLower.includes("sfdc") || nameLower.includes("trail");
  
  if (state && state.phasesList && state.phasesList.length > 0) {
    return (
      state.phasesList.find((p) => d >= p.dayStart && d <= p.dayEnd) ||
      state.phasesList[state.phasesList.length - 1]
    );
  }
  
  if (isSfdc) {
    return (
      PHASES.find((p) => d >= p.dayStart && d <= p.dayEnd) ||
      PHASES[PHASES.length - 1]
    );
  }
  
  // Generic fallback for generic empty journeys
  return { name: "Journey Context", color: "#64748b" };
}
function getWeekForDay(d) {
  return Math.ceil(d / 7);
}
function totalWeeks() {
  return Math.ceil(TOTAL_DAYS / 7);
}

// ─── SAVE / LOAD ──────────────────────────────
async function saveState() {
  if (globalState) {
    if (state && state.id === currentJourneyId) {
      globalState.journeys[currentJourneyId] = state;
    }
    globalState.currentJourneyId = currentJourneyId;
    // Always save to localStorage as offline fallback
    localStorage.setItem(STORAGE_KEY, JSON.stringify(globalState));
    window._lastLocalSaveTime = Date.now(); // Used by real-time sync to avoid echo
    // Silently save to Firestore in background — no toast interruption
    if (window.fbSave) {
      await window.fbSave(globalState).catch(e => console.warn('Firestore save failed:', e));
    }
    return true;
  }
  return false;
}

// ─── GAMIFICATION (XP & LEVELS) ────────────────────
const RANKS = [
  { name: "Trainee", minXP: 0, icon: "🌱" },
  { name: "Ranger", minXP: 500, icon: "🦊" },
  { name: "Expeditioner", minXP: 1500, icon: "🧭" },
  { name: "Trailblazer", minXP: 3000, icon: "🧗" },
  { name: "Master", minXP: 5000, icon: "🧙" },
];

function getRank(xp) {
  let currentRank = RANKS[0];
  let nextRank = RANKS[1];
  for (let i = 0; i < RANKS.length; i++) {
    if (xp >= RANKS[i].minXP) {
      currentRank = RANKS[i];
      nextRank = RANKS[i + 1] || null;
    }
  }
  return { currentRank, nextRank };
}

function updateXPBadge() {
  if (!state || state.xp === undefined) return;
  const { currentRank, nextRank } = getRank(state.xp);

  const iconEl = document.getElementById("xpRankIcon");
  const nameEl = document.getElementById("xpRankName");
  const ptsEl = document.getElementById("xpPointsText");
  const fillEl = document.getElementById("xpProgressFill");

  if (iconEl) iconEl.textContent = currentRank.icon;
  if (nameEl) nameEl.textContent = currentRank.name;
  if (ptsEl) ptsEl.textContent = state.xp + " XP";

  if (fillEl) {
    if (!nextRank) {
      fillEl.style.width = "100%";
    } else {
      const xpInLevel = state.xp - currentRank.minXP;
      const levelRange = nextRank.minXP - currentRank.minXP;
      const pct = Math.min(100, Math.max(0, (xpInLevel / levelRange) * 100));
      fillEl.style.width = pct + "%";
    }
  }
}

function addXP(amount, reason = "") {
  if (!state) return;
  if (state.xp === undefined) state.xp = 0;

  const oldRank = getRank(state.xp).currentRank;
  state.xp += amount;
  const newRank = getRank(state.xp).currentRank;

  // Visual text toast
  const toast = document.createElement("div");
  toast.className = "xp-toast";
  toast.innerText = `+${amount} XP ✨`;
  toast.style.left = `${Math.random() * 20 + 40}vw`;
  toast.style.top = "50vh";
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 2000);

  // Level Up Confetti check
  if (newRank.minXP > oldRank.minXP) {
    const confetti = document.createElement("div");
    confetti.className = "level-up-confetti";
    document.body.appendChild(confetti);
    const msg = `🎉 LEVEL UP! You are now a ${newRank.name} ${newRank.icon}`;
    showToast(msg);
    setTimeout(() => confetti.remove(), 3500);
    
    // Send Telegram Notification
    sendTelegramMsg(`🚀 *LEVEL UP!*\n🌟 New Rank: *${newRank.name}* ${newRank.icon}\n✨ Total XP: ${state.xp}`);
  }

  updateXPBadge();
  saveState();
}

// Called by firebase-config.js when user logs in — replaces state with cloud data
window.applyCloudState = function (cloudState) {
  if (!cloudState) return;

  // ── RACE CONDITION LOCK ──
  // If we just deleted a journey, ignore incoming cloud state for 10 seconds
  // to allow the deletion to propagate through Firestore's event system.
  const deleteLockTime = sessionStorage.getItem('tcx_delete_lock');
  if (deleteLockTime && Date.now() - parseInt(deleteLockTime) < 10000) {
    console.log('📡 Sync Lock Active: Ignoring old cloud state during deletion propagation.');
    return;
  }

  globalState = cloudState;
  if (globalState.autoPushAgenda === undefined) globalState.autoPushAgenda = true;
  if (!globalState.lastPushDate) globalState.lastPushDate = '';

  // Automatically repair any missing IDs or duplicate short-IDs injected during testing
  if (globalState.journeys) {
    repairGlobalState();
  }

  // Set pointers to the freshly repaired state
  currentJourneyId =
    globalState.currentJourneyId ||
    Object.keys(globalState.journeys)[0] ||
    "sfdc";
  applyJourney(currentJourneyId);

  // Merge default flashcards into cloud state (cloud may have old/fewer cards)
  if (state.flashcards && typeof FC_DEFAULTS !== "undefined") {
    const existingQs = new Set(state.flashcards.map((c) => c.q));
    let added = 0;
    FC_DEFAULTS.forEach((def) => {
      if (!existingQs.has(def.q)) {
        state.flashcards.push({ ...def });
        added++;
      }
    });
    if (added > 0) {
      saveState(); // Persists merged cards to cloud + localStorage
    }
  }
  localStorage.setItem(STORAGE_KEY, JSON.stringify(globalState));

  // Rebuild the UI so that any newly synced journeys appear immediately
  if (typeof updateJourneyHeader === "function") updateJourneyHeader();
  if (typeof updateOverview === "function") updateOverview();
  if (typeof buildPhasePlan === "function") buildPhasePlan();
  if (typeof buildDailyTable === "function") buildDailyTable();
  if (typeof initNotes === "function") initNotes();
  if (typeof renderTrailheadProfile === "function") renderTrailheadProfile();
  if (typeof initTrailhead === "function") initTrailhead();
  if (typeof initTodos === "function") initTodos();
  // Calendar setup (moved to main init)
  if (typeof initProjects === "function") initProjects();

  // Re-render Analytics chart
  if (typeof initAnalytics === "function") initAnalytics();
  if (typeof renderResources === "function") renderResources();
  if (typeof renderCertTrack === "function") renderCertTrack();
  if (typeof renderCustomLinks === "function") renderCustomLinks();
  if (typeof window.renderTgUI === "function") window.renderTgUI();
  if (typeof renderFlashcards === "function") renderFlashcards();

  // Show sign-out button, hide login btn
  const so = document.getElementById("fbSignOutBtn");
  if (so) so.style.display = "inline";
  const li = document.getElementById("fbLoginBtn");
  if (li) li.style.display = "none";

  // Auto-sync Google Tasks silently after login
  if (localStorage.getItem("gcalToken")) {
    setTimeout(async () => {
      try {
        const importedCount = await syncAllTasks();
        if (importedCount > 0)
          showToast(`${importedCount} Google Tasks imported! ✅`);
      } catch (e) {
        console.warn("Auto Google Tasks sync failed:", e);
      }
      
      // Auto-sync Google Fit
      if (typeof window.refreshFitData === "function") {
        window.refreshFitData();
      }
    }, 1500);
  }
};

