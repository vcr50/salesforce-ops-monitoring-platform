function initQuote() {
  const today = new Date().toDateString();
  
  const GENERIC_QUOTES = [
    "Consistency is the key to mastery. Keep showing up.",
    "Every expert was once a beginner. Keep pushing.",
    "Small daily progress yields massive long-term results.",
    "Focus on the process, not just the output.",
    "The only bad practice session is the one that didn't happen."
  ];
  
  const nameLower = (state && state.name) ? state.name.toLowerCase() : "";
  const isSfdc = nameLower.includes("salesforce") || nameLower.includes("sfdc") || nameLower.includes("trail");

  let quoteArray = QUOTES; // default to original SFDC quotes
  
  if (state && state.quotes && state.quotes.length > 0) {
    quoteArray = state.quotes;
  } else if (!isSfdc) {
    quoteArray = GENERIC_QUOTES;
  }

  if (state.lastQuoteDate !== today) {
    state.quoteIndex = Math.floor(Math.random() * quoteArray.length);
    state.lastQuoteDate = today;
  }

  // Failsafe if index is out of bounds
  if (state.quoteIndex >= quoteArray.length) {
    state.quoteIndex = 0;
  }

  const quoteEl = document.getElementById("quoteText");
  if (quoteEl) quoteEl.textContent = quoteArray[state.quoteIndex];
}

// ─── STREAK CALCULATOR ────────────────────────
function calcStreak() {
  const todayNum = getTodayDayNum();
  if (!todayNum) return { current: 0, best: 0 };
  let current = 0,
    best = 0,
    temp = 0;
  for (let d = 1; d <= TOTAL_DAYS; d++) {
    const entry = state.days[d] || {};
    const completed = entry.completed || parseFloat(entry.hours || 0) > 0;
    if (completed) {
      temp++;
      if (temp > best) best = temp;
      if (d <= todayNum) current = temp; // approximate: resets on gap
    } else {
      if (d < todayNum) {
        temp = 0;
        current = 0;
      }
    }
  }
  return { current, best };
}

// ─── NAVIGATION ───────────────────────────────
function initNav() {
  const sidebar = document.getElementById("sidebar");
  const hamburger = document.getElementById("hamburger");
  const backdrop = document.getElementById("sidebarBackdrop");

  function openSidebar() {
    sidebar.classList.add("open");
    backdrop?.classList.add("visible");
  }
  function closeSidebar() {
    sidebar.classList.remove("open");
    backdrop?.classList.remove("visible");
  }

  hamburger?.addEventListener("click", () =>
    sidebar.classList.contains("open") ? closeSidebar() : openSidebar(),
  );
  backdrop?.addEventListener("click", closeSidebar);

  let isAnimating = false; // Prevent rapid double-clicks during transition

  function switchSection(sec, skipNavPush) {
    if (isAnimating) return;

    const currentSection = document.querySelector(".section.active");
    const nextSection = document.getElementById(sec);

    // Skip animation if clicking the same tab
    if (currentSection && currentSection.id === sec) return;

    // Update sidebar active state immediately (feels snappy)
    document
      .querySelectorAll(".nav-item")
      .forEach((n) => n.classList.remove("active"));
    document
      .querySelector(`.nav-item[data-section="${sec}"]`)
      ?.classList.add("active");
    // Sync bottom nav
    document
      .querySelectorAll(".mob-nav-btn")
      .forEach((b) => b.classList.remove("active"));
    document
      .querySelector(`.mob-nav-btn[data-section="${sec}"]`)
      ?.classList.add("active");
    closeSidebar();

    // Track in navigation stack for back button support
    if (!skipNavPush) {
      navPush('journey:' + sec);
    }

    if (state) {
      state.activeSection = sec;
    }

    // ── PHASE 1: Fade out old section ──
    if (currentSection) {
      isAnimating = true;
      currentSection.classList.remove("section-visible");
      currentSection.classList.add("section-exiting");

      // After fade-out completes (200ms), swap sections
      setTimeout(() => {
        currentSection.classList.remove("active", "section-exiting");
        currentSection.style.display = "none"; // Ensure it's hidden

        // ── PHASE 2: Fade in new section ──
        if (nextSection) {
          nextSection.style.display = "block";
          nextSection.classList.add("active");
          // Force browser reflow so transition triggers properly
          void nextSection.offsetHeight;
          nextSection.classList.add("section-visible");
        }

        isAnimating = false;
        if (sec === "overview") { buildTodoTicker(); setTimeout(drawChart, 60); }
        if (sec === "liferoutine") initLifeTracker();
        if (typeof updateJourneyHeader === "function") updateJourneyHeader();
        
        // AUTO-SCROLL TO TODAY
        if (sec === "daily") {
          setTimeout(window.scrollToToday, 400);
        }
      }, 200);
    } else {
      // No current section (first load) — just show it
      if (nextSection) {
        nextSection.style.display = "block";
        nextSection.classList.add("active");
        void nextSection.offsetHeight;
        nextSection.classList.add("section-visible");
      }
      if (sec === "overview") { buildTodoTicker(); setTimeout(drawChart, 60); }
      if (sec === "liferoutine") initLifeTracker();
      if (typeof updateJourneyHeader === "function") updateJourneyHeader();
    }
  }

  // Expose globally so enterJourney() and other external callers can use it
  window.switchSection = switchSection;

  document.querySelectorAll(".nav-item").forEach((item) => {
    item.addEventListener("click", (e) => {
      e.preventDefault();
      switchSection(item.dataset.section);
    });
  });

  // Bottom nav bar (Android-style, Redesigned)
  document.querySelectorAll(".mob-nav-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      // Handle "More" menu button
      if (btn.id === 'moreMenuBtn') {
        toggleMoreSheet();
        return;
      }
      // Handle "Home" button
      if (btn.dataset.home === 'true') {
        if (typeof openAliveNowHome === 'function') openAliveNowHome();
        // Sync active states
        document.querySelectorAll(".mob-nav-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        return;
      }
      switchSection(btn.dataset.section);
    });
  });

  // More Sheet (Bottom Sheet) logic
  const moreSheet = document.getElementById('moreSheet');
  const moreBackdrop = document.getElementById('moreSheetBackdrop');
  
  function toggleMoreSheet() {
    if (!moreSheet) return;
    const isOpen = moreSheet.classList.contains('open');
    if (isOpen) {
      closeMoreSheet();
    } else {
      moreSheet.classList.add('open');
      moreBackdrop?.classList.add('visible');
    }
  }
  
  function closeMoreSheet() {
    moreSheet?.classList.remove('open');
    moreBackdrop?.classList.remove('visible');
  }
  
  // Close on backdrop click
  moreBackdrop?.addEventListener('click', closeMoreSheet);
  
  // More sheet items navigate to section
  document.querySelectorAll('.more-sheet-item').forEach(item => {
    item.addEventListener('click', () => {
      const sec = item.dataset.section;
      if (sec) {
        switchSection(sec);
        closeMoreSheet();
        // Update bottom nav active states
        document.querySelectorAll(".mob-nav-btn").forEach(b => b.classList.remove("active"));
      }
    });
  });
  
  // Expose closeMoreSheet for back button handler
  window.closeMoreSheet = closeMoreSheet;

  // ─── BACK BUTTON HANDLER (Web + Android) ────────────────
  function handleBackNavigation() {
    // 0. Close More sheet if open
    const moreSheetEl = document.getElementById('moreSheet');
    if (moreSheetEl && moreSheetEl.classList.contains('open')) {
      if (typeof window.closeMoreSheet === 'function') window.closeMoreSheet();
      return true;
    }

    // 1. Close any open modal first
    const openModal = document.querySelector('.modal-overlay.open');
    if (openModal) {
      openModal.classList.remove('open');
      return true; // consumed
    }

    // 2. Close sidebar if open
    if (sidebar && sidebar.classList.contains('open')) {
      closeSidebar();
      return true;
    }

    // 3. Close journey dropdown if open
    const dropdown = document.getElementById('journeyDropdown');
    if (dropdown && dropdown.classList.contains('open')) {
      dropdown.classList.remove('open');
      return true;
    }

    // 4. Close AI Coach widget if open
    const aiWidget = document.getElementById('aiCoachWidget');
    if (aiWidget && aiWidget.classList.contains('open')) {
      aiWidget.classList.remove('open');
      return true;
    }

    // 5. Navigate back through the app's view hierarchy
    const current = navCurrent();

    if (current.startsWith('journey:')) {
      // On a tab inside a journey → go back to journey overview
      const tab = current.split(':')[1];
      if (tab !== 'overview') {
        navPop();
        switchSection('overview', true); // skipNavPush = true
        return true;
      }
      // Already on overview tab → go to home
      navPop();
      openAliveNowHome(true);
      return true;
    }

    if (current === 'journey') {
      // Journey root → go home
      navPop();
      openAliveNowHome(true);
      return true;
    }

    // Already at home → let the system handle it (minimize app or exit)
    return false;
  }

  // Browser back button (popstate)
  window.addEventListener('popstate', (e) => {
    if (_navHandlingPopstate) return;
    _navHandlingPopstate = true;
    const consumed = handleBackNavigation();
    if (!consumed) {
      // At root home: push a dummy state so next back press also gets caught
      // On web, this prevents accidentally leaving the page
      try { history.pushState({ tcxView: 'home' }, '', ''); } catch(ex) {}
    }
    _navHandlingPopstate = false;
  });

  // Seed the initial history entry so popstate always fires
  try { history.replaceState({ tcxView: 'home' }, '', ''); } catch(e) {}

  // Capacitor Android hardware back button
  function registerCapacitorBackButton() {
    const capApp = window.CapacitorApp;
    if (capApp && typeof capApp.addListener === 'function') {
      capApp.addListener('backButton', (ev) => {
        const consumed = handleBackNavigation();
        if (!consumed) {
          // At true home → minimize the app instead of killing it
          if (ev.canGoBack === false || _navStack.length <= 1) {
            capApp.minimizeApp();
          }
        }
      });
      console.log('✅ Capacitor backButton listener registered');
    }
  }
  // Try immediately, and retry after Capacitor plugins load
  registerCapacitorBackButton();
  setTimeout(registerCapacitorBackButton, 2000);

  // Expose for external callers
window.handleBackNavigation = handleBackNavigation;
}

// ─── NEON GLOW PROXIMITY EFFECT ───
document.addEventListener('mousemove', (e) => {
  if (!document.body.classList.contains('home-mode')) return;
  
  const cards = document.querySelectorAll('.alive-journey-card, .alive-add-card, .aw-container, .an-news-container, .an-mini-stats, .an-insight-card');
  const mouseX = e.clientX;
  const mouseY = e.clientY;
  
  cards.forEach(card => {
    const rect = card.getBoundingClientRect();
    const cardCenterX = rect.left + rect.width / 2;
    const cardCenterY = rect.top + rect.height / 2;
    
    // Calculate distance from mouse to card center
    const distX = mouseX - cardCenterX;
    const distY = mouseY - cardCenterY;
    const distance = Math.sqrt(distX * distX + distY * distY);
    
    // If mouse is within 300px, calculate angle for the gradient and activate glow
    if (distance < 300) {
      // Calculate angle in degrees
      let angle = Math.atan2(distY, distX) * (180 / Math.PI) + 90;
      card.style.setProperty('--glow-angle', angle + 'deg');
      card.classList.add('neon-active');
    } else {
      card.classList.remove('neon-active');
    }
  });
});

