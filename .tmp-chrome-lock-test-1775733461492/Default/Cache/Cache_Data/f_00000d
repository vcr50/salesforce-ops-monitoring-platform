function renderFlashcards() {
  const grid = document.getElementById("fcGrid");
  const now = Date.now();
  let cards =
    fcFilter === "all"
      ? state.flashcards
      : state.flashcards.filter((c) => c.cat === fcFilter);

  // Sort: Due first, then New, then Future Review
  cards.sort((a, b) => (a.nextReviewDate || 0) - (b.nextReviewDate || 0));

  if (!cards.length) {
    grid.innerHTML =
      '<div class="fc-empty">No flashcards yet. Click "+ Add Card" to create one!</div>';
    return;
  }
  grid.innerHTML = cards
    .map((card, i) => {
      const realIdx = state.flashcards.indexOf(card);
      const isDue = !card.nextReviewDate || card.nextReviewDate <= now;

      const statusText = isDue
        ? "🔴 Due Now"
        : `🟢 Due: ${new Date(card.nextReviewDate).toLocaleDateString()}`;
      const statusColor = isDue ? "var(--red)" : "var(--green)";
      const pointerEvents = isDue ? "auto" : "none"; // Prevent SRS on non-due cards
      const opacity = isDue ? "1" : "0.5";

      return `
    <div class="fc-card-wrap" onclick="this.classList.toggle('flipped')">
      <div class="fc-card">
        <div class="fc-card-front">
          <div>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px">
