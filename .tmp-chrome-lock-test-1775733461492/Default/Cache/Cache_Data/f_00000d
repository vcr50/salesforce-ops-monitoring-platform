function applyJourney(id) {
  if (!globalState.journeys[id]) return;
  currentJourneyId = id;
  state = globalState.journeys[id];
  if ((state.id === "sfdc" || id === "sfdc") && state.name !== "SFDC") {
    state.name = "SFDC";
  }
  state.darkMode = globalState.darkMode;
  state.lastQuoteDate = globalState.lastQuoteDate;
  state.quoteIndex = globalState.quoteIndex;

  TOTAL_DAYS = state.totalDays || 55;
  START_DATE = new Date(state.startDate || "2026-03-23");

  // 1. Identify Journey Template using Keywords
  const nameLower = (state.name || "").toLowerCase();
  let activeTemplate =
    JOURNEY_TEMPLATES.find((t) =>
      t.keywords.some((k) => nameLower.includes(k)),
    ) || JOURNEY_TEMPLATES.find((t) => t.type === "default");

  // 1.5 Dynamic Tab Override (if AI generated content exists, force show its tab)
  const allowedTabs = new Set(activeTemplate.tabs);
  if (state.phasesList && state.phasesList.length > 0) allowedTabs.add("phases");
  if (state.projects && state.projects.length > 0) allowedTabs.add("project");

  // 2. Toggle Tab Visibility dynamically
  let activeTabHidden = false;

  document.querySelectorAll(".nav-item").forEach((nav) => {
    // Only target sidebar tabs
    const section = nav.dataset.section;
    if (!section) return;

    if (allowedTabs.has(section)) {
      nav.style.display = "flex"; // Re-show tab
    } else {
      nav.style.display = "none"; // Hide tab
      if (nav.classList.contains("active")) {
        activeTabHidden = true; // Flag if currently active
      }
    }
  });

  // Redirect if they were on a tab that is now hidden for this journey
  if (activeTabHidden) {
    document.querySelector('.nav-item[data-section="overview"]')?.click();
  }

  // 3. Toggle Dashboard Widgets to reduce clutter for non-SFDC setups
  // Reset visibility first to handle clean swapping between journey templates
  document
    .querySelectorAll(
      ".exam-card, .analytics-grid, #phaseOverviewGrid, h3.sub-title",
    )
    .forEach((el) => {
      if (el) el.style.display = "";
    });

  if (activeTemplate.hideWidgets) {
    activeTemplate.hideWidgets.forEach((selector) => {
      // Dynamic override: If we have auto-generated phases, don't hide the phase grid!
      if (selector === "#phaseOverviewGrid" && state.phasesList && state.phasesList.length > 0) return;
      document.querySelectorAll(selector).forEach((el) => {
        if (el) el.style.display = "none";
      });
    });
    
    const hidesPhases = activeTemplate.hideWidgets.includes("#phaseOverviewGrid") && !(state.phasesList && state.phasesList.length > 0);
    // Quality of life: If hiding Phase Overview grid, hide its orphaned section title too
    if (hidesPhases) {
      document.querySelectorAll("h3.sub-title").forEach((h3) => {
        if (h3.innerText.includes("Phase Progress")) h3.style.display = "none";
      });
    }
  }

  // Immediately apply the Gamification visual state
  if (typeof updateXPBadge === "function") updateXPBadge();
  if (typeof updateJourneyHeader === "function") updateJourneyHeader();
}

function deepMerge(target, source) {
  const out = { ...target };
  for (const key in source) {
    if (
      source[key] &&
      typeof source[key] === "object" &&
      !Array.isArray(source[key])
    ) {
      out[key] = deepMerge(target[key] || {}, source[key]);
    } else {
      out[key] = source[key];
    }
  }
  return out;
}

