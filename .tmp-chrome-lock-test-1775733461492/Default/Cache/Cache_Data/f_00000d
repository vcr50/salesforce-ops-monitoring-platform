function buildJourneyDropdown() {
  const container = document.getElementById("journeyListContainer");
  if (!container) return;
  container.innerHTML = "";

  const journeyKeys = Object.keys(globalState.journeys);
  const isOnlyJourney = journeyKeys.length <= 1;

  Object.entries(globalState.journeys).forEach(([journeyKey, j]) => {
    const wrap = document.createElement("div");
    wrap.style.display = "flex";
    wrap.style.alignItems = "center";

    const btn = document.createElement("button");
    btn.className = `journey-option ${journeyKey === currentJourneyId ? "active" : ""}`;
    btn.innerHTML = `<span>${j.icon || "🚀"}</span> <span>${j.name}</span>`;
    btn.style.flexGrow = "1";
    btn.style.textAlign = "left";
    btn.onclick = async () => {
      const mainContent = document.querySelector(".main-content");
      const dropdown = document.getElementById("journeyDropdown");
      if (dropdown) dropdown.classList.remove("open");

      // ── PHASE 1: Fade out entire dashboard ──
      if (mainContent) {
        mainContent.style.transition =
          "opacity 0.3s ease-out, transform 0.3s ease-out";
        mainContent.style.opacity = "0";
        mainContent.style.transform = "scale(0.98) translateY(8px)";
      }

      await new Promise((r) => setTimeout(r, 300));

      // ── PHASE 2: Swap journey data & rebuild UI ──
      try {
        applyJourney(journeyKey);
        globalState.currentJourneyId = journeyKey;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(globalState));

        // Rebuild all UI sections for the new journey
        if (typeof updateJourneyHeader === "function") updateJourneyHeader();
        if (typeof updateOverview === "function") updateOverview();
        if (typeof buildPhasePlan === "function") buildPhasePlan();
        if (typeof buildDailyTable === "function") buildDailyTable();
        if (typeof renderFlashcards === "function") renderFlashcards();
        if (typeof initNotes === "function") initNotes();
        if (typeof renderResources === "function") renderResources();
        if (typeof renderCertTrack === "function") renderCertTrack();
        if (typeof renderCustomLinks === "function") renderCustomLinks();
        if (typeof initAnalytics === "function") initAnalytics();
        if (typeof initWeeklyReview === "function") initWeeklyReview();
        if (typeof initTrailhead === "function") initTrailhead();
        if (typeof renderTrailheadProfile === "function") renderTrailheadProfile();
        if (typeof initProjects === "function") initProjects();
        if (typeof initTodos === "function") initTodos();

        // Ensure the current visible section has the section-visible class
        const activeSection = document.querySelector(".section.active");
        if (activeSection) activeSection.classList.add("section-visible");

        // Cloud sync in background (non-blocking)
        if (window.fbSave) window.fbSave(globalState);

        showToast(`Switched to ${j.name} ✨`);
        
        // Refresh the dropdown to ensure correct .active state visibility
        buildJourneyDropdown();
      } catch (err) {
        console.error("Error switching journeys:", err);
        alert("CRASH BUG CAUGHT!\n\nPlease take a screenshot of this:\n\n" + (err.stack || err));
      } finally {
        // ── PHASE 3: Fade in fresh dashboard ──
        // Execute even if rebuild crashed
        if (mainContent) {
          mainContent.style.transition =
            "opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
          mainContent.style.opacity = "1";
          mainContent.style.transform = "scale(1) translateY(0)";
        }
      }
    };
    wrap.appendChild(btn);

    // ── Edit Button (always visible) ──
    const editBtn = document.createElement("button");
    editBtn.innerHTML = "✏️";
    editBtn.style.cssText = "background:transparent;border:none;cursor:pointer;padding:8px 6px;font-size:13px;opacity:0.8;flex-shrink:0;";
    editBtn.title = "Edit Journey";
    editBtn.onclick = (e) => {
      e.stopPropagation();
      const dropdown = document.getElementById("journeyDropdown");
      if (dropdown) dropdown.classList.remove("open");
      openEditJourneyModal(journeyKey);
    };
    wrap.appendChild(editBtn);

    // ── Delete Button (only when more than 1 journey exists) ──
    if (!isOnlyJourney) {
      const delBtn = document.createElement("button");
      delBtn.innerHTML = "🗑️";
      delBtn.style.cssText = "background:transparent;border:none;cursor:pointer;padding:8px 6px;font-size:13px;opacity:0.8;flex-shrink:0;";
      delBtn.title = "Delete Journey";

      delBtn.onclick = async (e) => {
        e.stopPropagation();
        if (confirm(`Are you sure you want to delete "${j.name}"? This cannot be undone.`)) {
          delBtn.innerHTML = "⏳";
          
          // SET SYNC LOCK
          sessionStorage.setItem('tcx_delete_lock', Date.now().toString());
          
          let wasActive = (currentJourneyId === journeyKey);
          delete globalState.journeys[journeyKey];
          
          if (wasActive) {
            currentJourneyId = Object.keys(globalState.journeys)[0] || null;
            globalState.currentJourneyId = currentJourneyId;
            state = currentJourneyId ? globalState.journeys[currentJourneyId] : null;
          }
          
          await saveState(); // Local
          
          if (wasActive && currentJourneyId) {
            if (window.enterJourney) window.enterJourney(currentJourneyId);
          } else if (!wasActive) {
            buildJourneyDropdown();
            if (typeof buildAliveNowHome === "function") buildAliveNowHome();
            if (typeof showToast === "function") showToast("Journey deleted.");
            const dropdown = document.getElementById("journeyDropdown");
            if (dropdown) dropdown.classList.remove("open");
          } else {
            location.reload();
          }
        }
      };
      wrap.appendChild(delBtn);
    }

    container.appendChild(wrap);
  });
}

