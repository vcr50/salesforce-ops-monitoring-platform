  if (currHour >= 5 && currHour < 8) timeClass = "time-dawn";
  else if (currHour >= 8 && currHour < 17) timeClass = "time-day";
  else if (currHour >= 17 && currHour < 20) timeClass = "time-dusk";
  
  if (document.body.classList.contains("home-mode")) {
    document.body.classList.remove("time-dawn", "time-day", "time-dusk", "time-night");
    document.body.classList.add(timeClass);
  }

  // --- Dynamic Quote & Local Weather ---
  if (!window._aliveQuoteFetched) {
    window._aliveQuoteFetched = true;
    fetchDynamicQuote();
  }
  if (!window._aliveWeatherFetched) {
    window._aliveWeatherFetched = true;
    fetchLocalWeather();
  }
  if (!window._aliveNewsFetched) {
    window._aliveNewsFetched = true;
    fetchHeadlines();
    setInterval(fetchHeadlines, 5 * 60 * 1000); // Auto-sync every 5 min
  }
  
  // --- Google Fit & Water ---
  if (!window._aliveHealthInited) {
    window._aliveHealthInited = true;
    window.refreshFitData();
    window.renderWaterTracker();
  }
  
  // Calculate Totals Across All Journeys
  let totalLifeHours = 0;
  let totalHoursToday = 0;
  let overallBestStreak = 0;
  let totalExpectedHours = 0;
  let totalCompletedDays = 0;
  const todayDateObj = new Date();
  const weekAgoObj = new Date(todayDateObj);
  weekAgoObj.setDate(weekAgoObj.getDate() - 7);
  let lastWeekHours = 0;
  let thisWeekHours = 0;
  
  let cardsHtml = "";
  let journeyStats = [];
  let focusHtml = "";
  
  // For projection, we track the most active journey
  let topJourneyForProjection = null;
  let topJourneyHours = -1;
  
  if (globalState && globalState.journeys) {
    Object.entries(globalState.journeys).forEach(([jKey, jn]) => {
      let thisJHours = 0;
      let jBestStreak = 0;
      let jCompletedDays = 0;
      const jTotalDays = jn.totalDays || 55;
      
      let jTodayHours = 0;
      // Find today's specific day in this journey
      const startD = new Date(jn.startDate || "2026-03-23");
      const diffTime = todayDateObj.getTime() - startD.getTime();
      let todayDayNumber = Math.floor(diffTime / (1000 * 3600 * 24)) + 1;
      if (todayDayNumber < 1) todayDayNumber = null;
      if (todayDayNumber > jTotalDays) todayDayNumber = null;
      
      if (jn.days) {
        Object.values(jn.days).forEach(d => {
          const h = parseFloat(d.hours || 0);
          thisJHours += h;
          if (d.completed) jCompletedDays++;
          
          if (d.date) {
            const entryDate = new Date(d.date);
            if (entryDate >= weekAgoObj) thisWeekHours += h;
            else if (entryDate >= new Date(weekAgoObj.getTime() - 7*24*60*60*1000)) lastWeekHours += h;
          }
        });
        if (todayDayNumber && jn.days[todayDayNumber]) {
          jTodayHours = parseFloat(jn.days[todayDayNumber].hours || 0);
        }
      }
      
      // Rough streak calculation: max continuous completions (simplification for home page)
      jBestStreak = jCompletedDays; // Placeholder for visual, full calc logic factor is in command-mode
      
      totalLifeHours += thisJHours;
      totalHoursToday += jTodayHours;
      totalCompletedDays += jCompletedDays;
      if (jBestStreak > overallBestStreak) overallBestStreak = jBestStreak;
      
      const pct = Math.min(100, Math.round((jCompletedDays / jTotalDays) * 100));
      
      // Append for Time Dist
      if (thisJHours > 0) {
        const colors = ["#0176D3", "#FF6B35", "#8B5CF6", "#F59E0B", "#2DCB67"];
        journeyStats.push({ name: jn.name, hours: thisJHours, color: colors[journeyStats.length % colors.length] });
      }
      
      // Calculate Projection (Track the top one)
      let avgHoursPerDay = thisJHours / Math.max(1, jCompletedDays);
      let expectedTotalHours = jTotalDays * 2; // Assume 2 hours per day expected
      totalExpectedHours += expectedTotalHours;
      
      if (thisJHours > topJourneyHours && thisJHours > 0) {
        topJourneyHours = thisJHours;
        let daysLeft = 0;
        if (avgHoursPerDay > 0) {
          let remainingHours = Math.max(0, expectedTotalHours - thisJHours);
          daysLeft = Math.ceil(remainingHours / avgHoursPerDay);
        }
        topJourneyForProjection = {
          name: jn.name,
          daysLeft: daysLeft,
          pct: pct
        };
      }
      
      // Status Tag
      let statusTag = "🚧 Not Started";
      let statusClass = "";
      if (thisJHours > 0) {
        statusTag = "💤 Inactive";
      }
      if (jTodayHours > 0) {
        statusTag = "🔥 Active";
        statusClass = "tag-active";
      }
      
      const journeyCount = Object.keys(globalState.journeys).length;
      cardsHtml += `
        <div class="alive-journey-card flex-shrink-0 snap-start" style="position:relative; min-width: 280px;">
          <div class="alive-card-crud-actions" onclick="event.stopPropagation()">
            <button class="alive-card-action-btn alive-card-edit-btn" onclick="openEditJourneyModal('${jKey}')" title="Edit Journey">✏️</button>
            ${journeyCount > 1 ? `<button class="alive-card-action-btn alive-card-delete-btn" onclick="confirmDeleteJourney('${jKey}','${jn.name.replace(/'/g,"\\'")}',this)" title="Delete Journey">🗑️</button>` : ''}
          </div>
          <div onclick="enterJourney('${jKey}')" style="cursor:pointer;">
            <div class="alive-card-status-tag ${statusClass}">${statusTag}</div>
            <span class="alive-card-icon">${jn.icon || "🚀"}</span>
            <div class="alive-card-name">${jn.name}</div>
            <div class="alive-card-sub">${jCompletedDays}/${jTotalDays} Days • ${pct}%</div>
            <div class="alive-card-stats">
              <div class="alive-card-stat">
                <span class="alive-card-stat-val">${thisJHours.toFixed(1)}h</span>
                <span class="alive-card-stat-label">Invested</span>
              </div>
              <div class="alive-card-stat">
                <span class="alive-card-stat-val" style="color:#fbbf24;">${jTodayHours}h</span>
                <span class="alive-card-stat-label">Today</span>
              </div>
            </div>
            <div class="alive-card-progress">
               <div class="alive-card-progress-fill" style="width: ${pct}%"></div>
            </div>
          </div>
        </div>
      `;
    });
  }
  
  // AI Insight
  const elInsight = document.getElementById("aliveInsight");
  if (elInsight) {
    elInsight.style.display = "block";
    if (thisWeekHours > lastWeekHours && lastWeekHours > 0) {
      const inc = Math.round(((thisWeekHours - lastWeekHours) / lastWeekHours) * 100);
      elInsight.innerHTML = `<b>Insight:</b> You are ${inc}% more consistent than last week.`;
    } else if (thisWeekHours > 0) {
      elInsight.innerHTML = `<b>Insight:</b> You've invested ${thisWeekHours.toFixed(1)} hours in the last 7 days. Keep it up.`;
    } else {
      elInsight.innerHTML = `<b>Insight:</b> Even a small step today moves you forward.`;
    }
  }

  // Today Focus (from global todos)
  const todayStrFmt = todayDateObj.toISOString().split("T")[0]; // YYYY-MM-DD
  const todayTodos = (globalState.todos || []).filter(t => !t.done && t.date === todayStrFmt).slice(0, 3);
  const elFocusWrap = document.getElementById("aliveTodayFocusWrap");
  const elFocusList = document.getElementById("aliveFocusList");
  if (elFocusWrap && elFocusList) {
    if (todayTodos.length > 0) {
      elFocusWrap.style.display = "block";
      elFocusList.innerHTML = todayTodos.map(t => `<li>${t.text}</li>`).join("");
    } else {
      elFocusWrap.style.display = "none";
    }
  }

  // Today's Calendar Events
  const elCalWrap = document.getElementById("aliveTodayCalWrap");
  const elCalList = document.getElementById("aliveCalList");
  if (elCalWrap && elCalList) {
    let todayEvents = [];
    if (globalState && globalState.calendarEvents) {
      todayEvents = todayEvents.concat(globalState.calendarEvents.filter(e => e.date === todayStrFmt));
    }
    if (window.fetchedGCalEvents) {
      window.fetchedGCalEvents.forEach(gcalEv => {
        if (gcalEv.date === todayStrFmt && !todayEvents.find(e => e.gcalId === gcalEv.gcalId)) {
          todayEvents.push(gcalEv);
        }
      });
    }
    todayEvents.sort((a,b) => (a.time || '00:00').localeCompare(b.time || '00:00'));
    
    if (todayEvents.length > 0) {
      elCalWrap.style.display = "block";
      elCalList.innerHTML = todayEvents.slice(0, 5).map(e => `<li>${e.time ? `<b>${window.format12h ? window.format12h(e.time) : e.time}</b>:` : '📌'} ${e.title}</li>`).join("");
    } else {
      elCalWrap.style.display = "none";
    }
  }

  // Future Projections
  const elProjWrap = document.getElementById("aliveFutureProjWrap");
  const elProjList = document.getElementById("aliveProjList");
  if (elProjWrap && elProjList) {
    if (topJourneyForProjection) {
      elProjWrap.style.display = "block";
      if (topJourneyForProjection.pct >= 100) {
        elProjList.innerHTML = `You have fully completed your <b>${topJourneyForProjection.name}</b> journey. Outstanding work.`;
      } else if (topJourneyForProjection.daysLeft > 0) {
        elProjList.innerHTML = `At this pace, you'll complete <b>${topJourneyForProjection.name}</b> in ${topJourneyForProjection.daysLeft} days.`;
      } else {
        elProjList.innerHTML = `Keep pushing forward on your <b>${topJourneyForProjection.name}</b> journey.`;
      }
    } else {
      elProjWrap.style.display = "none";
    }
  }
  
  // Triple Ring "Alive Matrix" Calculation
  const dailyGoalHours = 4.0;
  const targetStreak = 10;
  
  let scoreWork = Math.min(100, (totalHoursToday / dailyGoalHours) * 100);
  let scoreMomentum = Math.min(100, (overallBestStreak / targetStreak) * 100);
  
  // Wellness/Reflection score (Checked dynamically)
  let scoreWellness = 0;
  const reflTxt = localStorage.getItem("alive_reflection") || "";
  if (reflTxt.trim().length > 10) scoreWellness = 100;
  
  let lifeScore = Math.round((scoreWork + scoreMomentum + scoreWellness) / 3);

  // Update Legends
  const elLblWork = document.getElementById("lblWork");
  if (elLblWork) elLblWork.innerText = `${totalHoursToday.toFixed(1)}/4h`;
  const elLblMom = document.getElementById("lblMomentum");
  if (elLblMom) elLblMom.innerText = `${Math.min(overallBestStreak, 10)}/10`;
  const elLblWell = document.getElementById("lblWellness");
  if (elLblWell) elLblWell.innerText = scoreWellness > 0 ? "1/1" : "0/1";
  const elTotalHours = document.getElementById("focusTotalHours");
  if (elTotalHours) elTotalHours.innerText = `${totalLifeHours.toFixed(1)}h`;
  const elTodayHours = document.getElementById("focusTodayHours");
  if (elTodayHours) elTodayHours.innerText = `${totalHoursToday.toFixed(1)}h`;
  const elJourneyCount = document.getElementById("focusJourneyCount");
  if (elJourneyCount) elJourneyCount.innerText = String(Object.keys(globalState?.journeys || {}).length);
  const elBestStreak = document.getElementById("focusBestStreak");
  if (elBestStreak) elBestStreak.innerText = `${overallBestStreak}d`;

  // Animate Central Score Number
  const elScore = document.getElementById("aliveLifeScore");
  if (elScore) {
    let curr = 0;
    const dur = 1500; // ms
    const fps = 60;
    const step = lifeScore / (dur / (1000/fps));
    if (lifeScore === 0) elScore.innerText = 0;
    else {
      const invId = setInterval(() => {
        curr += step;
        if (curr >= lifeScore) {
          curr = lifeScore;
          clearInterval(invId);
        }
        elScore.innerText = Math.round(curr);
      }, 1000/fps);
    }
  }

  // Animate the 3 Rings (SVG)
  const ringW = document.getElementById("ringFillWork");
  const ringM = document.getElementById("ringFillMomentum");
  const ringL = document.getElementById("ringFillWellness");
  
  if (ringW) { ringW.style.transition = 'none'; ringW.style.strokeDashoffset = 534; }
  if (ringM) { ringM.style.transition = 'none'; ringM.style.strokeDashoffset = 408; }
  if (ringL) { ringL.style.transition = 'none'; ringL.style.strokeDashoffset = 283; }

  // Force reflow
  if (ringW) ringW.getBoundingClientRect();

  setTimeout(() => {
    if (ringW) { ringW.style.transition = ''; ringW.style.strokeDashoffset = 534 - (scoreWork / 100) * 534; }
    if (ringM) { ringM.style.transition = ''; ringM.style.strokeDashoffset = 408 - (scoreMomentum / 100) * 408; }
    if (ringL) { ringL.style.transition = ''; ringL.style.strokeDashoffset = 283 - (scoreWellness / 100) * 283; }
  }, 50);

  // Score Status Text & Glowing Badge
  const statusEl = document.getElementById("anScoreStatus");
  if (statusEl) {
    statusEl.className = "an-score-status"; // reset
    if (lifeScore >= 80) { statusEl.innerText = "Elite Mode"; statusEl.classList.add("status-excellent"); }
    else if (lifeScore >= 60) { statusEl.innerText = "Strong Pace"; statusEl.classList.add("status-good"); }
    else if (lifeScore >= 35) { statusEl.innerText = "Building"; statusEl.classList.add("status-average"); }
    else if (lifeScore > 0) { statusEl.innerText = "Slipping"; statusEl.classList.add("status-below"); }
    else { statusEl.innerText = "Ready to Begin"; statusEl.classList.add("status-below"); }
  }

  // Streak Warning
  const warnEl = document.getElementById("aliveStreakWarning");
  if (warnEl) {
    if (overallBestStreak > 0 && totalHoursToday === 0) {
      warnEl.style.display = "block";
    } else {
      warnEl.style.display = "none";
    }
  }

  // Time Distribution Bar
  const elDistWrap = document.getElementById("aliveTimeDistWrap");
  const elDistBar = document.getElementById("aliveTimeDistBar");
  const elDistLegend = document.getElementById("aliveTimeDistLegend");
  if (elDistWrap && elDistBar && elDistLegend) {
    if (totalLifeHours > 0 && journeyStats.length > 0) {
      elDistWrap.style.display = "block";
      let barHtml = "";
      let legendHtml = "";
      journeyStats.forEach(stat => {
        const pct = Math.round((stat.hours / totalLifeHours) * 100);
        barHtml += `<div class="alive-time-dist-segment" style="width:${pct}%; background:${stat.color};" title="${stat.name}: ${pct}%"></div>`;
        legendHtml += `<div class="alive-dist-legend-item"><div class="alive-dist-legend-color" style="background:${stat.color};"></div>${stat.name} ${pct}%</div>`;
      });
      elDistBar.innerHTML = barHtml;
      elDistLegend.innerHTML = legendHtml;
    } else {
      elDistWrap.style.display = "none";
    }
  }

  // Reflection Binding
  const elReflect = document.getElementById("aliveReflectionBox");
  if (elReflect) {
    const elSaveState = document.getElementById("aliveReflectionSaveState");
    const tagMap = {
      lesson: document.getElementById("reflectionTagLesson"),
      win: document.getElementById("reflectionTagWin"),
      focus: document.getElementById("reflectionTagFocus")
    };

    const keywordGroups = {
      lesson: ["learn", "lesson", "understand", "realize", "discovered", "improve", "mistake"],
      win: ["win", "won", "completed", "done", "achieved", "success", "shipped", "finished", "progress"],
      focus: ["focus", "deep work", "priority", "priorities", "discipline", "attention", "lock in", "concentrate"]
    };

    let reflectSaveTimer = null;

    function setReflectionSaveState(label, tone) {
      if (!elSaveState) return;
      elSaveState.textContent = label;
      elSaveState.className = "transition-colors duration-300";
      if (tone === "saving") {
        elSaveState.classList.add("text-amber-200", "opacity-90");
      } else if (tone === "saved") {
        elSaveState.classList.add("text-emerald-200", "opacity-90");
      } else {
        elSaveState.classList.add("text-white/34");
      }
    }

    function updateReflectionTagGlow(text) {
      const normalized = (text || "").toLowerCase();

      Object.entries(tagMap).forEach(([key, node]) => {
        if (!node) return;
        const isActive = keywordGroups[key].some(keyword => normalized.includes(keyword));
        node.classList.toggle("is-active", isActive);
      });
    }

    function persistReflection() {
      localStorage.setItem("alive_reflection", elReflect.value);
      updateReflectionTagGlow(elReflect.value);
      setReflectionSaveState("Saved", "saved");
      window.clearTimeout(reflectSaveTimer);
      reflectSaveTimer = window.setTimeout(() => {
        setReflectionSaveState("Autosaved", "idle");
      }, 1200);
    }

    elReflect.value = localStorage.getItem("alive_reflection") || "";
    updateReflectionTagGlow(elReflect.value);

    elReflect.addEventListener("input", () => {
