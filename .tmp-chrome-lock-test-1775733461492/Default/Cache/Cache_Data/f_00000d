  // Show cached headlines immediately while fetching fresh ones
  const cached = _loadNewsCache();
  if (cached) {
    _renderHeadlines(listEl, cached.articles, true);
  } else {
    listEl.innerHTML = '<div class="an-news-loading">Fetching live news…</div>';
  }

  let articles = [];

  // ── Strategy 1: Direct CORS-friendly JSON APIs (with timeout) ──
  try {
    const results = await Promise.allSettled([
      _fetchHackerNews(),
      _fetchDevTo(),
      _fetchRedditTech(),
    ]);
    for (const r of results) {
      if (r.status === 'fulfilled' && r.value?.length) articles.push(...r.value);
    }
  } catch(e) { console.warn('News Strategy 1 failed:', e); }

  // ── Strategy 2: RSS feeds via CORS proxies ──
  if (articles.length < 4) {
    const rssSources = [
      { url: 'https://feeds.bbci.co.uk/news/technology/rss.xml', name: 'BBC Tech', color: '#BB1919' },
      { url: 'https://techcrunch.com/feed/', name: 'TechCrunch', color: '#0A8A00' },
      { url: 'https://www.theverge.com/rss/index.xml', name: 'The Verge', color: '#E040FB' },
    ];
    // Try 2 random sources in parallel
    const shuffled = rssSources.sort(() => Math.random() - 0.5).slice(0, 2);
    try {
      const rssResults = await Promise.allSettled(
        shuffled.map(s => _fetchRSSviaProxy(s.url, s.name, s.color))
      );
      for (const r of rssResults) {
        if (r.status === 'fulfilled' && r.value?.length) articles.push(...r.value);
      }
    } catch(e) {}
  }

  // Deduplicate, sort by freshness, take top 6
  const seen = new Set();
  articles = articles.filter(a => {
    if (!a.title || !a.link || seen.has(a.title)) return false;
    seen.add(a.title); return true;
  }).sort((a, b) => new Date(b.pubDate) - new Date(a.pubDate)).slice(0, 6);

  if (articles.length) {
    _saveNewsCache(articles);
    _renderHeadlines(listEl, articles, false);
  } else if (cached && cached.articles.length) {
    // Already showing cached — just keep them
    _renderHeadlines(listEl, cached.articles, true);
  } else {
    listEl.innerHTML = '<div class="an-news-loading">Could not load headlines. Tap ↻ to retry.</div>';
  }

  const nBtn = document.getElementById('newsRefreshBtn');
  if (nBtn) nBtn.classList.remove('spinning');
}

