// ─── GOOGLE TASKS SYNC HELPERS ───────────────────────

const GTASKS_BASE = "https://tasks.googleapis.com/tasks/v1";

function getGTasksToken() {
  return localStorage.getItem("gcalToken");
}

window.createGoogleTask = async function (todo, listId = "@default") {
  const token = getGTasksToken();
  if (!token) return null;
  try {
    const body = {
      title: todo.text,
      status: todo.done ? "completed" : "needsAction",
      notes: `Priority: ${todo.priority || "med"} | SFDC`,
    };
    if (todo.date) {
      // Google Tasks needs RFC 3339 date
      body.due = `${todo.date}T00:00:00.000Z`;
    }
    const res = await fetch(`${GTASKS_BASE}/lists/${listId}/tasks`, {
      method: "POST",
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(body),
    });
    if (res.ok) {
      const data = await res.json();
      return data.id || null;
    } else {
      const err = await res.text();
      console.error("Google Tasks create failed:", res.status, err);
      return null;
    }
  } catch (e) {
    console.error("createGoogleTask error:", e);
    return null;
  }
};

window.updateGoogleTask = async function (
  googleTaskId,
  todo,
  listId = "@default",
) {
  const token = getGTasksToken();
  if (!token || !googleTaskId) return;
  try {
    const body = {
      id: googleTaskId,
      title: todo.text,
      status: todo.done ? "completed" : "needsAction",
      notes: `Priority: ${todo.priority || "med"} | SFDC`,
    };
    if (todo.date) body.due = `${todo.date}T00:00:00.000Z`;
    await fetch(`${GTASKS_BASE}/lists/${listId}/tasks/${googleTaskId}`, {
      method: "PATCH",
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(body),
    });
  } catch (e) {
    console.error("updateGoogleTask error:", e);
  }
};

window.deleteGoogleTask = async function (googleTaskId, listId = "@default") {
  const token = getGTasksToken();
  if (!token || !googleTaskId) return;
  try {
    await fetch(`${GTASKS_BASE}/lists/${listId}/tasks/${googleTaskId}`, {
      method: "DELETE",
      headers: { Authorization: `Bearer ${token}` },
    });
  } catch (e) {
    console.error("deleteGoogleTask error:", e);
  }
};

window.fetchGoogleTasks = async function (listId = "@default") {
  const token = getGTasksToken();
  if (!token) return [];
  try {
    const res = await fetch(
      `${GTASKS_BASE}/lists/${listId}/tasks?showCompleted=true&maxResults=100`,
      {
        headers: { Authorization: `Bearer ${token}` },
      },
    );
    if (!res.ok) {
      console.error("fetchGoogleTasks failed:", res.status, await res.text());
      return [];
    }
    const data = await res.json();
    return data.items || [];
  } catch (e) {
    console.error("fetchGoogleTasks error:", e);
    return [];
  }
};

function initTasksSync() {
  const btn = document.getElementById("tasksConnectBtn");
  const badge = document.getElementById("tasksSyncBadge");
  if (!btn || !badge) return;

  const updateBadge = () => {
    const token = localStorage.getItem("gcalToken");
    if (token) {
      badge.textContent = "🟢 Tasks Synced";
      btn.textContent = "🔄 Sync Now";
    } else {
      badge.textContent = "⚪ Not synced";
      btn.textContent = "🔗 Connect Google Tasks";
    }
  };
  updateBadge();
}

async function syncAllTasks() {
  if (!state.todos) state.todos = [];
  const listId = "@default";
  const badge = document.getElementById("tasksSyncBadge");

  // ── STEP 1: Fetch existing Google Tasks and import them locally ──
  const gTasks = await window.fetchGoogleTasks(listId);
  const existingGIds = new Set(
    state.todos.filter((t) => t.googleTaskId).map((t) => t.googleTaskId),
  );
  let importedCount = 0;

  for (const gt of gTasks) {
    if (!gt.id || gt.deleted) continue;
    if (existingGIds.has(gt.id)) continue; // already imported

    // Map Google Task → local todo
    const newTodo = {
      id: "t_g_" + gt.id,
      text: gt.title || "(no title)",
      priority: "med",
      done: gt.status === "completed",
      date: gt.due ? gt.due.split("T")[0] : "",
      time: "",
      googleTaskId: gt.id,
    };
    state.todos.push(newTodo);
    importedCount++;
  }

  // ── STEP 2: Push local todos that have no Google counterpart ──
  for (let todo of state.todos) {
    if (!todo.googleTaskId) {
      const gId = await window.createGoogleTask(todo, listId);
      if (gId) todo.googleTaskId = gId;
    } else {
      await window.updateGoogleTask(todo.googleTaskId, todo, listId);
    }
  }

  saveState();
  renderTodos();

  // Update badge
  if (badge) {
    const syncedCount = state.todos.filter((t) => t.googleTaskId).length;
    badge.textContent = `🟢 ${syncedCount} tasks synced`;
  }

  return importedCount;
}

