            <span class="fc-flip-hint">Click to reveal answer →</span>
            <button class="fc-del-btn" onclick="event.stopPropagation();deleteFlashcard(${realIdx})" title="Delete">🗑</button>
          </div>
        </div>
        <div class="fc-card-back" style="display:flex; flex-direction:column; justify-content:space-between">
          <div>
            <div class="fc-cat-badge">${card.cat}</div>
            <div class="fc-a-text">${card.a.replace(/\n/g, "<br>")}</div>
          </div>
          <div style="display:flex; gap:6px; margin-top:10px; pointer-events:${pointerEvents}; opacity:${opacity}" onclick="event.stopPropagation()">
            <button class="btn-srs hard" onclick="handleSRS(${realIdx}, 1)">Hard</button>
            <button class="btn-srs good" onclick="handleSRS(${realIdx}, 2)">Good</button>
            <button class="btn-srs easy" onclick="handleSRS(${realIdx}, 3)">Easy</button>
          </div>
        </div>
      </div>
    </div>`;
    })
    .join("");
}

function deleteFlashcard(idx) {
  state.flashcards.splice(idx, 1);
  saveState();
  renderFlashcards();
  showToast("Card deleted!");
}

window.handleSRS = function (idx, rating) {
  const card = state.flashcards[idx];
  let interval = card.interval || 0;
  let ease = card.easeFactor || 2.5;

  if (rating === 1) {
    // Hard
    interval = 1;
    ease = Math.max(1.3, ease - 0.2);
  } else if (rating === 2) {
    // Good
    interval =
      interval === 0 ? 1 : interval === 1 ? 3 : Math.round(interval * ease);
  } else if (rating === 3) {
    // Easy
    interval =
      interval === 0
        ? 3
        : interval === 1
          ? 4
          : Math.round(interval * ease * 1.3);
    ease += 0.15;
  }

  card.interval = interval;
  card.easeFactor = ease;
  card.nextReviewDate = Date.now() + interval * 86400000;

  saveState();
  renderFlashcards();
  showToast(`Card scheduled in ${interval} day(s)! 📅`);
};

