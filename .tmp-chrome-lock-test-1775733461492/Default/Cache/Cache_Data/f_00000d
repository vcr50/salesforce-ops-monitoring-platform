  const profileSetupPanel = document.getElementById("thProfileSetupPanel");
  const qlTrailheadBtn = document.getElementById("qlTrailheadBtn");
  const qlTrailheadId = document.getElementById("qlTrailheadId");
  const qlEditBtn = document.getElementById("qlEditBtn");

  // Helper to safely extract username even if user pastes the full URL
  function extractUsername(input) {
    if (!input) return "";
    let uname = input.trim();
    if (uname.includes("salesforce.com/trailblazer/")) {
      uname = uname.split("salesforce.com/trailblazer/")[1];
    } else if (uname.includes("trailblazer.me/id/")) {
      uname = uname.split("trailblazer.me/id/")[1];
    } else if (uname.startsWith("http")) {
      uname = uname.split("/").filter(Boolean).pop();
    }
    return uname.split("?")[0].split("/")[0];
  }

  // Initial render
  renderTrailheadProfile();

  // Save username
  if (saveUsernameBtn)
    saveUsernameBtn.addEventListener("click", () => {
      let username = extractUsername(usernameInput.value);
      if (!username) return showToast("Enter your Trailhead username first!");
      state.trailheadUsername = username;
      saveState();
      renderTrailheadProfile();
      showToast(`Profile linked to ${username} ✅`);
    });

  // Edit username
  if (qlEditBtn) {
    qlEditBtn.addEventListener("click", () => {
      if (profileSetupPanel) profileSetupPanel.style.display = "flex";
      if (quickLaunchRow) quickLaunchRow.style.display = "none";
    });
  }

  // Open Trailhead via Old Button or Quick Launch Button
  const handleOpenTh = () => {
    const url = `https://www.salesforce.com/trailblazer/profile`;
    window.open(url, "_blank", "noopener");
    showToast(`Opening your Trailhead Profile 🌩️`);
  };

  if (openBtn) openBtn.addEventListener("click", handleOpenTh);
  if (qlTrailheadBtn) qlTrailheadBtn.addEventListener("click", handleOpenTh);

  // Also open on Enter key in username input
  if (usernameInput)
    usernameInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        if (saveUsernameBtn) saveUsernameBtn.click();
      }
    });

  // Manual points sync
  if (syncPtsBtn)
    syncPtsBtn.addEventListener("click", () => {
      const pts = parseInt(manualPtsInput.value);
      if (isNaN(pts) || pts < 0)
        return showToast("Enter a valid points number!");
      state.trailheadManualPts = pts;
      saveState();
      const tPoints = document.getElementById("tPoints");
      if (tPoints) tPoints.textContent = pts.toLocaleString();
      showToast(`Trailhead score updated: ${pts.toLocaleString()} pts! 🏅`);
    });

  // Explicit user trigger to ask the extension to pull data immediately
  const magicPullBtn = document.getElementById("thMagicPullBtn");
  if (magicPullBtn) {
    magicPullBtn.addEventListener("click", () => {
      showToast("Checking Plugin for latest points...");
      window.dispatchEvent(new CustomEvent("EXTENSION_PULL_REQUEST"));
    });
  }

  // MAGIC AUTO-SYNC: Listen for Chrome Extension broadcasts
  const handleAutoSync = (payload) => {
    if (!payload) return;
    
    // Support both old (just points) and new (badges, points, trails) payloads
    const points = typeof payload === 'number' ? payload : payload.points;
    const badges = payload.badges || 0;
    const trails = payload.trails || 0;

    if (points && points > 0) {
      if (points === state.trailheadManualPts && badges === (state.trailheadStats?.badges || 0)) {
        // showToast(`Plugin Sync: Up to date! 🏅`);
        return;
      }
      
      console.log(`[TomCodex] Received auto-sync from extension:`, payload);
      
      state.trailheadManualPts = points;
      state.trailheadStats = { points, badges, trails };
      
      if (manualPtsInput) manualPtsInput.value = points;
      saveState();
      
      const tPoints = document.getElementById("tPoints");
      if (tPoints) tPoints.textContent = points.toLocaleString();
      
      renderTrailheadProfile(); // Re-renders the premium card if stats exist
      
      if (typeof window.updateJourneyScore === "function") {
        window.updateJourneyScore();
      }
      showToast(`✨ Trailhead Synced: ${points.toLocaleString()} pts, ${badges} badges! 🏅`);
    }
  };

  window.addEventListener("TRAILHEAD_SYNC", (e) => handleAutoSync(e.detail));
  window.addEventListener("message", (e) => {
    if (e.data && e.data.type === "TRAILHEAD_SYNC") {
      handleAutoSync(e.data);
    }
  });
}

