function updateCertCountdown() {
  const el = document.getElementById("certCountdown");
  if (!el || !state.certTrack?.examDate) {
    if (el) el.style.display = "none";
    return;
  }
  const examDate = new Date(state.certTrack.examDate);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const diff = Math.ceil((examDate - today) / 86400000);

  let color = "#10B981";
  let msg = "";
  if (diff < 0) {
    msg = `⚠️ Exam was ${Math.abs(diff)} day${Math.abs(diff) !== 1 ? "s" : ""} ago`;
    color = "#EF4444";
  } else if (diff === 0) msg = "🎓 Exam is TODAY!";
  else if (diff <= 7) {
    msg = `⚡ ${diff} day${diff !== 1 ? "s" : ""} to exam!`;
    color = "#F59E0B";
  } else {
    msg = `📅 ${diff} days until your exam`;
  }

  const certName = state.certTrack.name || "Certification";
  el.style.cssText = `display:flex; align-items:center; gap:12px; padding:14px 18px; border-radius:10px; background:${color}18; border:1px solid ${color}44; margin-top:16px;`;
  el.innerHTML = `<span style="font-size:28px; font-weight:700; color:${color};">${diff < 0 ? "—" : diff}</span>
    <div><div style="font-weight:600; color:${color};">${msg}</div>
    <div style="font-size:12px; color:var(--text-muted);">${certName} · Exam on ${examDate.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })}</div></div>`;
  el.style.display = "flex";
}

function renderCertTopics() {
  const list = document.getElementById("certTopicsList");
  const empty = document.getElementById("certTopicsEmpty");
  if (!list) return;
  const topics = state.certTrack?.topics || [];
  empty.style.display = topics.length === 0 ? "block" : "none";
  list.innerHTML = "";
  const weightColor = { high: "#EF4444", med: "#F59E0B", low: "#10B981" };
  topics.forEach((t, i) => {
    const item = document.createElement("div");
    item.className = "cert-topic-item" + (t.done ? " done" : "");
    item.innerHTML = `
      <input type="checkbox" ${t.done ? "checked" : ""} onchange="toggleCertTopic(${i}, this.checked)" />
      <span style="flex:1; ${t.done ? "text-decoration:line-through; color:var(--text-muted);" : ""}">${t.topic}</span>
      <span style="font-size:11px; padding:2px 8px; border-radius:20px; background:${weightColor[t.weight] || "#F59E0B"}22; color:${weightColor[t.weight] || "#F59E0B"}; font-weight:600;">${t.weight === "high" ? "🔴 High" : t.weight === "low" ? "🟢 Low" : "🟡 Med"}</span>
      <button class="badge-del" onclick="deleteCertTopic(${i})" title="Remove">✕</button>`;
    list.appendChild(item);
  });
  // Update progress bar
  const total = topics.length;
  const done = topics.filter((t) => t.done).length;
  const pct = total ? Math.round((done / total) * 100) : 0;
  const bar = document.getElementById("certTopicsBar");
  const pctEl = document.getElementById("certTopicsPct");
  if (bar) bar.style.width = pct + "%";
  if (pctEl) pctEl.textContent = pct + "%";
}

