function navPush(view) {
  // Don't push duplicates
  if (_navStack[_navStack.length - 1] === view) return;
  _navStack.push(view);
  // Push a real browser history entry so Android back / browser back triggers popstate
  try { history.pushState({ tcxView: view }, '', ''); } catch(e) {}
}

function navPop() {
  if (_navStack.length > 1) _navStack.pop();
  return _navStack[_navStack.length - 1] || 'home';
