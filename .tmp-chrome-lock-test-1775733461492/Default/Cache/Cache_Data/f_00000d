      habits: ["Early Rise", "Deep Work", "Guitar Practice", "Reflection"],
      habitsDone: {}, 
      timeline: {}, 
      journal: {}
    };
  } else if (!globalState.lifeRoutine.journal) {
    globalState.lifeRoutine.journal = {};
  }

  renderLifeHeatmap();
  renderLifeHabits();
  renderLifeTimeline();
  renderLifeJournal();

  // Event Handlers
  const addBtn = document.getElementById("lrAddHabitBtn");
  const saveBtn = document.getElementById("lrSaveHabitBtn");
  const form = document.getElementById("lrAddHabitForm");
  const input = document.getElementById("lrNewHabitInput");

  if (addBtn) addBtn.onclick = () => form.style.display = (form.style.display === "none") ? "block" : "none";
  if (saveBtn) saveBtn.onclick = () => {
    const val = input.value.trim();
    if (val) {
      globalState.lifeRoutine.habits.push(val);
      input.value = "";
      form.style.display = "none";
      saveState();
      renderLifeHabits();
    }
  };

  const saveJournalBtn = document.getElementById("lrSaveJournalBtn");
  if (saveJournalBtn) {
    saveJournalBtn.onclick = () => {
      const todayStr = new Date().toISOString().split("T")[0];
      const entry = document.getElementById("lrJournalEntry").value;
      globalState.lifeRoutine.journal[todayStr] = entry;
      saveState();
      localStorage.setItem("alive_reflection", entry);
      showToast("Journal saved! 📖");
    };
  }
}

function renderLifeJournal() {
  const todayStr = new Date().toISOString().split("T")[0];
  const journalEl = document.getElementById("lrJournalEntry");
  if (journalEl) {
    journalEl.value = globalState.lifeRoutine.journal[todayStr] || localStorage.getItem("alive_reflection") || "";
  }
}

function renderLifeHeatmap() {
  const grid = document.getElementById("lrHeatmapGrid");
  const monthsEl = document.getElementById("lrHeatmapMonths");
  if (!grid) return;

  grid.innerHTML = "";
  const totalCells = 53 * 7; // Approx 1 year
  const today = new Date();
  
  // Starting date: 52 weeks ago
  const startDate = new Date();
  startDate.setDate(today.getDate() - (totalCells - 1));

  let streak = 0;
  for (let i = 0; i < totalCells; i++) {
    const d = new Date(startDate);
    d.setDate(startDate.getDate() + i);
    const dateKey = d.toISOString().split("T")[0];
    const score = globalState.lifeRoutine.heatmap[dateKey] || 0;
    
    const cell = document.createElement("div");
    cell.className = "lr-heatmap-cell";
    if (score > 0) cell.classList.add(`lr-cell-${score}`);
    cell.title = `${dateKey}: Level ${score}`;
    grid.appendChild(cell);

    if (score > 0) streak++;
    else if (d < today) streak = 0;
  }

  const streakEl = document.getElementById("lrStreakCount");
  if (streakEl) streakEl.innerText = `${streak} Day Streak`;

  // Simple Month labels
  if (monthsEl) {
    monthsEl.innerHTML = `<span>Apr</span><span>Jul</span><span>Oct</span><span>Jan</span><span>Mar</span>`;
  }
}

function renderLifeHabits() {
  const list = document.getElementById("lrHabitsList");
  if (!list) return;
  list.innerHTML = "";

  const todayStr = new Date().toISOString().split("T")[0];
  if (!globalState.lifeRoutine.habitsDone[todayStr]) globalState.lifeRoutine.habitsDone[todayStr] = [];
  const doneToday = globalState.lifeRoutine.habitsDone[todayStr];

  globalState.lifeRoutine.habits.forEach(h => {
    const isDone = doneToday.includes(h);
    const item = document.createElement("div");
    item.className = `lr-habit-item ${isDone ? 'completed' : ''}`;
    item.innerHTML = `
      <div class="lr-checkbox"></div>
      <span class="lr-habit-name">${h}</span>
    `;
    item.onclick = () => {
      if (isDone) {
        globalState.lifeRoutine.habitsDone[todayStr] = doneToday.filter(x => x !== h);
      } else {
        globalState.lifeRoutine.habitsDone[todayStr].push(h);
      }
      updateHeatmapScore(todayStr);
      saveState();
      renderLifeHabits();
    };
    list.appendChild(item);
  });
}

function renderLifeTimeline() {
  const grid = document.getElementById("lrTimelineGrid");
  if (!grid) return;
  grid.innerHTML = "";

  const todayStr = new Date().toISOString().split("T")[0];
  if (!globalState.lifeRoutine.timeline[todayStr]) {
    globalState.lifeRoutine.timeline[todayStr] = new Array(24).fill("");
  }
  const blocks = globalState.lifeRoutine.timeline[todayStr];
  const currentHour = new Date().getHours();

  for (let i = 0; i < 24; i++) {
    const hourLbl = i % 12 === 0 ? 12 : i % 12;
    const ampm = i < 12 ? "AM" : "PM";
    const isActive = i === currentHour;

    const block = document.createElement("div");
    block.className = `lr-time-block ${isActive ? 'active' : ''}`;
    block.innerHTML = `
      <div class="lr-time-lbl">${hourLbl}${ampm}</div>
      <div class="lr-time-content" title="Click to log activity">${blocks[i] || '—'}</div>
    `;
    block.onclick = () => {
      const activity = prompt(`What are you doing at ${hourLbl}${ampm}?`, blocks[i]);
      if (activity !== null) {
        blocks[i] = activity;
        updateHeatmapScore(todayStr);
        saveState();
        renderLifeTimeline();
      }
    };
    grid.appendChild(block);
  }
}

function updateHeatmapScore(dateKey) {
  const doneCount = (globalState.lifeRoutine.habitsDone[dateKey] || []).length;
  const timeLogCount = (globalState.lifeRoutine.timeline[dateKey] || []).filter(x => x && x !== "").length;
  
  let score = 0;
  const totalPossible = globalState.lifeRoutine.habits.length + 5; // Habits + log 5 hours
  const current = doneCount + Math.min(5, timeLogCount);
  const pct = current / totalPossible;

  if (pct > 0.8) score = 3;
  else if (pct > 0.4) score = 2;
  else if (pct > 0.1) score = 1;

  globalState.lifeRoutine.heatmap[dateKey] = score;
  renderLifeHeatmap();
}

function buildAliveNowHome() {
  // Update Date String
  const dateEl = document.getElementById("aliveDateStr");
  if (dateEl) {
    const opts = { month: 'long', day: 'numeric', year: 'numeric' };
    dateEl.innerText = new Date().toLocaleDateString('en-US', opts);
