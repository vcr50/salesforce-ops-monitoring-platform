// ─── OVER-THE-AIR (OTA) UPDATES: CAPGO ───
async function initOTAUpdates() {
  if (window.Capacitor?.isNativePlatform?.()) {
    try {
      let CapUpdater = window.CapacitorUpdater;
      if (!CapUpdater) {
        try {
          const mod = await import('@capgo/capacitor-updater');
          CapUpdater = mod.CapacitorUpdater;
        } catch(e) { console.warn("Failed to dynamically import Updater", e); }
      }
      
      if (CapUpdater) {
        // 1. Notify that the new CSS/JS didn't crash the app (prevents rollback loops)
        await CapUpdater.notifyAppReady();
        console.log("✅ OTA Update: App marked as ready.");

        // 2. Perform a background check for updates
        const update = await CapUpdater.download({ version: "latest" });
        if (update.version) {
          console.log(`🚀 OTA Update downloaded: ${update.version}. Will apply on next restart!`);
          await CapUpdater.set({ version: update.version });
        }
      }
    } catch (err) {
      console.warn("OTA Background check bypassed:", err);
    }
  }
}

document.addEventListener("DOMContentLoaded", () => {
  init();
  initOTAUpdates(); // Trigger OTA ping silently in background
  initPushNotifications(); // Prompt for FCM
  initMicroAnimations(); // Apply scroll animations
});

// ─── NATIVE PUSH NOTIFICATIONS ───
async function initPushNotifications() {
  if (typeof Capacitor === "undefined" || !Capacitor.isNativePlatform()) return;
  const { PushNotifications } = Capacitor.Plugins;
  if (!PushNotifications) return;

  try {
    let permStatus = await PushNotifications.checkPermissions();
    if (permStatus.receive === 'prompt') {
      permStatus = await PushNotifications.requestPermissions();
    }
    if (permStatus.receive !== 'granted') return;

    await PushNotifications.register();

    PushNotifications.addListener('registration', token => {
      console.log('[FCM] Device Token: ' + token.value);
    });

    PushNotifications.addListener('pushNotificationReceived', notification => {
      // Optional: Log or show UI toast when app is in foreground
      console.log('Push Received:', notification);
    });
  } catch(e) {
    console.warn("[FCM] Push Init failed:", e);
  }
}

// ─── APPLE GLASS MICRO-ANIMATIONS ───
function initMicroAnimations() {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('an-revealed');
      }
    });
  }, { threshold: 0.1 });

  // Attach reveal classes slightly delayed to allow DOM build
  setTimeout(() => {
    const targets = document.querySelectorAll('.an-card, .lr-card, .an-journey-card, .an-reflection');
    targets.forEach(t => {
      // Only attach if it hasn't been attached yet
      if (!t.classList.contains('an-reveal-up')) {
        t.classList.add('an-reveal-up');
        observer.observe(t);
      }
    });
  }, 200);
}

