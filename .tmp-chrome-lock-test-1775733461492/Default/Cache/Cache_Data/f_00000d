function initExamCountdown() {
  const input = document.getElementById("examDatepicker");
  if (!input) return;

  // Apply saved date on load
  if (state && state.targetExamDate) {
    input.value = state.targetExamDate;
  }

  // Save new date when user changes the picker
  input.addEventListener("change", (e) => {
    if (!state) return;
    state.targetExamDate = e.target.value;
    saveState();
    updateExamCountdown();
  });
}

function updateExamCountdown() {
  const input = document.getElementById("examDatepicker");
  const numEl = document.getElementById("examDaysNum");
  const labelEl = document.getElementById("examDaysLabel");
  const subEl = document.getElementById("examSubtext");

  if (!input || !numEl) return;
  if (state && state.targetExamDate) {
    input.value = state.targetExamDate;

    // Calculate days remaining
    const targetDate = new Date(state.targetExamDate);
    const todayDate = new Date();
    targetDate.setHours(0, 0, 0, 0);
    todayDate.setHours(0, 0, 0, 0);

    const diffTime = targetDate - todayDate;
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    if (diffDays > 0) {
      numEl.textContent = diffDays;
      labelEl.textContent = diffDays === 1 ? "Day Left" : "Days Left";
      numEl.className = "exam-days";
      subEl.textContent = `Target: ${targetDate.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}`;
    } else if (diffDays === 0) {
      numEl.textContent = "0";
      labelEl.textContent = "Exam Today!";
      numEl.className = "exam-days exam-critical";
      subEl.textContent = "Good luck! 🚀";
    } else {
      numEl.textContent = "--";
      labelEl.textContent = "Passed";
      numEl.className = "exam-days";
      subEl.textContent = "Hope it went well!";
    }
  } else {
    input.value = "";
    numEl.textContent = "--";
    labelEl.textContent = "Days Left";
    numEl.className = "exam-days";
    subEl.textContent = "Set target date →";
  }
}

function updateJourneyHeader() {
  const iconEl = document.getElementById("headerJObjIcon");
  const nameEl = document.getElementById("headerJObjName");
  const subEl = document.getElementById("headerSubtext");
  const activeSection = (state && state.activeSection) ? String(state.activeSection).toLowerCase() : "";
  const isSalesforceSection = ["trailhead", "salesforce"].includes(activeSection);
  const brandName = isSalesforceSection ? "SFDC" : "VertexDB";

  if (iconEl && state.icon) iconEl.textContent = state.icon;
  if (nameEl) nameEl.textContent = brandName;

  if (subEl) {
    // Generate subtext text: Start - End · X Days
    try {
      const dtStart = new Date(state.startDate || "2026-03-23");
      const dtEnd = new Date(dtStart);
      dtEnd.setDate(dtEnd.getDate() + (state.totalDays || 55) - 1);

      const fStart = dtStart.toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" });
      const fEnd = dtEnd.toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" });

      subEl.innerHTML = `${fStart} – ${fEnd} &nbsp;·&nbsp; ${state.totalDays || 55} Days`;
    } catch (e) {
      subEl.innerHTML = `${state.totalDays || 55} Days`;
    }
  }
}

function updateOverview() {
  const todayDay = getTodayDayNum();
  let completed = 0,
    totalHours = 0,
    totalPomo = 0;
  for (let d = 1; d <= TOTAL_DAYS; d++) {
    const e = state.days[d] || {};
    if (e.completed) completed++;
    totalHours += parseFloat(e.hours || 0);
    totalPomo += parseInt(e.pomodorosCompleted || 0, 10);
  }
  const remaining = TOTAL_DAYS - completed;
  const percent = Math.round((completed / TOTAL_DAYS) * 100);
  document.getElementById("statCompleted").textContent = completed;
  document.getElementById("statRemaining").textContent = remaining;
  document.getElementById("statPercent").textContent = percent + "%";
  document.getElementById("statTotalHours").textContent =
    totalHours.toFixed(1) + "h";
  document.getElementById("statPomodoros").textContent = totalPomo;
  document.getElementById("progressLabel").textContent =
    `${completed} / ${TOTAL_DAYS} days`;
  document.getElementById("overallBar").style.width = percent + "%";
  updateExamCountdown();

  // Streak
  const { current, best } = calcStreak();
  document.getElementById("streakNum").textContent = current;
  document.getElementById("streakBest").textContent = best;

  // Goal
  const goal = state.goalHours || 4;
  document.getElementById("goalHours").value = goal;
  document.getElementById("goalTargetHrs").textContent = goal + "h";
  if (todayDay) {
    const todayHrs = parseFloat((state.days[todayDay] || {}).hours || 0);
    const goalPct = Math.min(100, Math.round((todayHrs / goal) * 100));
    document.getElementById("goalTodayHrs").textContent = todayHrs + "h";
    document.getElementById("goalBar").style.width = goalPct + "%";
  }

  // Quick log
  if (todayDay) {
    const e = state.days[todayDay] || {};
    document.getElementById("quickDayLabel").textContent =
      `Day ${todayDay} · ${formatDate(getDayDate(todayDay))} · ${getPhaseForDay(todayDay).name}`;
    document.getElementById("quickHours").value = e.hours || "";
    document.getElementById("quickPomodoros").value =
      e.pomodorosCompleted || "";
    document.getElementById("quickTopics").value = e.topics || "";
    document.getElementById("quickTopics").placeholder = state.topicPlaceholder || "e.g. Topics learned today";
  } else {
    document.getElementById("quickDayLabel").textContent =
      "Journey not started or completed 🎉";
  }

  buildPhaseOverview();
  drawChart();
  buildExamScore();
  buildRadarChart();
  buildHeatmap();
  updateProjectBadge();
  updateTrailheadStats();
  buildTodoTicker();
}

function buildTodoTicker() {
  const wrap = document.getElementById("todoTickerWrap");
  const inner = document.getElementById("todoTickerInner");
  if (!wrap || !inner) return;

  const urgentTodos = (state.todos || []).filter(
    (t) => !t.done && t.priority === "high",
  );

  if (urgentTodos.length === 0) {
    wrap.style.display = "none";
    return;
  }

  // Duplicate items so the scroll feels seamless
  const items = [...urgentTodos, ...urgentTodos];
  inner.innerHTML = items
    .map((t) => `<span class="todo-ticker-item">${t.text}</span>`)
    .join("");

  // Adjust scroll speed based on content length
  const totalChars = urgentTodos.reduce((s, t) => s + t.text.length, 0);
  const duration = Math.max(12, Math.min(40, totalChars * 0.35));
  inner.style.animationDuration = duration + "s";

  wrap.style.display = "flex";
}

function buildPhaseOverview() {
  const grid = document.getElementById("phaseOverviewGrid");
  if (!grid) return;
  grid.innerHTML = "";
  const currentPhases =
    state.phasesList !== undefined ? state.phasesList : PHASES;

  if (currentPhases.length === 0) {
    grid.innerHTML =
      '<div style="color:var(--text-muted); font-size:13px; grid-column:1/-1;">No phases defined.</div>';
    return;
  }

  currentPhases.forEach((p, i) => {
    const total = Math.max(1, p.dayEnd - p.dayStart + 1);
    let done = 0;
    for (let d = p.dayStart; d <= p.dayEnd; d++)
      if ((state.days[d] || {}).completed) done++;
    const pct = Math.round((done / total) * 100);
    const pid = p.id || i + 1;

    const card = document.createElement("div");
    card.className = "phase-mini-card";
    card.innerHTML = `
      <div class="phase-mini-title">Phase ${i + 1}: ${p.name}</div>
      <div class="phase-mini-bar"><div class="phase-mini-fill" style="width:${pct}%;background:${p.color}"></div></div>
      <div class="phase-mini-stat">${done}/${total} days · ${pct}%</div>`;
    grid.appendChild(card);
  });
}

// ─── STUDY HOURS CANVAS CHART ─────────────────
function drawChart() {
  const canvas = document.getElementById("hoursChart");
  const empty = document.getElementById("chartEmpty");
  const ctx = canvas.getContext("2d");
  const todayDay = getTodayDayNum() || TOTAL_DAYS;
  const count = Math.min(14, todayDay);
  const startD = Math.max(1, todayDay - count + 1);

  const labels = [],
    data = [];
  for (let d = startD; d <= todayDay; d++) {
    labels.push("D" + d);
    data.push(parseFloat((state.days[d] || {}).hours || 0));
  }

  const hasData = data.some((v) => v > 0);
  if (!hasData) {
    canvas.style.display = "none";
    empty.style.display = "block";
    return;
  }
  canvas.style.display = "block";
  empty.style.display = "none";

  const dpr = window.devicePixelRatio || 1;
  // Walk up to find a parent with real width (section may be hidden mid-render)
  let availW = 0;
  let el = canvas.parentElement;
  while (el && availW < 50) { availW = el.clientWidth; el = el.parentElement; }
  if (availW < 50) availW = (window.innerWidth || 800) - 260; // fallback: viewport minus sidebar
  const W = availW - 40;
  const H = 160;
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width = W + "px";
  canvas.style.height = H + "px";
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, H);

  const isDark = document.documentElement.getAttribute("data-theme") === "dark";
  const barColor = "#1B96FF";
  const goalColor = "rgba(255,107,53,0.7)";
  const textColor = isDark ? "#8B949E" : "#687080";
  const gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";

  const pad = { l: 24, r: 12, t: 10, b: 28 };
  const chartW = W - pad.l - pad.r;
  const chartH = H - pad.t - pad.b;
  const maxVal = Math.max(state.goalHours || 4, ...data, 1);
  const barW = Math.max(4, chartW / labels.length - 6);

  // Grid lines
  ctx.strokeStyle = gridColor;
  ctx.lineWidth = 1;
  [0.25, 0.5, 0.75, 1].forEach((t) => {
    const y = pad.t + chartH * (1 - t);
    ctx.beginPath();
    ctx.moveTo(pad.l, y);
    ctx.lineTo(W - pad.r, y);
    ctx.stroke();
  });

  // Goal line
  const goalY = pad.t + chartH * (1 - (state.goalHours || 4) / maxVal);
  ctx.strokeStyle = goalColor;
  ctx.lineWidth = 1.5;
  ctx.setLineDash([4, 3]);
  ctx.beginPath();
  ctx.moveTo(pad.l, goalY);
  ctx.lineTo(W - pad.r, goalY);
  ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = goalColor;
  ctx.font = "9px Inter,sans-serif";
  ctx.fillText("Goal", W - pad.r - 22, goalY - 3);

  // Bars
  data.forEach((val, i) => {
    const x =
      pad.l +
      (chartW / labels.length) * i +
      (chartW / labels.length - barW) / 2;
    const barH = (val / maxVal) * chartH;
    const y = pad.t + chartH - barH;
    const alpha = val >= (state.goalHours || 4) ? "1" : "0.65";
    ctx.fillStyle =
      val >= (state.goalHours || 4)
        ? `rgba(45,203,103,${alpha})`
        : `rgba(27,150,255,${alpha})`;
    // Rounded top
    const r = Math.min(4, barW / 2);
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + barW - r, y);
    ctx.quadraticCurveTo(x + barW, y, x + barW, y + r);
    ctx.lineTo(x + barW, y + barH);
    ctx.lineTo(x, y + barH);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.fill();

    // Label
    ctx.fillStyle = textColor;
    ctx.font = "9px Inter,sans-serif";
    ctx.textAlign = "center";
    ctx.fillText(labels[i], x + barW / 2, H - 8);
    if (val > 0) {
      ctx.fillStyle = isDark ? "#E6EDF3" : "#1A1E2C";
      ctx.font = "bold 9px Inter,sans-serif";
      ctx.fillText(val + "h", x + barW / 2, y - 3);
    }
  });
}

// ─── EXAM READINESS SCORE ────────────────────
function buildExamScore() {
  const todayDay = getTodayDayNum();
  if (!todayDay) return;
  // Score formula: (Completed Days / Total) * 0.5 + (Project % / 100) * 0.3 + (Trailhead > 50000 / 1000) * 0.2
  let completed = 0;
  for (let d = 1; d <= TOTAL_DAYS; d++)
    if ((state.days[d] || {}).completed) completed++;
  const daysPct = Math.min(100, (completed / TOTAL_DAYS) * 100);

  // Project pct
  let projTot = 0,
    projDone = 0;
  (state.projects || []).forEach((p) => {
    TAB_SECTIONS.forEach((s) => {
      (p[s] || []).forEach((i) => {
        projTot++;
        if (i.done) projDone++;
      });
    });
  });
  const projPct = projTot ? (projDone / projTot) * 100 : 0;

  // Trailhead
  let thPts = state.trailheadManualPts || 0;
  if (!thPts) {
    Object.values(state.badges || {}).forEach((arr) =>
      arr.forEach((b) => (thPts += b.pts)),
    );
  }
  const thPct = Math.min(100, (thPts / 50000) * 100); // 50k points = max

  const score = Math.round(daysPct * 0.5 + projPct * 0.3 + thPct * 0.2);
  document.getElementById("examScoreVal").textContent = score + "%";
  document.getElementById("examScoreFill").style.width = score + "%";
  document.getElementById("exDaysVal").textContent = Math.round(daysPct) + "%";
  document.getElementById("exProjVal").textContent = Math.round(projPct) + "%";
  document.getElementById("exThVal").textContent = Math.round(thPct) + "%";

  // Color code
  if (score >= 80)
    document.getElementById("examScoreFill").style.background =
      "linear-gradient(90deg, #2DCB67, #10B981)";
  else if (score >= 50)
    document.getElementById("examScoreFill").style.background =
      "linear-gradient(90deg, #F59E0B, #2DCB67)";
  else
    document.getElementById("examScoreFill").style.background =
      "linear-gradient(90deg, #EF4444, #F59E0B)";
}

// ─── TOPIC COVERAGE RADAR ────────────────────
let radarChartInstance = null;
function buildRadarChart() {
  const canvas = document.getElementById("radarChart");
  if (!canvas || !window.Chart) return;

  // 1. Extract and count topics from all logged days
  let topicCounts = {};
  for (let d = 1; d <= TOTAL_DAYS; d++) {
    const dayData = state.days[d];
    if (dayData && dayData.topics) {
      // Split by comma, clean non-alphanumeric edges, filter tiny strings
      const tokens = dayData.topics
        .split(",")
        .map((t) => t.trim().replace(/^[^a-zA-Z0-9]+|[^a-zA-Z0-9]+$/g, ""))
        .filter((t) => t.length > 2);
      tokens.forEach((t) => {
        const name = t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
        topicCounts[name] = (topicCounts[name] || 0) + 1;
      });
    }
  }

  // 2. Sort by frequency and take top 6
  let sortedTopics = Object.entries(topicCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 6);

  // 3. Fallbacks
  if (sortedTopics.length === 0) {
    if (currentJourneyId === "sfdc") {
      sortedTopics = [
        ["Admin", 0],
        ["Apex", 0],
        ["LWC", 0],
        ["Flows", 0],
        ["Security", 0],
        ["Integration", 0],
      ];
    } else {
      sortedTopics = [
        ["Topic 1", 0],
        ["Topic 2", 0],
        ["Topic 3", 0],
        ["Topic 4", 0],
        ["Topic 5", 0],
        ["Topic 6", 0],
      ];
    }
  } else
    while (sortedTopics.length < 3) {
      sortedTopics.push(["More...", 0]);
    }

  const labels = sortedTopics.map((t) => t[0]);
  const data = sortedTopics.map((t) => t[1] + 0.5); // base 0.5 so chart doesn't look empty at 0

  const isDark = document.documentElement.getAttribute("data-theme") === "dark";
  const gridColor = isDark ? "rgba(255,255,255,0.1)" : "rgba(0,0,0,0.1)";
  const textColor = isDark ? "#8B949E" : "#687080";

  if (radarChartInstance) radarChartInstance.destroy();

  radarChartInstance = new Chart(canvas, {
    type: "radar",
    data: {
      labels: labels,
      datasets: [
        {
          label: "Topic Intensity",
          data: data,
          backgroundColor: "rgba(1, 118, 211, 0.4)",
          borderColor: "#0176D3",
          pointBackgroundColor: "#032D60",
          borderWidth: 2,
          pointRadius: 3,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      layout: { padding: 10 },
      scales: {
        r: {
          angleLines: { color: gridColor },
          grid: { color: gridColor },
          pointLabels: {
            color: textColor,
            font: { family: "Inter", size: 11, weight: "600" },
          },
          ticks: { display: false, max: Math.max(...data, 5) },
        },
      },
      plugins: {
        legend: { display: false },
        tooltip: {
          enabled: true,
          callbacks: {
            label: function (context) {
              return Math.max(0, context.raw - 0.5) + " logs";
            },
          },
        },
      },
    },
  });
}

// ─── HEATMAP CALENDAR ────────────────────────
function buildHeatmap() {
  const container = document.getElementById("heatmapGrid");
  if (!container) return;
  container.innerHTML = "";

  // GITHUB STYLE HEATMAP:
  // 7 rows (days of the week), flow by column, fixed cell sizes
  container.style.display = "grid";
  container.style.gridAutoFlow = "column";
  container.style.gridTemplateRows = "repeat(7, 14px)";
  container.style.gap = "4px";
  container.style.justifyContent = "start"; // Align left
  container.style.overflowX = "auto";
  container.style.paddingBottom = "8px"; // room for scrollbar just in case

  const isDark = document.documentElement.getAttribute("data-theme") === "dark";

  for (let d = 1; d <= TOTAL_DAYS; d++) {
    const box = document.createElement("div");
    
    const entry = state.days[d] || {};
    const hrs = parseFloat(entry.hours || 0);

    // Color intensity logic (Github style)
    let bg = isDark ? "rgba(255,255,255,0.05)" : "rgba(0,0,0,0.06)"; // Empty
    if (hrs >= (state.goalHours || 4))
      bg = "var(--sf-dark)"; // Maximum
    else if (hrs >= 2) 
      bg = "var(--sf-blue)"; // Medium
    else if (hrs > 0) 
      bg = "rgba(1, 118, 211, 0.4)"; // Light (sky equivalent)

    box.style.background = bg;
    box.style.borderRadius = "3px";
    box.style.width = "14px";
    box.style.height = "14px";
    box.style.cursor = "pointer";
    box.style.transition = "transform 0.1s";
    
    box.onmouseenter = () => box.style.transform = "scale(1.2)";
    box.onmouseleave = () => box.style.transform = "scale(1)";
    
    box.title = `Day ${d}: ${hrs} hours`;
    box.onclick = () => openDayModal(d);

    container.appendChild(box);
  }
}

// ─── DAILY TABLE ──────────────────────────────
function buildDailyTable() {
  const tbody = document.getElementById("dailyTableBody");
  const todayDay = getTodayDayNum();
  tbody.innerHTML = "";
  // Rendering in REVERSE order (latest/current days first) to solve the "scrolling deep" issue
  for (let d = TOTAL_DAYS; d >= 1; d--) {
    const entry = state.days[d] || {};
    const date = getDayDate(d);
    const isToday = d === todayDay;
    const isDone = entry.completed;
    let statusClass = "pending",
      statusText = "Pending";
    if (isDone) {
      statusClass = "completed";
      statusText = "✓ Done";
    }
    if (isToday) {
      statusClass = "today-pill";
      statusText = "● Today";
    }
    let badgeClass = "";
    if (isToday) badgeClass = "today";
    if (isDone && !isToday) badgeClass = "done";
    const tr = document.createElement("tr");
    tr.id = `dayRow-${d}`;
    tr.innerHTML = `
      <td style="width: 70px; text-align: center;"><button class="btn-detail" onclick="openDayModal(${d})">Open</button></td>
      <td><span class="day-badge ${badgeClass}">${d}</span></td>
      <td>${formatDate(date)}</td>
      <td>${entry.hours ? entry.hours + "h" : "–"}</td>
      <td>${entry.pomodorosCompleted || "–"}</td>
      <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        ${entry.topics || '<span style="color:var(--text-muted)">Not logged</span>'}
      </td>
      <td><span class="status-pill ${statusClass}">${statusText}</span></td>`;
    tbody.appendChild(tr);
  }
}

