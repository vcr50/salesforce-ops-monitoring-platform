async function sendTelegramMsg(msg) {
  if (!globalState || !globalState.telegram) return;
  const { botToken, chatId } = globalState.telegram;
  if (!botToken || !chatId) return;
  
  try {
    const url = `https://api.telegram.org/bot${botToken}/sendMessage`;
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: chatId, text: msg, parse_mode: 'Markdown' })
    });
    if (!response.ok) {
      const errData = await response.json();
      console.error('Telegram API Error:', errData);
      showToast('Telegram Error: Check Bot Token/ID', 'error');
    }
  } catch (e) {
    console.error('Telegram sync failed:', e);
    showToast('Telegram sync failed!', 'error');
  }
}

function initTelegram() {
  const tokenIn = document.getElementById('tgBotToken');
  const chatIn = document.getElementById('tgChatId');
  const btn = document.getElementById('saveTgSetupBtn');
  const cfgSec = document.getElementById('tgConfigSection');
  const connSec = document.getElementById('tgConnectedSection');

  if (!globalState.telegram) {
    globalState.telegram = { botToken: '8728624725:AAEeDMQthJ_11IFbEuH9geZ7XMAypm0RMuM', chatId: '1079725005' };
  }

  if (!globalState.telegramHistory) globalState.telegramHistory = [];
  if (!globalState.telegramLastUpdateId) globalState.telegramLastUpdateId = 0;

  function renderChat() {
    const chatHist = document.getElementById('tgChatHistory');
    const emptyState = document.getElementById('tgChatEmpty');
    if (!chatHist || !emptyState) return;

    const bubbles = chatHist.querySelectorAll('.chat-msg');
    bubbles.forEach(b => b.remove());

    if (!globalState.telegramHistory || globalState.telegramHistory.length === 0) {
      emptyState.style.display = 'flex';
      emptyState.style.flexDirection = 'column';
      emptyState.style.alignItems = 'center';
      emptyState.style.justifyContent = 'center';
      return;
    }
    emptyState.style.display = 'none';

    globalState.telegramHistory.forEach(msg => {
      appendBubble(msg, chatHist);
    });
    chatHist.scrollTop = chatHist.scrollHeight;
  }

  // Append a single bubble (without full re-render)
  function appendBubble(msg, chatHist) {
    if (!chatHist) chatHist = document.getElementById('tgChatHistory');
    if (!chatHist) return;
    const div = document.createElement('div');
    div.className = 'chat-msg ' + (msg.type === 'sent' ? 'chat-msg-sent' : 'chat-msg-received');
    if (msg._pending) div.style.opacity = '0.6';
    let html = '';
    if (msg.fileName) {
      html += `<a href="${msg.fileUrl || '#'}" target="_blank" class="chat-doc"><div class="chat-doc-icon">📄</div><div>${msg.fileName}</div></a>`;
    }
    if (msg.text) {
      let t = msg.text.replace(/\*(.*?)\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
      html += `<div>${t}</div>`;
    }
    const time = new Date(msg.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const tick = msg.type === 'sent' ? (msg._pending ? ' <span style="opacity:0.5;font-size:10px;">⏳</span>' : ' <span style="opacity:0.7;font-size:10px;">✓✓</span>') : '';
    html += `<span class="chat-time">${time}${tick}</span>`;
    div.innerHTML = html;
    div.dataset.msgId = String(msg.id);
    chatHist.appendChild(div);
  }

  // ── Fast fetch: auto-poll every 4 seconds ──
  let _tgPollInterval = null;

  async function fetchTgUpdates() {
    const { botToken, chatId } = globalState.telegram || {};
    if (!botToken || !chatId) return;
    try {
      const offset = Number(globalState.telegramLastUpdateId || 0) + 1;
      const url = `https://api.telegram.org/bot${botToken}/getUpdates?offset=${offset}&timeout=0&allowed_updates=["message"]`;
      const res = await fetch(url, { signal: AbortSignal.timeout(5000) });
      if (!res.ok) return;
      const data = await res.json();
      if (data.ok && data.result && data.result.length > 0) {
        let hasNew = false;
        if (!globalState.telegramHistory) globalState.telegramHistory = [];
        const chatHist = document.getElementById('tgChatHistory');
        const emptyState = document.getElementById('tgChatEmpty');

        data.result.forEach(update => {
          globalState.telegramLastUpdateId = Math.max(Number(globalState.telegramLastUpdateId || 0), update.update_id);
          const msg = update.message;
          if (!msg || String(msg.chat.id) !== String(chatId)) return;
          if (globalState.telegramHistory.some(h => String(h.id) === String(msg.message_id))) return;

          const text = msg.text || msg.caption || '';
          const fileName = msg.document ? (msg.document.file_name || 'Document') : (msg.photo ? 'Photo Attachment' : '');
          const newMsg = { id: msg.message_id, type: 'received', text, date: msg.date * 1000, fileName, fileUrl: '' };
          globalState.telegramHistory.push(newMsg);

          // Instant append without full re-render
          if (emptyState) emptyState.style.display = 'none';
          appendBubble(newMsg, chatHist);
          if (chatHist) chatHist.scrollTop = chatHist.scrollHeight;
          hasNew = true;
        });
        if (hasNew) saveState();
      }
    } catch (e) {
      if (e.name !== 'TimeoutError' && e.name !== 'AbortError') console.error('Failed to get tg updates', e);
    }
  }

  function startPolling() {
    if (_tgPollInterval) clearInterval(_tgPollInterval);
    fetchTgUpdates(); // immediate first fetch
    _tgPollInterval = setInterval(fetchTgUpdates, 4000); // poll every 4 seconds
  }

  document.getElementById('tgRefreshChatBtn')?.addEventListener('click', () => {
    fetchTgUpdates();
    const btn = document.getElementById('tgRefreshChatBtn');
    const orig = btn.textContent;
    btn.textContent = '⏳';
    setTimeout(() => btn.textContent = orig, 1000);
  });

  window.renderTgUI = function() {
    if (!cfgSec || !connSec) return;
    if (globalState.telegram && globalState.telegram.botToken && globalState.telegram.chatId) {
      cfgSec.style.display = 'none';
      connSec.style.display = 'block';
      renderChat();
      startPolling(); // start auto-polling
    } else {
      cfgSec.style.display = 'block';
      connSec.style.display = 'none';
      if (_tgPollInterval) { clearInterval(_tgPollInterval); _tgPollInterval = null; }
      if (tokenIn && globalState.telegram && globalState.telegram.botToken) tokenIn.value = globalState.telegram.botToken;
      if (chatIn && globalState.telegram && globalState.telegram.chatId) chatIn.value = globalState.telegram.chatId;
    }
  };
  
  window.renderTgUI();

  btn?.addEventListener('click', () => {
    const t = tokenIn ? tokenIn.value.trim() : "";
    const c = chatIn ? chatIn.value.trim() : "";
    if (!t || !c) return showToast('Please enter both Token and Chat ID', 'error');
    
    globalState.telegram = globalState.telegram || { botToken: "8728624725:AAEeDMQthJ_11IFbEuH9geZ7XMAypm0RMuM", chatId: "1079725005" };
    globalState.telegram.botToken = t;
    globalState.telegram.chatId = c;
    saveState();
    window.renderTgUI();
    showToast('Telegram Connected! 🚀');
    sendTelegramMsg('🚀 *TomCodex Dashboard connected successfully!*');
  });

  document.getElementById('disconnectTgBtn')?.addEventListener('click', () => {
    if (_tgPollInterval) { clearInterval(_tgPollInterval); _tgPollInterval = null; }
    globalState.telegram = { botToken: '', chatId: '' };
    saveState();
    if (tokenIn) tokenIn.value = '';
    if (chatIn) chatIn.value = '';
    window.renderTgUI();
    showToast('Telegram Disconnected.');
  });

  document.getElementById('testTgBtn')?.addEventListener('click', () => {
    sendTelegramMsg('🧪 *Test Message:* Your integration is working perfectly! 🚀');
    showToast('Test message sent!');
  });

  // ── FAST SEND with optimistic UI ──
  async function doSend() {
    const msgEl = document.getElementById('tgQuickMessage');
    const fileEl = document.getElementById('tgQuickFile');
    const pdfEl  = document.getElementById('tgPdfFile');
    const msg    = msgEl ? msgEl.value.trim() : '';

    // ── Capture file FIRST before any clearing ──
    let file = null;
    if (fileEl && fileEl.files && fileEl.files.length > 0) {
      file = fileEl.files[0];
    } else if (pdfEl && pdfEl.files && pdfEl.files.length > 0) {
      file = pdfEl.files[0];
    }

    if (!msg && !file) return showToast('Type a message or select a file first!', 'error');
    if (!globalState || !globalState.telegram) return showToast('Telegram not connected!', 'error');

    const { botToken, chatId } = globalState.telegram;
    if (!botToken || !chatId) return showToast('Telegram credentials missing.', 'error');

    const sendBtn  = document.getElementById('tgSendQuickBtn');
    const chatHist = document.getElementById('tgChatHistory');
    const emptyState = document.getElementById('tgChatEmpty');

    // ── OPTIMISTIC UI — show message instantly ──
    const tempId = 'tmp_' + Date.now();
    const optimisticMsg = {
      id: tempId, type: 'sent',
      text: file ? (msg || '') : msg,
      date: Date.now(),
      fileName: file ? file.name : '',
      _pending: true
    };
    globalState.telegramHistory = globalState.telegramHistory || [];
    globalState.telegramHistory.push(optimisticMsg);
    if (emptyState) emptyState.style.display = 'none';
    appendBubble(optimisticMsg, chatHist);
    if (chatHist) chatHist.scrollTop = chatHist.scrollHeight;

    // ── Clear inputs immediately (after file ref is captured) ──
    if (msgEl) { msgEl.value = ''; msgEl.style.height = ''; }
    // Don't clear file inputs here — clear after successful send

    // ── Show sending state ──
    if (sendBtn) { sendBtn.disabled = true; sendBtn.innerHTML = file ? '📤' : '⏳'; }

    try {
      if (file) {
        // ── Build FormData for document/PDF upload ──
        const formData = new FormData();
        formData.append('chat_id', chatId);
        formData.append('document', file, file.name); // explicit filename
        if (msg) formData.append('caption', msg);

        showToast(`Uploading ${file.name}... 📤`);

        // No AbortSignal for file uploads — let it finish naturally
        const res = await fetch(
          `https://api.telegram.org/bot${botToken}/sendDocument`,
          { method: 'POST', body: formData }
        );

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.description || `HTTP ${res.status}`);
        }

        const result = await res.json();
        if (!result.ok) throw new Error(result.description || 'Telegram API error');

        // Clear file inputs only after confirmed success
        if (fileEl) fileEl.value = '';
        if (pdfEl)  pdfEl.value  = '';

        showToast(`✅ ${file.name} sent successfully!`);

      } else {
        // ── Text-only message ──
        const res = await fetch(
          `https://api.telegram.org/bot${botToken}/sendMessage`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chat_id: chatId, text: msg, parse_mode: 'Markdown' }),
            signal: AbortSignal.timeout(8000)
          }
        );

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.description || `HTTP ${res.status}`);
        }

        const result = await res.json();
        if (!result.ok) throw new Error(result.description || 'Telegram API error');
      }

      // ── Mark optimistic bubble as delivered ──
      const idx = globalState.telegramHistory.findIndex(m => m.id === tempId);
      if (idx !== -1) globalState.telegramHistory[idx]._pending = false;
      saveState();

      // Update bubble — remove ⏳ show ✓✓
      const bubble = chatHist?.querySelector(`[data-msg-id="${tempId}"]`);
      if (bubble) {
        bubble.style.opacity = '1';
        const timeEl = bubble.querySelector('.chat-time');
        if (timeEl) timeEl.innerHTML = timeEl.innerHTML.replace(/⏳.*?<\/span>/, '✓✓</span>').replace('⏳', '✓✓');
      }

    } catch (e) {
      console.error('Send failed:', e);

      // ── Remove optimistic bubble on failure ──
      const failIdx = globalState.telegramHistory.findIndex(m => m.id === tempId);
      if (failIdx !== -1) globalState.telegramHistory.splice(failIdx, 1);
      const failBubble = chatHist?.querySelector(`[data-msg-id="${tempId}"]`);
      if (failBubble) {
        failBubble.style.background = '#ef444444';
        failBubble.style.opacity = '0.7';
        setTimeout(() => failBubble.remove(), 1500);
      }

      showToast(`❌ Failed: ${e.message || 'Check connection'}`, 'error');
    } finally {
      if (sendBtn) { sendBtn.disabled = false; sendBtn.innerHTML = '➤'; }
    }
  }

  document.getElementById('tgSendQuickBtn')?.addEventListener('click', doSend);

  // Enter key to send (Shift+Enter = new line)
  document.getElementById('tgQuickMessage')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      doSend();
    }
  });

  document.getElementById('tgClearChatBtn')?.addEventListener('click', () => {
    if (confirm('Clear chat history?')) {
      globalState.telegramHistory = [];
      saveState();
      renderChat();
      showToast('Chat history cleared 🗑️');
