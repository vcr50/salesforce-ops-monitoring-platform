    if (!icon || icon.dataset.faviconLoaded) return;

    // Get the URL — card itself (anchor) or inner anchor
    const href = card.href || card.querySelector("a")?.href || "";
    if (!href || href.startsWith("javascript")) return;

    try {
      const domain = new URL(href).hostname;
      const img = document.createElement("img");
      img.src = `https://www.google.com/s2/favicons?domain=${domain}&sz=32`;
      img.alt = "";
      img.width = 22;
      img.height = 22;
      img.style.cssText = "object-fit:contain; border-radius:4px;";
      img.onload = () => {
        icon.innerHTML = "";
        icon.appendChild(img);
      };
      icon.dataset.faviconLoaded = "1";
    } catch {
      /* skip invalid URLs */
    }
  });
}

