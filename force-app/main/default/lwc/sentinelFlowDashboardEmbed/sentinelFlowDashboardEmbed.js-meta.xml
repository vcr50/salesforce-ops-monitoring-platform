<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>false</isExposed>
    <masterLabel>SentinelFlow Dashboard</masterLabel>
    <description>Embeds the SentinelFlow Dashboard Visualforce Page.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__AppPage,lightning__HomePage">
            <property name="customUrl" type="String" label="Dashboard URL Path" default="/SentinelFlow/apex/SentinelFlowDashboard" description="Change this to /apex/SentinelFlowDashboard if the default does not load." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
