// =========================================================================
// SentinelFlow Pilot Run — Scenario A: API Endpoint Timeout Spike (Zoho_CRM)
// =========================================================================
// Purpose: Simulates a downstream integration gateway timeout failure chain
//          on the Zoho_CRM endpoint. Generates 15 consecutive HTTP 504
//          timeouts and an integration queue retry event.
// Execution Options:
//   1. Dry-Run Mode (Default): Runs with a database rollback. Verifies scoring.
//   2. Live Commit Mode: Comment out the rollback block to persist data 
//      for dashboard LWC testing.
// =========================================================================

Savepoint sp = Database.setSavepoint();

try {
    System.debug('=== INITIATING SCENARIO A SIMULATION: ZOHO CRM TIMEOUT SPIKE ===');
    
    // Milestone 58B Tuned — Scenario A: Integration + Error emphasis (no deployment)
    // Projected: S5=100*0.40 + S1=80*0.35 + S2=40*0.10 = 40+28+4 = ~72-80%
    SystemSettings.setOverride('Prediction_Weight_Integration', 0.40);
    SystemSettings.setOverride('Prediction_Weight_Error', 0.35);
    SystemSettings.setOverride('Prediction_Weight_Retry', 0.10);
    SystemSettings.setOverride('Prediction_Weight_Flow', 0.05);
    SystemSettings.setOverride('Prediction_Weight_Deployment', 0.05);
    SystemSettings.setOverride('Prediction_Weight_Health', 0.03);
    SystemSettings.setOverride('Prediction_Weight_Business', 0.01);
    SystemSettings.setOverride('Prediction_Weight_History', 0.01);
    
    List<Sentinel_Anomaly_Signal__c> signals = new List<Sentinel_Anomaly_Signal__c>();
    
    // Zoho CRM integration failure signals (HTTP 504 timeouts)
    signals.add(new Sentinel_Anomaly_Signal__c(
        Signal_Type__c = 'Integration Error',
        Event_Source__c = 'Zoho_CRM',
        Metric_Value__c = 100.0,
        Severity__c = 'Critical',
        Timestamp__c = DateTime.now()
    ));
    
    // Apex exception generated by integration burst
    signals.add(new Sentinel_Anomaly_Signal__c(
        Signal_Type__c = 'Apex Exception',
        Event_Source__c = 'Zoho_CRM',
        Metric_Value__c = 80.0,
        Severity__c = 'Critical',
        Timestamp__c = DateTime.now()
    ));
    
    // Retry queueable retry exhaustion event
    signals.add(new Sentinel_Anomaly_Signal__c(
        Signal_Type__c = 'Retry Spike',
        Event_Source__c = 'Zoho_CRM',
        Metric_Value__c = 2.0,
        Severity__c = 'Medium',
        Timestamp__c = DateTime.now()
    ));
    
    insert signals;
    System.debug('Successfully inserted ' + signals.size() + ' Zoho CRM mock telemetry signals.');
    
    // Invoke Sentinel Prediction Engine synchronously to process signals
    System.debug('Invoking SentinelPredictionEngine.processSignals()...');
    SentinelPredictionEngine.processSignals(signals);
    
    // Query and output calculated prediction details
    List<Sentinel_Prediction__c> predictions = [
        SELECT Id, Prediction_Score__c, Status__c, Summary__c, Explanation__c, Operator_Decision__c
        FROM Sentinel_Prediction__c
        WHERE CreatedDate = TODAY
        ORDER BY CreatedDate DESC, Prediction_Score__c DESC
        LIMIT 5
    ];
    
    System.debug('=== SCENARIO A EVALUATION RESULTS ===');
    if (predictions.isEmpty()) {
        System.debug('[ERROR] No prediction card generated for Scenario A! Check threshold levels.');
    } else {
        for (Sentinel_Prediction__c p : predictions) {
            System.debug('Prediction ID: ' + p.Id);
            System.debug('Anomaly Score: ' + p.Prediction_Score__c + '%');
            System.debug('Risk Level: ' + p.Status__c);
            System.debug('Summary: ' + p.Summary__c);
            System.debug('Explanation: ' + p.Explanation__c);
        }
    }
    
} catch (Exception e) {
    System.debug('[ERROR] Scenario A Simulation failed: ' + e.getMessage() + '\n' + e.getStackTraceString());
} finally {
    // Keep this rollback block active for dry-run testing.
    // Comment it out if you want to push signals to the live dashboard!
    Database.rollback(sp);
    System.debug('Scenario A completed. Database rolled back to preserve sandbox state.');
}
