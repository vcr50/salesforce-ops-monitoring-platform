<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VertexDB</title>
  <meta name="description" content="VertexDB is a personal command center for Salesforce prep, calendars, tasks, notes, and study planning." />
  <meta name="application-name" content="VertexDB" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css?v=1.8" />
  <link rel="stylesheet" href="css/calendar-modern.css" />
  <link rel="stylesheet" href="css/command-mode.css" />
  <link rel="stylesheet" href="css/liquid-glass.css?v=1.0.5" />
  <link rel="stylesheet" href="css/alive-now.css?v=2.6.5" />
  <link rel="stylesheet" href="css/home-layout.css?v=1.0.2" />
  <link rel="stylesheet" href="css/dashboard-layout.css?v=1.0.1" />
  <link rel="icon" type="image/png" href="images/logo.png" />
  <link rel="apple-touch-icon" href="images/logo.png" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="css/pes-plugin.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      color-scheme: dark;
    }

    body {
      background:
        radial-gradient(circle at top left, rgba(80, 120, 255, 0.18), transparent 35%),
        radial-gradient(circle at bottom right, rgba(180, 120, 255, 0.14), transparent 40%),
        linear-gradient(180deg, #060816 0%, #0A1020 100%);
      background-attachment: fixed;
    }

    .liquid-card {
      position: relative;
      overflow: hidden;
      border-radius: 32px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background:
        radial-gradient(circle at top left, rgba(255, 255, 255, 0.12), transparent 34%),
        radial-gradient(circle at bottom right, rgba(96, 165, 250, 0.12), transparent 32%),
        rgba(255, 255, 255, 0.08);
      box-shadow:
        0 10px 50px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      will-change: transform;
      contain: paint;
      transform: translateZ(0);
    }

    .liquid-card::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.14), transparent 26%),
        radial-gradient(circle at 85% 78%, rgba(167, 139, 250, 0.14), transparent 24%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0));
    }

    .liquid-card::after {
      content: "";
      position: absolute;
      inset: -30% auto -30% -60%;
      width: 42%;
      pointer-events: none;
      opacity: 0;
      transform: rotate(14deg);
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.16), transparent);
      animation: glassSweep 9s ease-in-out infinite;
    }

    .liquid-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
      border-color: rgba(255, 255, 255, 0.16);
    }

    .liquid-topline {
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
      pointer-events: none;
    }

    .glass-pill {
      border: 1px solid rgba(255, 255, 255, 0.08);
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06)),
        rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 10px 30px rgba(15, 23, 42, 0.12);
    }

    .dashboard-eyebrow {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.42);
    }

    .dashboard-title {
      margin-top: 10px;
      font-size: 24px;
      line-height: 1.15;
      font-weight: 600;
      letter-spacing: -0.03em;
      color: #fff;
    }

    .dashboard-copy {
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.5);
    }

    .dashboard-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.06);
      padding: 8px 14px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.55);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .alive-hero-card {
      min-height: 446px;
      background:
        linear-gradient(115deg, rgba(12, 14, 24, 0.88) 0%, rgba(18, 20, 34, 0.74) 42%, rgba(10, 11, 22, 0.58) 100%),
        radial-gradient(circle at 18% 18%, rgba(140, 129, 255, 0.22), transparent 32%),
        radial-gradient(circle at 82% 84%, rgba(99, 102, 241, 0.24), transparent 28%),
        rgba(255, 255, 255, 0.06);
      isolation: isolate;
    }

    .alive-hero-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(8, 9, 17, 0.9) 0%, rgba(8, 9, 17, 0.72) 34%, rgba(8, 9, 17, 0.2) 72%, rgba(8, 9, 17, 0.58) 100%),
        radial-gradient(circle at 24% 16%, rgba(255, 255, 255, 0.12), transparent 22%);
      pointer-events: none;
      z-index: 0;
    }

    .alive-hero-portrait {
      position: absolute;
      right: -3%;
      bottom: -1%;
      width: min(46%, 320px);
      height: 112%;
      border-radius: 32px;
      background-image:
        linear-gradient(180deg, rgba(10, 10, 18, 0) 0%, rgba(10, 10, 18, 0.08) 32%, rgba(10, 10, 18, 0.56) 100%),
        var(--alive-hero-portrait, url("images/Hero akira.jpeg"));
      background-size: cover;
      background-position: center top;
      opacity: 0.34;
      mix-blend-mode: screen;
      filter: grayscale(0.08) contrast(1.02) saturate(0.9);
      transform: scale(1.02);
      pointer-events: none;
      z-index: 0;
      transition: opacity 0.35s ease;
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.28) 18%, #000 46%, #000 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.28) 18%, #000 46%, #000 100%);
    }

    .alive-hero-card:not(.has-portrait) .alive-hero-portrait {
      opacity: 0.18;
      background-image:
        radial-gradient(circle at 48% 24%, rgba(255, 255, 255, 0.28), transparent 16%),
        radial-gradient(circle at 54% 38%, rgba(255, 255, 255, 0.18), transparent 18%),
        radial-gradient(circle at 50% 68%, rgba(94, 96, 176, 0.28), transparent 34%);
      filter: blur(2px);
    }

    .alive-hero-content {
      position: relative;
      z-index: 1;
    }

    .alive-hero-kicker {
      font-family: "Space Grotesk", "Inter", sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: rgba(255, 255, 255, 0.92);
    }

    .alive-hero-kicker span:last-child {
      color: rgba(255, 255, 255, 0.62);
    }

    .alive-hero-title {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(44px, 4.8vw, 64px);
      line-height: 0.94;
      letter-spacing: -0.045em;
      font-weight: 700;
      color: #fff;
      text-wrap: balance;
      text-shadow: 0 12px 40px rgba(0, 0, 0, 0.38);
    }

    .alive-hero-title .hero-name {
      display: block;
      color: rgba(255, 255, 255, 0.84);
      font-family: "Space Grotesk", "Inter", sans-serif;
      font-size: clamp(16px, 1.6vw, 20px);
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-top: 10px;
    }

    .alive-hero-quote {
      max-width: 360px;
      font-family: "Space Grotesk", "Inter", sans-serif;
      font-size: 15px;
      line-height: 1.85;
      color: rgba(255, 232, 168, 0.94);
      text-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    }

    .alive-hero-quote strong {
      color: #ffd15a;
      font-weight: 700;
    }

    .alive-hero-meta {
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 12px 26px rgba(7, 12, 24, 0.22);
    }

    .reflection-tag {
      transition:
        transform 0.24s ease,
        border-color 0.24s ease,
        color 0.24s ease,
        background 0.24s ease,
        box-shadow 0.24s ease,
        opacity 0.24s ease;
    }

    .reflection-tag.is-active {
      color: rgba(255, 255, 255, 0.96) !important;
      border-color: rgba(255, 255, 255, 0.22) !important;
      background: linear-gradient(135deg, rgba(255,255,255,0.14), rgba(255,255,255,0.08)) !important;
      box-shadow:
        0 0 24px rgba(255, 255, 255, 0.08),
        inset 0 1px 0 rgba(255,255,255,0.12);
      transform: translateY(-1px);
    }

    .reflection-tag[data-tone="lesson"].is-active {
      border-color: rgba(125, 211, 252, 0.4) !important;
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.22), rgba(255,255,255,0.08)) !important;
      box-shadow:
        0 0 28px rgba(56, 189, 248, 0.2),
        inset 0 1px 0 rgba(255,255,255,0.12);
    }

    .reflection-tag[data-tone="win"].is-active {
      border-color: rgba(251, 191, 36, 0.42) !important;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.24), rgba(255,255,255,0.08)) !important;
      box-shadow:
        0 0 28px rgba(245, 158, 11, 0.22),
        inset 0 1px 0 rgba(255,255,255,0.12);
    }

    .reflection-tag[data-tone="focus"].is-active {
      border-color: rgba(74, 222, 128, 0.4) !important;
      background: linear-gradient(135deg, rgba(34, 197, 94, 0.24), rgba(255,255,255,0.08)) !important;
      box-shadow:
        0 0 28px rgba(34, 197, 94, 0.2),
        inset 0 1px 0 rgba(255,255,255,0.12);
    }

    .dashboard-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.06));
      padding: 12px 18px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.72);
      box-shadow:
        0 14px 30px rgba(7, 12, 24, 0.22),
        inset 0 1px 0 rgba(255,255,255,0.08);
      transition: transform 0.28s ease, background 0.28s ease, border-color 0.28s ease, color 0.28s ease, box-shadow 0.28s ease;
    }

    .dashboard-button:hover {
      transform: translateY(-2px);
      color: #fff;
      border-color: rgba(255,255,255,0.18);
      background: linear-gradient(135deg, rgba(255,255,255,0.16), rgba(255,255,255,0.08));
      box-shadow:
        0 18px 34px rgba(7, 12, 24, 0.28),
        inset 0 1px 0 rgba(255,255,255,0.1);
    }

    .dashboard-surface {
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.03));
      box-shadow:
        0 20px 50px rgba(0,0,0,0.22),
        inset 0 1px 0 rgba(255,255,255,0.08);
    }

    .dashboard-stat-card {
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: linear-gradient(145deg, rgba(255,255,255,0.12), rgba(255,255,255,0.04));
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    }

    .section-shell {
      margin-bottom: 24px;
      border-radius: 30px;
      border: 1px solid rgba(255,255,255,0.08);
      background: linear-gradient(145deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
      box-shadow: 0 18px 44px rgba(0,0,0,0.22), inset 0 1px 0 rgba(255,255,255,0.06);
      padding: 22px;
    }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
    }

    .section-heading-copy {
      max-width: 720px;
    }

    .section-heading-copy .section-title,
    .section-heading-copy h2 {
      margin: 0 0 8px 0 !important;
    }

    .section-heading-copy p {
      margin: 0;
      color: rgba(255,255,255,0.52) !important;
      font-size: 14px !important;
      line-height: 1.7;
    }

    .legacy-card-polish {
      border-radius: 24px !important;
      border: 1px solid rgba(255,255,255,0.08) !important;
      background: linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03)) !important;
      box-shadow: 0 16px 38px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.06) !important;
    }

    #daily .section-title,
    #phases .section-title,
    #notes .section-title,
    #flashcards .section-title,
    #trailhead .section-title {
      margin-bottom: 8px;
    }

    #daily .section-desc,
    #phases .section-desc,
    #notes .section-desc,
    #flashcards .section-desc,
    #trailhead .section-desc {
      color: rgba(255,255,255,0.52);
      line-height: 1.7;
    }

    #daily .btn-primary,
    #flashcards .btn-primary,
    #trailhead .btn-primary {
      border-radius: 9999px;
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 14px 30px rgba(7,12,24,0.22), inset 0 1px 0 rgba(255,255,255,0.08);
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    #daily .daily-table-wrapper,
    #phases .phase-card,
    #notes .notes-header-bar,
    #notes .notes-editor-card,
    #flashcards .fc-grid,
    #trailhead .th-premium-card {
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 16px 38px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.06);
    }

    #daily .daily-table-wrapper,
    #notes .notes-editor-card,
    #flashcards .fc-grid {
      background: linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
    }

    #phases #newPhaseBtn {
      background: linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
      border: 2px dashed rgba(255,255,255,0.16) !important;
    }

    #trailhead > div:first-child,
    #flashcards > .fc-toolbar,
    #daily > div:first-child {
      margin-bottom: 18px;
    }

    .focus-ring-shell {
      --ring-size: 240px;
      position: relative;
      width: var(--ring-size);
      height: var(--ring-size);
      margin: 0 auto;
      display: grid;
      place-items: center;
      animation: ringShellFloat 6.5s ease-in-out infinite;
      will-change: transform;
      transform: translateZ(0);
    }

    .focus-ring-shell::before {
      content: "";
      position: absolute;
      inset: -16px;
      border-radius: 9999px;
      background:
        radial-gradient(circle at 50% 50%, rgba(255, 153, 0, 0.18), transparent 54%),
        radial-gradient(circle at 50% 50%, rgba(34, 197, 94, 0.12), transparent 40%);
      filter: blur(20px);
      opacity: 0.9;
      animation: orbitAura 7s ease-in-out infinite;
      pointer-events: none;
    }

    .focus-ring-backdrop {
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      background:
        radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.06), transparent 48%),
        radial-gradient(circle at center, rgba(0, 0, 0, 0.22) 56%, transparent 58%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.04),
        inset 0 24px 36px rgba(255, 255, 255, 0.02),
        inset 0 -24px 36px rgba(0, 0, 0, 0.24);
    }

    .focus-ring-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
      overflow: visible;
    }

    .focus-ring-track {
      fill: none;
      stroke: rgba(255, 255, 255, 0.06);
      filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.16));
    }

    .focus-ring-progress {
      fill: none;
      stroke-linecap: round;
      transition: stroke-dashoffset 1.2s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    @keyframes orbitRing {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .focus-ring-progress--outer {
      stroke: url(#focusGradientOuter);
      transform-origin: 110px 110px;
      animation: orbitRing 10s linear infinite;
    }

    .focus-ring-progress--mid {
      stroke: url(#focusGradientMid);
      transform-origin: 110px 110px;
      animation: orbitRing 14s linear infinite reverse;
    }

    .focus-ring-progress--inner {
      stroke: url(#focusGradientInner);
      transform-origin: 110px 110px;
      animation: orbitRing 8s linear infinite;
    }

    .focus-ring-core {
      position: absolute;
      inset: 74px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background:
        linear-gradient(180deg, rgba(39, 47, 45, 0.92), rgba(18, 24, 23, 0.96));
      box-shadow:
        inset 0 0 0 2px rgba(119, 136, 129, 0.16);
      animation: corePulse 4.5s ease-in-out infinite;
      will-change: transform;
      transform: translateZ(0);
      z-index: 1;
    }

    #focusDashboardCard::before {
      background:
        radial-gradient(circle at 18% 18%, rgba(255, 146, 60, 0.14), transparent 26%),
        radial-gradient(circle at 82% 24%, rgba(74, 222, 128, 0.12), transparent 24%),
        radial-gradient(circle at 64% 80%, rgba(34, 211, 238, 0.1), transparent 20%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0));
    }

    #richWeatherWidget,
    #richNewsWidget,
    #quoteBanner,
    #focusDashboardCard {
      box-shadow:
        0 12px 55px rgba(0, 0, 0, 0.26),
        0 0 60px rgba(96, 165, 250, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .soft-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .soft-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.14);
      border-radius: 999px;
    }

    .soft-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }

    #homeDashboardFrame > .liquid-card {
      animation: widgetEntrance 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    #homeDashboardFrame > .liquid-card:nth-child(1) { animation-delay: 0.05s; }
    #homeDashboardFrame > .liquid-card:nth-child(2) { animation-delay: 0.12s; }
    #homeDashboardFrame > .liquid-card:nth-child(3) { animation-delay: 0.18s; }
    #homeDashboardFrame > .liquid-card:nth-child(4) { animation-delay: 0.24s; }
    #homeDashboardFrame > .liquid-card:nth-child(5) { animation-delay: 0.3s; }
    #homeDashboardFrame > .liquid-card:nth-child(6) { animation-delay: 0.36s; }
    #homeDashboardFrame > .liquid-card:nth-child(7) { animation-delay: 0.42s; }

    #richWeatherWidget::before {
      background:
        radial-gradient(circle at top right, rgba(125, 211, 252, 0.18), transparent 32%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0));
    }

    #richWeatherWidget #awBigIcon {
      animation: cloudPass 7s ease-in-out infinite;
    }

    #quoteBanner {
      animation: widgetEntrance 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both, quoteGlow 6s ease-in-out infinite;
    }

    #quoteBanner .relative span,
    #xpBadge,
    #pomoWidget,
    #aliveLifeText,
    #focusDashboardCard .glass-pill,
    #richWeatherWidget .glass-pill,
    #richNewsWidget button,
    #aliveNowHome button,
    #aliveNowHome textarea,
    #aliveNowHome iframe {
      animation: breatheGlass 5.5s ease-in-out infinite;
    }

    #aliveCalList > *,
    #newsList > *,
    #aliveFocusList > *,
    #aliveJourneysGrid > * {
      animation: rowLift 0.7s ease both;
    }

    #newsList > *:nth-child(2n),
    #aliveCalList > *:nth-child(2n),
    #aliveFocusList > *:nth-child(2n) {
      animation-delay: 0.12s;
    }

    #focusDashboardCard .glass-pill.grid {
      animation: summaryGlow 6s ease-in-out infinite;
    }

    #focusDashboardCard .glass-pill.rounded-full:nth-of-type(1) { animation-delay: 0.2s; }
    #focusDashboardCard .glass-pill.rounded-full:nth-of-type(2) { animation-delay: 0.4s; }
    #focusDashboardCard .glass-pill.rounded-full:nth-of-type(3) { animation-delay: 0.6s; }

    #aliveReflectionBox:focus {
      box-shadow: 0 0 0 1px rgba(96, 165, 250, 0.3), 0 0 36px rgba(96, 165, 250, 0.16);
    }

    @keyframes glassSweep {
      0%, 100% { left: -60%; opacity: 0; }
      18% { opacity: 0; }
      34% { left: 132%; opacity: 0.55; }
      35% { opacity: 0; }
    }

    @keyframes widgetEntrance {
      0% {
        opacity: 0;
        transform: translateY(28px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes ringShellFloat {
      0%, 100% { transform: translateY(0) scale(1); }
