  <script>
    function handleApkDownload(e) {
      e.preventDefault();
      const btn = document.getElementById('apkDownloadBtn');
      const apkUrl = btn ? btn.getAttribute('data-apk-url') : '';
      
      if (!apkUrl || apkUrl === 'FIREBASE_STORAGE_URL_HERE' || apkUrl === '') {
        // Show friendly message if URL not configured yet
        const msg = '📱 APK Download\n\nTo install TCX App on Android:\n1. The APK file is being prepared\n2. Check back soon or contact the admin\n\nFile: TCX-App-v2.1.apk (6.7 MB)\nRequires: Android 7.0+ (API 24+)\nEnable: Settings → Unknown Sources → Allow';
        alert(msg);
        return false;
      }
      
      // Valid URL - trigger download
      const a = document.createElement('a');
      a.href = apkUrl;
      a.download = 'TCX-App-v2.2.apk';
      a.target = '_blank';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      return false;
    }
  </script>

  <!-- DESKTOP: Disable Weather & Headlines accordion toggle -->
  <script>
  (function() {
    var root = document.documentElement;
    var viewportTimer;

    function applyViewportProfile() {
      var viewport = window.visualViewport || window;
      var width = Math.round(viewport.width || window.innerWidth || document.documentElement.clientWidth || 0);
      var height = Math.round(viewport.height || window.innerHeight || document.documentElement.clientHeight || 0);

      root.style.setProperty('--app-vh', (height * 0.01) + 'px');
      root.classList.remove('viewport-compact', 'viewport-medium', 'viewport-wide');

      if (width < 700) {
        root.classList.add('viewport-compact');
      } else if (width < 1200) {
        root.classList.add('viewport-medium');
      } else {
        root.classList.add('viewport-wide');
      }
    }

    function queueViewportProfile() {
      clearTimeout(viewportTimer);
      viewportTimer = setTimeout(applyViewportProfile, 60);
    }

    applyViewportProfile();
    window.addEventListener('resize', queueViewportProfile, { passive: true });
    window.addEventListener('orientationchange', queueViewportProfile, { passive: true });
    window.addEventListener('pageshow', queueViewportProfile, { passive: true });

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', queueViewportProfile, { passive: true });
    }
  })();
  </script>

  <script>
  (function() {
    var weatherAcc = document.getElementById('weatherAccordion');
    var headlinesAcc = document.getElementById('headlinesAccordion');
    if (!weatherAcc || !headlinesAcc) return;

    function isDesktop() { return window.innerWidth > 768; }

    function syncAccordionState() {
      if (isDesktop()) {
        weatherAcc.setAttribute('open', '');
        headlinesAcc.setAttribute('open', '');
      }
    }

    [weatherAcc, headlinesAcc].forEach(function(acc) {
      if (!acc) return;
      var sum = acc.querySelector('summary');
      if (sum) {
        sum.addEventListener('click', function(e) {
          if (isDesktop()) {
            e.preventDefault();
            e.stopPropagation();
            acc.setAttribute('open', '');
          }
        });
      }
      acc.addEventListener('toggle', function() {
        if (isDesktop() && !acc.open) {
          acc.setAttribute('open', '');
        }
      });
    });

    syncAccordionState();
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(syncAccordionState, 150);
    });
  })();
  </script>

